[workspace]
resolver = "2"

members = [
    "compiler",
    "stdlib",
    "crates/naso-lsp",
    "crates/naso-gates",
    "crates/naso-verify",
    "crates/nasoc-wasm",
    "crates/naso-ffi",
]

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT OR Apache-2.0"
repository = "https://github.com/naso-lang/naso"

[workspace.dependencies]
logos = { version = "0.13" }
thiserror = { version = "2.0" }
naso-compiler = { path = "compiler" }
tokio = { version = "1.35", features = ["rt", "net", "io-util"] }
tower-lsp = { version = "0.20", features = ["runtime-tokio"] }
dashmap = { version = "6.1" }
z3 = { version = "0.21", features = ["vendored"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0" }
indexmap = { version = "2.0" }
smallvec = { version = "1.0" }
anyhow = { version = "1.0" }
tracing = { version = "0.1" }
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
clap = { version = "4.5" }
colored = { version = "2.0" }
url = { version = "2.4" }
naso-gates = { path = "crates/naso-gates" }
naso-verify = { path = "crates/naso-verify" }

[profile.dev]
opt-level = 1
debug = true

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
strip = true

[profile.release.package.nasoc-wasm]
opt-level = "s"