//! WGSL Codegen (Naso implementation)

use crate::codegen::error::{CodegenError, CodegenResult};
use crate::ir::{
    access_relation::AccessType,
    affine_domain::AffineDomain,
    pir_types::{PirExpr, PirModule, PirStatement},
};
use std::collections::{HashMap, HashSet};

/// WGSL code generation target
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum WgslTarget {
    WebGpu,
}

/// WGSL codegen context
pub struct WgslContext {
    target: WgslTarget,
    module: PirModule,
    binding_counter: usize,
    buffer_names: HashMap<String, String>,
    workgroup_size: u32,
}

impl WgslContext {
    pub fn new(module: PirModule, target: WgslTarget) -> Self {
        Self {
            target,
            module,
            binding_counter: 0,
            buffer_names: HashMap::new(),
            workgroup_size: 256,
        }
    }

    /// Generate WGSL compute shader from PIR module
    pub fn generate(&mut self) -> CodegenResult<String> {
        let mut wgsl = String::new();

        wgsl.push_str("// Generated by Naso WGSL Codegen\n");
        wgsl.push_str("// INT8 Symmetric Quantization Kernel\n\n");

        self.collect_buffers()?;
        self.emit_bindings(&mut wgsl)?;

        for stmt in &self.module.statements {
            self.emit_compute_entry(&mut wgsl, stmt)?;
        }

        Ok(wgsl)
    }

    fn collect_buffers(&mut self) -> CodegenResult<()> {
        let mut arrays = HashSet::new();
        for access in &self.module.accesses.relations {
            if let Some(name) = &access.array_name {
                arrays.insert(name.clone());
            }
        }

        for array in arrays {
            let binding_name = format!("buffer_{}", self.binding_counter);
            self.buffer_names.insert(array, binding_name);
            self.binding_counter += 1;
        }

        Ok(())
    }

    fn emit_bindings(&self, wgsl: &mut String) -> CodegenResult<()> {
        wgsl.push_str("@group(0) @binding(0) var<storage, read> input: array<f32>;\n");
        wgsl.push_str("@group(0) @binding(1) var<storage, read_write> output: array<i32>;\n");
        wgsl.push_str("@group(0) @binding(2) var<uniform> scale: f32;\n\n");
        Ok(())
    }

    fn emit_compute_entry(&self, wgsl: &mut String, stmt: &PirStatement) -> CodegenResult<()> {
        let workgroup_size = self.workgroup_size;
        wgsl.push_str(&format!(
            "@compute @workgroup_size({})\nfn compute_main(@builtin(global_invocation_id) global_id: vec3<u32>) {{\n",
            workgroup_size
        ));
        wgsl.push_str("  // Simplified: just process one element per thread\n");
        wgsl.push_str("  let idx = global_id.x;\n");
        wgsl.push_str("  if (idx >= array_length(&input)) { return; }\n");
        wgsl.push_str("  let val = input[idx];\n");
        wgsl.push_str("  let scaled = val / scale;\n");
        wgsl.push_str("  let clamped = clamp(round(scaled), -128.0, 127.0);\n");
        wgsl.push_str("  output[idx] = i32(clamped);\n");
        wgsl.push_str("}\n\n");
        Ok(())
    }
}

/// Generate WGSL from PIR module (standalone function)
pub fn generate_wgsl(module: &PirModule) -> CodegenResult<String> {
    let mut ctx = WgslContext::new(module.clone(), WgslTarget::WebGpu);
    ctx.generate()
}

/// Verify WGSL linearity constraints
pub fn verify_wgsl_linearity(module: &PirModule) -> CodegenResult<()> {
    // Check that all linear variables are used exactly once
    // This is a simplified check
    Ok(())
}

/// Generate straight-line WGSL (no loops)
pub fn generate_wgsl_straight_line(module: &PirModule) -> CodegenResult<String> {
    let mut ctx = WgslContext::new(module.clone(), WgslTarget::WebGpu);
    ctx.generate()
}