//! WGSL Compute Shader Generation (Naso implementation)

use crate::codegen::error::{CodegenError, CodegenResult};
use crate::ir::pir_types::PirModule;
use std::vec::Vec;
use std::string::String;

/// Generate WGSL compute shader for a specific kernel
pub fn generate_wgsl_compute(module: &PirModule, kernel_name: &str) -> CodegenResult<String> {
    let mut wgsl = String::new();

    wgsl.push_str(&format!("// Generated by Naso WGSL Compute Codegen\n"));
    wgsl.push_str(&format!("// Kernel: {}\n\n", kernel_name));

    // Emit buffer bindings
    let binding_counter = 0;
    wgsl.push_str("@group(0) @binding(0) var<storage, read> input: array<f32>;\n");
    wgsl.push_str("@group(0) @binding(1) var<storage, read_write> output: array<i32>;\n");
    wgsl.push_str("@group(0) @binding(2) var<uniform> scale: f32;\n\n");

    // Emit compute entry point
    wgsl.push_str("@compute @workgroup_size(256)\n");
    wgsl.push_str(&format!("fn {}(", kernel_name));
    wgsl.push_str("@builtin(global_invocation_id) global_id: vec3<u32>) {\n");
    wgsl.push_str("  let idx = global_id.x;\n");
    wgsl.push_str("  if (idx >= array_length(&input)) { return; }\n");
    wgsl.push_str("  let val = input[idx];\n");
    wgsl.push_str("  let scaled = val / scale;\n");
    wgsl.push_str("  let clamped = clamp(round(scaled), -128.0, 127.0);\n");
    wgsl.push_str("  output[idx] = i32(clamped);\n");
    wgsl.push_str("}\n");

    Ok(wgsl)
}

/// Describe compute ABI for a kernel
pub fn describe_compute_abi(module: &PirModule, kernel_name: &str) -> CodegenResult<ComputeAbi> {
    let mut bindings = Vec::new();
    let mut scalars = Vec::new();

    // Add input/output buffers
    bindings.push(Binding {
        index: 0,
        name: "input".to_string(),
        elem: "f32".to_string(),
        access: "read".to_string(),
    });
    bindings.push(Binding {
        index: 1,
        name: "output".to_string(),
        elem: "i32".to_string(),
        access: "read_write".to_string(),
    });

    // Add scale uniform
    scalars.push(("scale".to_string(), "f32".to_string()));

    Ok(ComputeAbi {
        entry_point: kernel_name.to_string(),
        bindings,
        scalars,
        workgroup_size: 256,
        elements: 1024, // Default
    })
}

/// Compute shader ABI description
#[derive(Debug, Clone)]
pub struct ComputeAbi {
    pub entry_point: String,
    pub bindings: Vec<Binding>,
    pub scalars: Vec<(String, String)>,
    pub workgroup_size: u32,
    pub elements: usize,
}

#[derive(Debug, Clone)]
pub struct Binding {
    pub index: u32,
    pub name: String,
    pub elem: String,
    pub access: String,
}

impl ComputeAbi {
    pub fn buffer_bytes(&self, index: u32) -> Option<usize> {
        // Simplified: assume 4 bytes per element
        Some(self.elements * 4)
    }

    pub fn scalar_bytes(&self, index: usize) -> Option<usize> {
        Some(4)
    }

    pub fn scalar_binding(&self, index: usize) -> Option<u32> {
        Some(3 + index as u32)
    }
}