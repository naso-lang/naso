//! WGSL Straight-Line Generation (Naso implementation)
//!
//! Generates WGSL without loops, suitable for simple kernels.

use crate::codegen::error::{CodegenError, CodegenResult};
use crate::ir::pir_types::PirModule;
use std::string::String;

/// Generate straight-line WGSL from PIR module (no loops)
pub fn generate_wgsl_straight_line(module: &PirModule) -> CodegenResult<String> {
    let mut wgsl = String::new();

    wgsl.push_str("// Generated by Naso WGSL Straight-Line Codegen\n\n");

    // Emit buffer bindings for arrays
    let mut binding = 0;
    for stmt in &module.statements {
        // Simplified: just process statements as sequential
        wgsl.push_str(&format!("// Statement {}\n", stmt.id.0));
    }

    // Emit a simple main function
    wgsl.push_str("@compute @workgroup_size(256)\n");
    wgsl.push_str("fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {\n");
    wgsl.push_str("  // Straight-line execution\n");
    wgsl.push_str("}\n");

    Ok(wgsl)
}