//! Test file for Naso compiler frontend (lexer + parser + typechecker)

use std::vec::Vec;
use std::string::String;

mod lexer;
mod ast;
mod parser;
mod typecheck;

fn main() {
    // Test lexer
    let source = r#"
fn main() {
    let x: i32 = 42;
    let y = x + 1;
    return y;
}
"#;

    let tokens = lexer::Lexer::lex(source);
    println!("Tokens ({}):", tokens.len());
    for token in &tokens {
        println!("  {:?} {:?}", token.kind, token.span);
    }

    // Test parser
    match parser::parse_program(source) {
        Ok(program) => {
            println!("\nParsed successfully!");
            println!("Items: {}", program.items.len());
            for item in &program.items {
                println!("  Item: {:?}", item);
            }

            // Test typechecker
            println!("\nType checking...");
            match typecheck::check_program(&program) {
                Ok(()) => println!("Type checking passed!"),
                Err(e) => println!("Type error: {}", e),
            }
        }
        Err(e) => {
            println!("\nParse error: {}", e);
        }
    }
}