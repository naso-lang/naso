//! Type checking functions for the Naso type checker (Naso implementation)
//!
//! Implements the bidirectional typing rules: check mode (type-directed)
//! Full Quantitative Type Theory (QTT) enforcement:
//! - [0] erased variables: compile-time only, cannot appear at runtime
//! - [1] linear variables: consumed exactly once across all branches
//! - [N] bounded variables: consumed at most N times
//! - [*] unrestricted: any number of uses

use crate::ast::*;
use crate::typecheck::constraints::{is_erasable, qty_subtype};
use crate::typecheck::error::TypeError;
use crate::typecheck::inference::infer_expr;
use crate::typecheck::type_env::FunctionSig;
use crate::typecheck::TypeChecker;
use crate::typecheck::unify;

/// Check an expression against an expected type (Check mode)
pub fn check_expr(
    checker: &mut TypeChecker,
    expr: &Expr,
    expected: &Type,
) -> Result<(), TypeError> {
    // First, synthesize the type of the expression
    let inferred = infer_expr(checker, expr)?;

    // Unify with expected type (including quantity)
    unify::unify_types(checker, &inferred, expected)?;

    // Additional QTT checks for quantity
    check_quantity_consumption(checker, expr, &inferred, expected)?;

    Ok(())
}

/// Check quantity consumption rules
pub fn check_quantity_consumption(
    _checker: &mut TypeChecker,
    expr: &Expr,
    inferred: &Type,
    expected: &Type,
) -> Result<(), TypeError> {
    // If expected quantity is Zero, the expression must be erasable
    if expected.quantity == Quantity::Zero && !is_erasable(inferred.quantity) {
        return Err(TypeError::QuantityMismatch {
            expected: Quantity::Zero,
            found: inferred.quantity,
            span: expr.span,
        });
    }

    // If inferred is Zero but expected is not, that's an error
    if inferred.quantity == Quantity::Zero && expected.quantity != Quantity::Zero {
        return Err(TypeError::ErasedVariableUsedAtRuntime {
            name: inferred.to_ident(),
            span: expr.span,
        });
    }

    // Check subtyping: inferred qty must be <= expected qty
    if !qty_subtype(inferred.quantity, expected.quantity) {
        return Err(TypeError::QuantityMismatch {
            expected: expected.quantity,
            found: inferred.quantity,
            span: expr.span,
        });
    }

    Ok(())
}

/// Check a statement
pub fn check_stmt(checker: &mut TypeChecker, stmt: &Stmt) -> Result<(), TypeError> {
    match &stmt.kind {
        StmtKind::Let(let_stmt) => check_let(checker, let_stmt),
        StmtKind::LetInOut(let_inout) => check_let_inout(checker, let_inout),
        StmtKind::Expr(expr) => {
            let inferred_ty = infer_expr(checker, expr)?;
            // Expression statements that produce linear values must consume them.
            Ok(())
        }
        StmtKind::Return(opt_expr) => check_return(checker, opt_expr.as_ref()),
        StmtKind::Item(item) => check_item(checker, item),
        StmtKind::Reversible(block) => check_reversible(checker, block),
        StmtKind::Proof(block) => check_proof(checker, block),
        StmtKind::Break(opt_expr) => check_break(checker, opt_expr.as_ref()),
        StmtKind::Continue => Ok(()),
        StmtKind::Empty => Ok(()),
        StmtKind::LetConsume(let_consume) => check_let_consume(checker, let_consume),
        StmtKind::Error => Ok(()),
    }
}

fn check_let(checker: &mut TypeChecker, let_stmt: &LetStmt) -> Result<(), TypeError> {
    // Infer the type of the initializer
    let init_ty = infer_expr(checker, &let_stmt.value)?;

    // Handle tuple patterns by destructuring the tuple type
    let mut bindings = Vec::new();
    let mut pattern_qtys = Vec::new();

    match (&let_stmt.pattern.kind, &init_ty.kind) {
        (PatternKind::Tuple(patterns), TypeKind::Tuple(element_types)) => {
            if patterns.len() != element_types.len() {
                return Err(TypeError::PatternTupleArityMismatch {
                    pattern_len: patterns.len(),
                    tuple_len: element_types.len(),
                    span: let_stmt.pattern.span,
                });
            }
            for (p, ty) in patterns.iter().zip(element_types.iter()) {
                let name = match &p.kind {
                    PatternKind::Ident(ident) => ident.clone(),
                    _ => panic!("Expected ident in tuple pattern"),
                };
                let pattern_qty = if let_stmt.quantity == Quantity::Many {
                    ty.quantity
                } else {
                    p.quantity
                };
                bindings.push((name.clone(), ty.clone()));
                pattern_qtys.push(pattern_qty);
            }
        }
        (PatternKind::Ident(ident), _) => {
            let pattern_qty = if let_stmt.quantity == Quantity::Many {
                init_ty.quantity
            } else {
                let_stmt.quantity
            };
            bindings.push((ident.clone(), init_ty.clone()));
            pattern_qtys.push(pattern_qty);
        }
        _ => {
            let synthetic_name = Ident::new("__pattern_binding".to_string(), let_stmt.pattern.span);
            bindings.push((synthetic_name.clone(), init_ty.clone()));
            pattern_qtys.push(let_stmt.pattern.quantity);
        }
    }

    // Check if Qubit type requires quantity One
    for (i, (_, ty)) in bindings.iter().enumerate() {
        if matches!(ty.kind, TypeKind::Qubit) && pattern_qtys[i] != Quantity::One {
            return Err(TypeError::QubitQuantityMismatch {
                found: pattern_qtys[i],
                span: let_stmt.pattern.span,
            });
        }
    }

    // If explicit type annotation, unify against the already-inferred type.
    if let Some(ann_ty) = &let_stmt.ty {
        unify::unify_types(checker, &init_ty, ann_ty)?;
    }

    // Bind variables in environment
    for (i, (name, ty)) in bindings.into_iter().enumerate() {
        let qty = pattern_qtys[i];
        checker.env.bind_var(name, ty, qty, let_stmt.mutability);
    }

    Ok(())
}

fn check_let_inout(checker: &mut TypeChecker, let_inout: &LetInOutStmt) -> Result<(), TypeError> {
    let init_ty = infer_expr(checker, &let_inout.value)?;

    if let Some(ann_ty) = &let_inout.ty {
        unify::unify_types(checker, &init_ty, ann_ty)?;
    }

    // inout requires quantity One
    if init_ty.quantity != Quantity::One {
        return Err(TypeError::InOutRequiresUnique {
            found_qty: init_ty.quantity,
            span: let_inout.span,
        });
    }

    checker.env.bind_var(
        let_inout.name.clone(),
        init_ty,
        Quantity::One,
        Mutability::InOut,
    );

    // Start inout borrow
    let place = Place::Var(let_inout.name.clone());
    checker.env.borrow_inout(let_inout.name.clone(), place, let_inout.span)?;

    Ok(())
}

fn check_let_consume(checker: &mut TypeChecker, let_consume: &LetConsumeStmt) -> Result<(), TypeError> {
    let init_ty = infer_expr(checker, &let_consume.value)?;

    if let Some(ann_ty) = &let_consume.ty {
        unify::unify_types(checker, &init_ty, ann_ty)?;
    }

    // consume requires quantity One
    if init_ty.quantity != Quantity::One {
        return Err(TypeError::InOutRequiresUnique {
            found_qty: init_ty.quantity,
            span: let_consume.span,
        });
    }

    checker.env.bind_var(
        let_consume.name.clone(),
        init_ty,
        Quantity::One,
        Mutability::Consume,
    );

    Ok(())
}

fn check_return(checker: &mut TypeChecker, opt_expr: Option<&Expr>) -> Result<(), TypeError> {
    if let Some(expr) = opt_expr {
        if let Some(expected_ret) = &checker.current_fn_ret {
            check_expr(checker, expr, expected_ret)?;
        } else {
            return Err(TypeError::ReturnOutsideFunction { span: expr.span });
        }
    } else {
        // No return value - check if function expects void
        if let Some(expected_ret) = &checker.current_fn_ret {
            if !matches!(expected_ret.kind, TypeKind::Unit) {
                return Err(TypeError::TypeMismatch {
                    expected: expected_ret.clone(),
                    found: Type::unit(expr.span),
                    span: expr.span,
                });
            }
        }
    }
    Ok(())
}

fn check_item(checker: &mut TypeChecker, item: &Item) -> Result<(), TypeError> {
    match item {
        Item::Function(func) => check_function(checker, func),
        Item::TypeDef(type_def) => check_type_def(checker, type_def),
        Item::Trait(trait_def) => check_trait_def(checker, trait_def),
        Item::Impl(trait_impl) => check_trait_impl(checker, trait_impl),
        Item::Module(module) => check_module(checker, module),
        Item::Import(_) => Ok(()),
        Item::Const(const_def) => check_const(checker, const_def),
        Item::Extern(_) => Ok(()),
    }
}

fn check_function(checker: &mut TypeChecker, func: &Function) -> Result<(), TypeError> {
    // Save current state
    let prev_ret = checker.current_fn_ret.take();
    let prev_reversible = checker.in_reversible;
    let prev_proof = checker.in_proof;

    // Set up function state
    checker.current_fn_ret = func.ret_ty.clone();
    checker.in_reversible = func.is_reversible;

    // Enter function scope
    let _scope = checker.env.enter_scope();

    // Bind generic parameters
    for generic in &func.generics {
        checker.env.generics.insert(generic.name.clone(), generic.clone());
    }

    // Bind parameters
    for param in &func.params {
        checker.env.bind_var(
            param.name.clone(),
            param.ty.clone(),
            param.quantity,
            param.mutability,
        );
    }

    // Check function body
    check_block(checker, &func.body, func.ret_ty.as_ref())?;

    // Check requires clauses
    for req in &func.requires {
        // Enter proof mode for requires
        checker.in_proof = true;
        check_expr(checker, req, &Type::bool(req.span))?;
        checker.in_proof = false;
    }

    // Restore state
    checker.current_fn_ret = prev_ret;
    checker.in_reversible = prev_reversible;
    checker.in_proof = prev_proof;

    Ok(())
}

fn check_type_def(checker: &mut TypeChecker, type_def: &TypeDef) -> Result<(), TypeError> {
    // Check generic parameters
    for generic in &type_def.generics {
        checker.env.generics.insert(generic.name.clone(), generic.clone());
    }

    // Check fields/variants based on kind
    match &type_def.kind {
        TypeDefKind::Struct(fields) => {
            for field in fields {
                // Type is already resolved by parser
                // Just ensure the type is valid
            }
        }
        TypeDefKind::Enum(variants) => {
            for variant in variants {
                for field in &variant.fields {
                    // Check field types
                }
            }
        }
        TypeDefKind::Alias(ty) => {
            // Alias types are validated during parsing
        }
    }

    // Insert into environment
    checker.env.insert_type_def(type_def.clone());

    Ok(())
}

fn check_trait_def(checker: &mut TypeChecker, trait_def: &TraitDef) -> Result<(), TypeError> {
    // Bind generic parameters
    for generic in &trait_def.generics {
        checker.env.generics.insert(generic.name.clone(), generic.clone());
    }

    // Check trait items
    for item in &trait_def.items {
        match item {
            TraitItem::AssocType(assoc) => {
                // Check associated type
                for bound in &assoc.bounds {
                    // Validate bounds
                }
            }
            TraitItem::Fn(sig) => {
                // Check function signature
                for param in &sig.params {
                    // Validate param types
                }
                if let Some(ret) = &sig.ret_ty {
                    // Validate return type
                }
            }
        }
    }

    Ok(())
}

fn check_trait_impl(checker: &mut TypeChecker, trait_impl: &TraitImpl) -> Result<(), TypeError> {
    // Bind generic parameters
    for generic in &trait_impl.generics {
        checker.env.generics.insert(generic.name.clone(), generic.clone());
    }

    // Check impl items
    for item in &trait_impl.items {
        match item {
            ImplItem::AssocType(assoc) => {
                // Validate associated type implementation
            }
            ImplItem::Fn(func) => {
                check_function(checker, func)?;
            }
        }
    }

    Ok(())
}

fn check_module(checker: &mut TypeChecker, module: &Module) -> Result<(), TypeError> {
    for item in &module.items {
        check_item(checker, item)?;
    }
    Ok(())
}

fn check_const(checker: &mut TypeChecker, const_def: &ConstDef) -> Result<(), TypeError> {
    if let Some(ty) = &const_def.ty {
        check_expr(checker, &const_def.value, ty)?;
    } else {
        let _inferred = infer_expr(checker, &const_def.value)?;
    }
    checker.env.insert_const(const_def.clone());
    Ok(())
}

fn check_block(checker: &mut TypeChecker, block: &Block, expected_ret: Option<&Type>) -> Result<(), TypeError> {
    let _scope = checker.env.enter_scope();

    for stmt in &block.stmts {
        check_stmt(checker, stmt)?;
    }

    if let Some(tail) = &block.expr {
        if let Some(expected) = expected_ret {
            check_expr(checker, tail, expected)?;
        } else {
            // In infer mode, just infer the tail expression
            let _inferred = infer_expr(checker, tail)?;
        }
    }

    Ok(())
}

fn check_reversible(checker: &mut TypeChecker, block: &ReversibleBlock) -> Result<(), TypeError> {
    let prev_reversible = checker.in_reversible;
    checker.in_reversible = true;

    check_block(checker, &block.body, None)?;

    // Check uncomputes
    for step in &block.uncomputes {
        // Validate inverse expression
        let _inferred = infer_expr(checker, &step.inverse_expr)?;
    }

    checker.in_reversible = prev_reversible;
    Ok(())
}

fn check_proof(checker: &mut TypeChecker, block: &ProofBlock) -> Result<(), TypeError> {
    let prev_proof = checker.in_proof;
    checker.in_proof = true;
    checker.env.erased_depth += 1;

    check_block(checker, &block.body, None)?;

    checker.env.erased_depth -= 1;
    checker.in_proof = prev_proof;
    Ok(())
}

fn check_break(checker: &mut TypeChecker, opt_expr: Option<&Expr>) -> Result<(), TypeError> {
    // Break with value - would need loop context tracking
    // For now just check the expression if present
    if let Some(expr) = opt_expr {
        let _inferred = infer_expr(checker, expr)?;
    }
    Ok(())
}

/// Check a pattern against a scrutinee type
pub fn check_pattern(
    checker: &mut TypeChecker,
    pattern: &Pattern,
    scrutinee_ty: &Type,
) -> Result<crate::typecheck::type_env::PatternBindings, TypeError> {
    let mut bindings = crate::typecheck::type_env::PatternBindings::new();

    match (&pattern.kind, &scrutinee_ty.kind) {
        (PatternKind::Ident(ident), _) => {
            let info = VarInfo::new(scrutinee_ty.clone(), pattern.quantity, Mutability::Immutable, pattern.span);
            bindings.insert(ident.clone(), info);
        }
        (PatternKind::Wildcard, _) => {
            // Wildcard binds nothing
        }
        (PatternKind::Tuple(patterns), TypeKind::Tuple(elems)) => {
            if patterns.len() != elems.len() {
                return Err(TypeError::PatternTupleArityMismatch {
                    pattern_len: patterns.len(),
                    tuple_len: elems.len(),
                    span: pattern.span,
                });
            }
            for (p, ty) in patterns.iter().zip(elems.iter()) {
                let sub_bindings = check_pattern(checker, p, ty)?;
                bindings.extend(sub_bindings);
            }
        }
        (PatternKind::Struct(name, fields), TypeKind::Named(type_name, _)) => {
            if name.name != type_name.name {
                return Err(TypeError::TypeMismatch {
                    expected: scrutinee_ty.clone(),
                    found: scrutinee_ty.clone(),
                    span: pattern.span,
                });
            }
            // Would need to look up struct definition for field types
        }
        _ => {
            // Other patterns: wildcard, literal, etc.
        }
    }

    Ok(bindings)
}

// Forward declaration for VarInfo
struct VarInfo;