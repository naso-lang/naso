//! Quantity constraints and solving for the Naso type checker (Naso implementation)

use crate::ast::{Quantity, Span, MetaVar};
use crate::typecheck::error::TypeError;
use crate::typecheck::unify::{qty_subtype, qty_join, qty_meet, qty_consume, is_erasable, is_linear, is_unrestricted};
use std::vec::Vec;
use std::string::String;

/// A quantity constraint: q1 <= q2
pub struct QtyConstraint {
    pub lhs: Quantity,
    pub rhs: Quantity,
    pub span: Span,
    pub reason: String,
}

impl QtyConstraint {
    pub fn new(lhs: Quantity, rhs: Quantity, span: Span, reason: String) -> Self {
        Self { lhs, rhs, span, reason }
    }
}

/// Set of quantity constraints to be solved
pub struct ConstraintSet {
    pub constraints: Vec<QtyConstraint>,
}

impl ConstraintSet {
    pub fn new() -> Self {
        Self { constraints: Vec::new() }
    }

    pub fn add(&mut self, constraint: QtyConstraint) {
        self.constraints.push(constraint);
    }

    pub fn is_empty(&self) -> bool {
        self.constraints.is_empty()
    }
}

/// Solve all quantity constraints
pub fn solve(
    constraints: &mut ConstraintSet,
    _env: &mut crate::typecheck::type_env::TypeEnv,
    _meta_vars: &mut crate::ast::IndexMap<MetaVar, Option<crate::ast::Type>>,
) -> Result<(), TypeError> {
    for constraint in &constraints.constraints {
        if !qty_subtype(constraint.lhs, constraint.rhs) {
            return Err(TypeError::QuantityMismatch {
                expected: constraint.rhs,
                found: constraint.lhs,
                span: constraint.span,
            });
        }
    }
    Ok(())
}

// Re-export canonical quantity operations from unify
pub use crate::typecheck::unify::{
    is_erasable, is_linear, is_unrestricted, qty_consume, qty_join, qty_meet, qty_subtype,
};