// Invalid: linear-resource violations the checker DOES catch.
//
// These fixtures were written against an older version of the language and had
// rotted unnoticed because nothing executed them. `linear_free` was never a real
// callee -- consumption is the `let consume y = x;` pattern -- so these cases
// were not even exercising the errors they claimed to.
//
// Every function here is expected to be REJECTED by the typechecker, and each
// says which diagnostic it is asserting, so a change in message wording shows up
// as a test failure rather than passing silently.
//
// // Invalid: the linear parameter is never used, so it leaks.
fn leak(x: [1] i32) {
    // x never consumed.
}

// Invalid: the linear parameter is consumed twice.
fn double_consume(x: [1] i32) {
    let consume a = x;
    let consume b = x;
    let _ = a;
    let _ = b;
}

// Invalid: the linear parameter is used after being moved.
fn use_after_move(x: [1] i32) {
    let y = x; // Move
    let _ = x; // Error: x already moved
    let _ = y;
}

// Invalid: a linear value consumed in only ONE arm of an `if` leaks on the other
// path. The checker joins the branches' consumption states, so this is caught.
fn leak_on_one_if_arm(cond: bool, x: [1] i32) {
    if cond {
        let consume a = x;
        let _ = a;
    }
    // x is not consumed when cond is false.
}

// Invalid: consumed in one `match` arm only, leaked in the other.
fn leak_on_one_match_arm(n: i32, x: [1] i32) {
    match n {
        0 => {
            let consume a = x;
            let _ = a;
        }
        _ => {
            let _ = 1;
        }
    }
    // x is not consumed for any n other than 0.
}

// Invalid: consumed in one arm of a three-arm match, leaked in the other two.
fn leak_on_one_arm_of_three(n: i32, x: [1] i32) {
    match n {
        0 => {
            let consume a = x;
            let _ = a;
        }
        1 => {
            let _ = 1;
        }
        _ => {
            let _ = 2;
        }
    }
}

// Invalid: a linear value WIDENED by an intervening binding, then used twice.
//
// An unannotated `let` used to default the new binding to `[*]`, so the
// "a `[1]` value is used exactly once" rule never applied to it. This is the
// escape the quantity inheritance closes.
fn widen_then_use_twice(x: [1] i32) {
    let y = x;
    let _ = y;
    let _ = y;
}

// Invalid: the same escape, with the widening applied twice.
fn widen_twice_then_use_twice(x: [1] i32) {
    let y = x;
    let z = y;
    let _ = z;
    let _ = z;
}

// Invalid: a linear tensor WIDENED by an intervening binding, then used twice.
fn widen_tensor_then_use_twice(a: [1] Tensor[f32, 8]) {
    let b = a;
    let _ = b;
    let _ = b;
}
