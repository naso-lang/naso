// Valid: a linear resource is used exactly once.
//
// These fixtures were written against an earlier version of the language and had
// rotted unnoticed, because nothing executed them: `f64` is no longer a type,
// `linear_free` was never a real callee (consumption is a *pattern* modifier,
// `let consume y = x`, not an expression operator), and a tuple return did not
// typecheck. They are now run by tests/corpus_tests.rs, so drift fails the build
// instead of hiding.

// Valid: linear resource consumed exactly once, into a `consume` binding.
fn consume_once(x: [1] i32) {
    let consume y = x;
    let _ = y;
}

// Valid: a linear resource moved into a plain binding and then used.
//
// NOTE: the intermediate `let y = x;` yields `[1]`, but re-binding it with
// `let consume z = y;` after the fact FAILS with
// `quantity mismatch: expected [1], found [*]` -- an intervening plain `let`
// widens the binding to `[*]`, so a later `consume` cannot match it. That is a
// real gap in the checker, so this fixture uses the direct form below and does
// NOT claim the two-step version works. See
// tests/corpus_tests.rs::plain_let_between_moves_is_a_known_gap.
fn move_and_use(x: [1] i32) {
    let y = x; // Move
    let _ = y;
}

// Valid: several linear resources, each consumed exactly once.
fn multi_linear(x: [1] i32, y: [1] f32) {
    let consume a = x;
    let consume b = y;
    let _ = a;
    let _ = b;
}

// Valid: a linear resource is produced and returned, so it is consumed by being
// handed to the caller rather than discarded.
fn return_linear() -> [1] i32 {
    let q = 42;
    q
}

// Valid: a linear resource written in place through an `inout` binding.
fn write_in_place(x: [1] i32) -> [1] i32 {
    let inout y = x;
    y
}

// Valid: a non-linear value is branched on freely. Only LINEAR values are
// restricted to a single path, because a move is a one-shot event and the
// checker does not currently join two branches' move sets.
//
// NOTE: a linear value consumed in BOTH arms of an `if` is NOT accepted -- the
// checker reports "use of moved value", since the first arm's move is treated as
// unconditional. That is a real limitation of the current checker, not a valid
// program, so it is not claimed as valid here. See
// tests/corpus_tests.rs::linear_valid_file_typechecks for what IS asserted.
fn branch_on_a_plain_bool(cond: bool, x: i32) -> i32 {
    if cond {
        x + 1
    } else {
        x + 2
    }
}

// Valid: a move through an intervening plain binding.
//
// An unannotated `let` used to default the new binding to `[*]`, widening a
// `[1]` value and letting it be used twice. The binding now inherits the
// initializer's quantity, so the linear discipline survives the intermediate
// binding and this two-step move typechecks.
fn move_via_intervening_let(x: [1] i32) {
    let y = x;
    let consume z = y;
    let _ = z;
}

// Valid: a linear value moved through several bindings, then consumed once.
fn move_via_two_bindings(x: [1] i32) {
    let y = x;
    let z = y;
    let consume w = z;
    let _ = w;
}

// Valid: a linear value returned directly, no consume needed.
fn return_directly(x: [1] i32) -> [1] i32 {
    x
}

// Valid: a linear value moved through a binding and then returned.
fn return_via_binding(x: [1] i32) -> [1] i32 {
    let y = x;
    y
}
