// Valid quantum circuits: every allocated qubit is accounted for.
//
// These fixtures were written against an earlier version of the language and had
// rotted unnoticed because nothing executed them. Two things had changed: a qubit
// binding needs an explicit `[1]` quantity (`let [1] q: Qubit = qalloc(1);`),
// and a circuit accounts for its qubits by RETURNING them or MEASURING them.
//
// They are now run by tests/corpus_tests.rs, so drift fails the build instead of
// hiding.

// Valid: a Bell pair, both qubits returned to the caller.
fn bell_pair() -> ([1] Qubit, [1] Qubit) {
    let [1] a: Qubit = qalloc(1);
    let [1] b: Qubit = qalloc(1);
    hadamard(a);
    cnot(a, b);
    (a, b)
}

// Valid: a four-qubit chain, every qubit returned.
fn chain_4qubits() -> ([1] Qubit, [1] Qubit, [1] Qubit, [1] Qubit) {
    let [1] a: Qubit = qalloc(1);
    let [1] b: Qubit = qalloc(1);
    let [1] c: Qubit = qalloc(1);
    let [1] d: Qubit = qalloc(1);

    hadamard(a);
    cnot(a, b);
    cnot(b, c);
    cnot(c, d);

    (a, b, c, d)
}

// Valid: a qubit is accounted for by being measured, which yields a classical
// result. `m` is then consumed, so nothing leaks.
fn measure_accounts_for_qubit() {
    let [1] q: Qubit = qalloc(1);
    hadamard(q);
    let m = measure(q);
    let _ = m;
}

// Valid: a Bell pair is created and both qubits measured, so the function
// allocates and discharges everything it allocated.
fn bell_measured() -> bool {
    let [1] a: Qubit = qalloc(1);
    let [1] b: Qubit = qalloc(1);
    hadamard(a);
    cnot(a, b);
    let ma = measure(a);
    let mb = measure(b);
    let _ = ma;
    let _ = mb;
    true
}
