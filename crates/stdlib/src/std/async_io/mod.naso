// ============================================================================
// Naso Async I/O Traits - Phase 19.1
// ============================================================================
// Provides AsyncRead, AsyncWrite, AsyncSeek, AsyncBufRead traits
// with io_uring backend for zero-copy, high-performance I/O
// ============================================================================

extern "C" {
    fn naso_async_read(fd: u64, buf: *mut u8, len: usize) -> u64;
    fn naso_async_write(fd: u64, buf: *const u8, len: usize) -> u64;
    fn naso_async_seek(fd: u64, offset: i64, whence: u8) -> i64;
    fn naso_async_flush(fd: u64) -> u64;
    fn naso_io_uring_setup(entries: u32) -> u64;
    fn naso_io_uring_submit(ring_fd: u64) -> u64;
    fn naso_io_uring_wait_cqe(ring_fd: u64, cqe_ptr: *mut u8) -> u64;
    fn naso_io_uring_register_buffers(ring_fd: u64, bufs_ptr: *const u8, count: u32) -> u64;
    fn naso_io_uring_register_files(ring_fd: u64, files_ptr: *const u64, count: u32) -> u64;
}

// ============================================================================
// Core Async I/O Traits
// ============================================================================

trait AsyncRead {
    fn read(&mut self, buf: &mut [u8]) -> impl Future<Output = Result<usize, IoError>>;
    fn read_exact(&mut self, buf: &mut [u8]) -> impl Future<Output = Result<(), IoError>>;
    fn read_to_end(&mut self, buf: &mut Vec<u8>) -> impl Future<Output = Result<usize, IoError>>;
    fn read_to_string(&mut self, buf: &mut String) -> impl Future<Output = Result<usize, IoError>>;
}

trait AsyncWrite {
    fn write(&mut self, buf: &[u8]) -> impl Future<Output = Result<usize, IoError>>;
    fn write_all(&mut self, buf: &[u8]) -> impl Future<Output = Result<(), IoError>>;
    fn flush(&mut self) -> impl Future<Output = Result<(), IoError>>;
    fn shutdown(&mut self) -> impl Future<Output = Result<(), IoError>>;
}

trait AsyncSeek {
    fn seek(&mut self, pos: SeekFrom) -> impl Future<Output = Result<u64, IoError>>;
}

trait AsyncBufRead: AsyncRead {
    fn fill_buf(&mut self) -> impl Future<Output = Result<&[u8], IoError>>;
    fn consume(&mut self, amt: usize);
    fn read_line(&mut self, buf: &mut String) -> impl Future<Output = Result<usize, IoError>>;
    fn read_until(&mut self, byte: u8, buf: &mut Vec<u8>) -> impl Future<Output = Result<usize, IoError>>;
}

// ============================================================================
// Error Types
// ============================================================================

enum IoErrorKind {
    NotFound,
    PermissionDenied,
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    AddrInUse,
    AddrNotAvailable,
    BrokenPipe,
    AlreadyExists,
    WouldBlock,
    InvalidInput,
    InvalidData,
    TimedOut,
    Interrupted,
    WriteZero,
    UnexpectedEof,
    Other,
}

struct IoError {
    kind: IoErrorKind,
    message: String,
}

impl IoError {
    fn new(kind: IoErrorKind, message: String) -> Self {
        IoError { kind, message }
    }
    
    fn kind(&self) -> IoErrorKind {
        self.kind
    }
    
    fn to_string(&self) -> String {
        self.message.clone()
    }
}

impl From<IoErrorKind> for IoError {
    fn from(kind: IoErrorKind) -> Self {
        IoError { kind, message: String::new() }
    }
}

enum SeekFrom {
    Start(u64),
    End(i64),
    Current(i64),
}

// ============================================================================
// Async TCP Stream
// ============================================================================

struct AsyncTcpStream {
    fd: u64,
    ring_fd: u64,
    read_buf: Vec<u8>,
    read_pos: usize,
    read_len: usize,
}

impl AsyncTcpStream {
    pub async fn connect(addr: &str) -> Result<Self, IoError> {
        // Implementation uses naso-ffi async connect
        let fd = naso_tcp_connect_async(addr).await?;
        let ring_fd = naso_io_uring_setup(32)?;
        Ok(AsyncTcpStream { 
            fd, 
            ring_fd, 
            read_buf: vec![0; 8192], 
            read_pos: 0, 
            read_len: 0 
        })
    }
    
    pub fn from_fd(fd: u64) -> Self {
        let ring_fd = naso_io_uring_setup(32);
        AsyncTcpStream { 
            fd, 
            ring_fd, 
            read_buf: vec![0; 8192], 
            read_pos: 0, 
            read_len: 0 
        }
    }
    
    pub fn fd(&self) -> u64 {
        self.fd
    }
}

impl AsyncRead for AsyncTcpStream {
    async fn read(&mut self, buf: &mut [u8]) -> Result<usize, IoError> {
        if self.read_pos < self.read_len {
            let available = self.read_len - self.read_pos;
            let to_copy = buf.len().min(available);
            buf[..to_copy].copy_from_slice(&self.read_buf[self.read_pos..self.read_pos + to_copy]);
            self.read_pos += to_copy;
            return Ok(to_copy);
        }
        
        let n = naso_async_read(self.fd, self.read_buf.as_mut_ptr(), self.read_buf.len()).await?;
        if n == 0 {
            return Ok(0); // EOF
        }
        self.read_len = n;
        self.read_pos = 0;
        
        let to_copy = buf.len().min(n);
        buf[..to_copy].copy_from_slice(&self.read_buf[..to_copy]);
        self.read_pos = to_copy;
        Ok(to_copy)
    }
    
    async fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), IoError> {
        let mut total = 0;
        while total < buf.len() {
            let n = self.read(&mut buf[total..]).await?;
            if n == 0 {
                return Err(IoError::new(IoErrorKind::UnexpectedEof, "unexpected EOF".into()));
            }
            total += n;
        }
        Ok(())
    }
    
    async fn read_to_end(&mut self, buf: &mut Vec<u8>) -> Result<usize, IoError> {
        let mut total = 0;
        let mut temp = vec![0; 4096];
        loop {
            let n = self.read(&mut temp).await?;
            if n == 0 {
                break;
            }
            buf.extend_from_slice(&temp[..n]);
            total += n;
        }
        Ok(total)
    }
    
    async fn read_to_string(&mut self, buf: &mut String) -> Result<usize, IoError> {
        let mut bytes = Vec::new();
        let n = self.read_to_end(&mut bytes).await?;
        *buf = String::from_utf8(bytes).map_err(|_| IoError::new(IoErrorKind::InvalidData, "invalid UTF-8".into()))?;
        Ok(n)
    }
}

impl AsyncWrite for AsyncTcpStream {
    async fn write(&mut self, buf: &[u8]) -> Result<usize, IoError> {
        let n = naso_async_write(self.fd, buf.as_ptr(), buf.len()).await?;
        Ok(n)
    }
    
    async fn write_all(&mut self, buf: &[u8]) -> Result<(), IoError> {
        let mut total = 0;
        while total < buf.len() {
            let n = self.write(&buf[total..]).await?;
            if n == 0 {
                return Err(IoError::new(IoErrorKind::WriteZero, "write zero".into()));
            }
            total += n;
        }
        Ok(())
    }
    
    async fn flush(&mut self) -> Result<(), IoError> {
        naso_async_flush(self.fd).await?;
        Ok(())
    }
    
    async fn shutdown(&mut self) -> Result<(), IoError> {
        // Close the connection
        naso_close(self.fd);
        Ok(())
    }
}

impl AsyncSeek for AsyncTcpStream {
    async fn seek(&mut self, _pos: SeekFrom) -> Result<u64, IoError> {
        // TCP streams don't support seeking
        Err(IoError::new(IoErrorKind::InvalidInput, "TCP stream does not support seeking".into()))
    }
}

// ============================================================================
// Async File
// ============================================================================

struct AsyncFile {
    fd: u64,
    ring_fd: u64,
    position: u64,
}

impl AsyncFile {
    pub async fn open(path: &str) -> Result<Self, IoError> {
        let fd = naso_file_open(path).await?;
        let ring_fd = naso_io_uring_setup(32)?;
        Ok(AsyncFile { fd, ring_fd, position: 0 })
    }
    
    pub async fn create(path: &str) -> Result<Self, IoError> {
        let fd = naso_file_create(path).await?;
        let ring_fd = naso_io_uring_setup(32)?;
        Ok(AsyncFile { fd, ring_fd, position: 0 })
    }
}

impl AsyncRead for AsyncFile {
    async fn read(&mut self, buf: &mut [u8]) -> Result<usize, IoError> {
        let n = naso_async_read(self.fd, buf.as_mut_ptr(), buf.len()).await?;
        self.position += n as u64;
        Ok(n)
    }
    
    async fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), IoError> {
        let mut total = 0;
        while total < buf.len() {
            let n = self.read(&mut buf[total..]).await?;
            if n == 0 {
                return Err(IoError::new(IoErrorKind::UnexpectedEof, "unexpected EOF".into()));
            }
            total += n;
        }
        Ok(())
    }
    
    async fn read_to_end(&mut self, buf: &mut Vec<u8>) -> Result<usize, IoError> {
        let mut total = 0;
        let mut temp = vec![0; 4096];
        loop {
            let n = self.read(&mut temp).await?;
            if n == 0 {
                break;
            }
            buf.extend_from_slice(&temp[..n]);
            total += n;
        }
        Ok(total)
    }
    
    async fn read_to_string(&mut self, buf: &mut String) -> Result<usize, IoError> {
        let mut bytes = Vec::new();
        let n = self.read_to_end(&mut bytes).await?;
        *buf = String::from_utf8(bytes).map_err(|_| IoError::new(IoErrorKind::InvalidData, "invalid UTF-8".into()))?;
        Ok(n)
    }
}

impl AsyncWrite for AsyncFile {
    async fn write(&mut self, buf: &[u8]) -> Result<usize, IoError> {
        let n = naso_async_write(self.fd, buf.as_ptr(), buf.len()).await?;
        self.position += n as u64;
        Ok(n)
    }
    
    async fn write_all(&mut self, buf: &[u8]) -> Result<(), IoError> {
        let mut total = 0;
        while total < buf.len() {
            let n = self.write(&buf[total..]).await?;
            if n == 0 {
                return Err(IoError::new(IoErrorKind::WriteZero, "write zero".into()));
            }
            total += n;
        }
        Ok(())
    }
    
    async fn flush(&mut self) -> Result<(), IoError> {
        naso_async_flush(self.fd).await?;
        Ok(())
    }
    
    async fn shutdown(&mut self) -> Result<(), IoError> {
        naso_close(self.fd);
        Ok(())
    }
}

impl AsyncSeek for AsyncFile {
    async fn seek(&mut self, pos: SeekFrom) -> Result<u64, IoError> {
        let (whence, offset) = match pos {
            SeekFrom::Start(p) => (0, p as i64),
            SeekFrom::End(p) => (2, p),
            SeekFrom::Current(p) => (1, p),
        };
        let new_pos = naso_async_seek(self.fd, offset, whence).await?;
        self.position = new_pos as u64;
        Ok(self.position)
    }
}

// ============================================================================
// BufReader for AsyncRead
// ============================================================================

struct BufReader<R: AsyncRead> {
    inner: R,
    buf: Vec<u8>,
    pos: usize,
    cap: usize,
}

impl<R: AsyncRead> BufReader<R> {
    pub fn new(inner: R) -> Self {
        BufReader {
            inner,
            buf: vec![0; 8192],
            pos: 0,
            cap: 0,
        }
    }
    
    pub fn with_capacity(cap: usize, inner: R) -> Self {
        BufReader {
            inner,
            buf: vec![0; cap],
            pos: 0,
            cap: 0,
        }
    }
    
    pub fn get_mut(&mut self) -> &mut R {
        &mut self.inner
    }
    
    pub fn get_ref(&self) -> &R {
        &self.inner
    }
    
    pub fn into_inner(self) -> R {
        self.inner
    }
}

impl<R: AsyncRead> AsyncRead for BufReader<R> {
    async fn read(&mut self, buf: &mut [u8]) -> Result<usize, IoError> {
        if self.pos < self.cap {
            let available = self.cap - self.pos;
            let to_copy = buf.len().min(available);
            buf[..to_copy].copy_from_slice(&self.buf[self.pos..self.pos + to_copy]);
            self.pos += to_copy;
            return Ok(to_copy);
        }
        
        self.cap = self.inner.read(&mut self.buf).await?;
        self.pos = 0;
        
        if self.cap == 0 {
            return Ok(0);
        }
        
        let to_copy = buf.len().min(self.cap);
        buf[..to_copy].copy_from_slice(&self.buf[..to_copy]);
        self.pos = to_copy;
        Ok(to_copy)
    }
    
    async fn read_exact(&mut self, buf: &mut [u8]) -> Result<(), IoError> {
        let mut total = 0;
        while total < buf.len() {
            let n = self.read(&mut buf[total..]).await?;
            if n == 0 {
                return Err(IoError::new(IoErrorKind::UnexpectedEof, "unexpected EOF".into()));
            }
            total += n;
        }
        Ok(())
    }
    
    async fn read_to_end(&mut self, buf: &mut Vec<u8>) -> Result<usize, IoError> {
        let mut total = 0;
        // First drain buffer
        if self.pos < self.cap {
            let available = self.cap - self.pos;
            buf.extend_from_slice(&self.buf[self.pos..self.cap]);
            total += available;
            self.pos = self.cap;
        }
        // Then read from inner
        let inner_total = self.inner.read_to_end(buf).await?;
        total += inner_total;
        Ok(total)
    }
    
    async fn read_to_string(&mut self, buf: &mut String) -> Result<usize, IoError> {
        let mut bytes = Vec::new();
        let n = self.read_to_end(&mut bytes).await?;
        *buf = String::from_utf8(bytes).map_err(|_| IoError::new(IoErrorKind::InvalidData, "invalid UTF-8".into()))?;
        Ok(n)
    }
}

impl<R: AsyncRead> AsyncBufRead for BufReader<R> {
    async fn fill_buf(&mut self) -> Result<&[u8], IoError> {
        if self.pos >= self.cap {
            self.cap = self.inner.read(&mut self.buf).await?;
            self.pos = 0;
        }
        Ok(&self.buf[self.pos..self.cap])
    }
    
    fn consume(&mut self, amt: usize) {
        self.pos = (self.pos + amt).min(self.cap);
    }
    
    async fn read_line(&mut self, buf: &mut String) -> Result<usize, IoError> {
        let mut total = 0;
        loop {
            let available = self.fill_buf().await?;
            if available.is_empty() {
                break;
            }
            
            if let Some(newline_pos) = available.iter().position(|&b| b == b'\n') {
                let line = &available[..=newline_pos];
                buf.push_str(&String::from_utf8_lossy(line));
                self.consume(newline_pos + 1);
                total += newline_pos + 1;
                return Ok(total);
            }
            
            buf.push_str(&String::from_utf8_lossy(available));
            total += available.len();
            self.consume(available.len());
        }
        Ok(total)
    }
    
    async fn read_until(&mut self, byte: u8, buf: &mut Vec<u8>) -> Result<usize, IoError> {
        let mut total = 0;
        loop {
            let available = self.fill_buf().await?;
            if available.is_empty() {
                break;
            }
            
            if let Some(found_pos) = available.iter().position(|&b| b == byte) {
                buf.extend_from_slice(&available[..=found_pos]);
                self.consume(found_pos + 1);
                total += found_pos + 1;
                return Ok(total);
            }
            
            buf.extend_from_slice(available);
            total += available.len();
            self.consume(available.len());
        }
        Ok(total)
    }
}

// ============================================================================
// io_uring Integration
// ============================================================================

struct IoUring {
    ring_fd: u64,
    sqes: Vec<IoUringSqe>,
    cqes: Vec<IoUringCqe>,
}

struct IoUringSqe {
    opcode: u8,
    fd: u64,
    addr: u64,
    len: u32,
    offset: i64,
    user_data: u64,
    flags: u8,
    buf_index: u16,
}

struct IoUringCqe {
    user_data: u64,
    res: i32,
    flags: u32,
}

impl IoUring {
    pub fn new(entries: u32) -> Result<Self, IoError> {
        let ring_fd = naso_io_uring_setup(entries);
        if ring_fd == 0 {
            return Err(IoError::new(IoErrorKind::Other, "failed to create io_uring".into()));
        }
        Ok(IoUring {
            ring_fd,
            sqes: Vec::with_capacity(entries as usize),
            cqes: Vec::new(),
        })
    }
    
    pub fn submit(&mut self) -> Result<u32, IoError> {
        let submitted = naso_io_uring_submit(self.ring_fd)?;
        Ok(submitted as u32)
    }
    
    pub fn wait_cqe(&mut self) -> Result<IoUringCqe, IoError> {
        let mut cqe_bytes = [0u8; 32];
        naso_io_uring_wait_cqe(self.ring_fd, cqe_bytes.as_mut_ptr())?;
        // Parse CQE from bytes (simplified)
        Ok(IoUringCqe {
            user_data: u64::from_ne_bytes(cqe_bytes[0..8].try_into().unwrap()),
            res: i32::from_ne_bytes(cqe_bytes[8..12].try_into().unwrap()),
            flags: u32::from_ne_bytes(cqe_bytes[12..16].try_into().unwrap()),
        })
    }
    
    pub fn register_buffers(&mut self, bufs: &[Vec<u8>]) -> Result<(), IoError> {
        // Register buffers for zero-copy I/O
        let ptrs: Vec<u64> = bufs.iter().map(|b| b.as_ptr() as u64).collect();
        let lens: Vec<u32> = bufs.iter().map(|b| b.len() as u32).collect();
        // Combined into single buffer for FFI
        let mut combined = Vec::new();
        for (ptr, len) in ptrs.iter().zip(lens.iter()) {
            combined.extend_from_slice(&ptr.to_ne_bytes());
            combined.extend_from_slice(&len.to_ne_bytes());
        }
        naso_io_uring_register_buffers(self.ring_fd, combined.as_ptr(), bufs.len() as u32)?;
        Ok(())
    }
    
    pub fn register_files(&mut self, fds: &[u64]) -> Result<(), IoError> {
        naso_io_uring_register_files(self.ring_fd, fds.as_ptr(), fds.len() as u32)?;
        Ok(())
    }
    
    pub fn prep_read(&mut self, fd: u64, buf: &mut [u8], offset: i64, user_data: u64) {
        self.sqes.push(IoUringSqe {
            opcode: 0, // IORING_OP_READ
            fd,
            addr: buf.as_mut_ptr() as u64,
            len: buf.len() as u32,
            offset,
            user_data,
            flags: 0,
            buf_index: 0,
        });
    }
    
    pub fn prep_write(&mut self, fd: u64, buf: &[u8], offset: i64, user_data: u64) {
        self.sqes.push(IoUringSqe {
            opcode: 1, // IORING_OP_WRITE
            fd,
            addr: buf.as_ptr() as u64,
            len: buf.len() as u32,
            offset,
            user_data,
            flags: 0,
            buf_index: 0,
        });
    }
    
    pub fn prep_accept(&mut self, fd: u64, addr_ptr: u64, addrlen_ptr: u64, user_data: u64) {
        self.sqes.push(IoUringSqe {
            opcode: 2, // IORING_OP_ACCEPT
            fd,
            addr: addr_ptr,
            len: 0,
            offset: 0,
            user_data,
            flags: 0,
            buf_index: 0,
        });
    }
}

// ============================================================================
// Async TCP Listener
// ============================================================================

struct AsyncTcpListener {
    fd: u64,
    ring: IoUring,
}

impl AsyncTcpListener {
    pub async fn bind(addr: &str) -> Result<Self, IoError> {
        let fd = naso_tcp_bind(addr)?;
        let ring = IoUring::new(32)?;
        ring.register_files(&[fd])?;
        Ok(AsyncTcpListener { fd, ring })
    }
    
    pub async fn accept(&mut self) -> Result<(AsyncTcpStream, SocketAddr), IoError> {
        let mut out = [0u64; 2];
        self.ring.prep_accept(self.fd, out.as_mut_ptr() as u64, 0, 1);
        self.ring.submit()?;
        let cqe = self.ring.wait_cqe()?;
        
        if cqe.res < 0 {
            return Err(IoError::new(IoErrorKind::Other, "accept failed".into()));
        }
        
        let client_fd = out[1];
        let stream = AsyncTcpStream::from_fd(client_fd);
        let addr = SocketAddr::new(); // Would parse from out[0]
        
        Ok((stream, addr))
    }
    
    pub fn set_nonblocking(&self, _nonblocking: bool) -> Result<(), IoError> {
        Ok(())
    }
}

struct SocketAddr {
    ip: [u8; 16],
    port: u16,
    is_ipv6: bool,
}

impl SocketAddr {
    fn new() -> Self {
        SocketAddr { ip: [0; 16], port: 0, is_ipv6: false }
    }
}

// ============================================================================
// Utility Functions (extern from naso-ffi)
// ============================================================================

extern "C" {
    fn naso_tcp_connect_async(addr_ptr: *const u8, addr_len: usize) -> u64;
    fn naso_file_open(path_ptr: *const u8, path_len: usize) -> u64;
    fn naso_file_create(path_ptr: *const u8, path_len: usize) -> u64;
    fn naso_close(fd: u64);
    fn naso_tcp_bind(addr_ptr: *const u8, addr_len: usize) -> u64;
}