// ============================================================================
// Completion Support
// ============================================================================

enum Shell {
    Bash = 0,
    Zsh = 1,
    Fish = 2,
    PowerShell = 3,
    Elvish = 4,
}

impl Shell {
    pub fn from_str(s: &str) -> Option<Self> {
        match s {
            "bash" => Some(Shell::Bash),
            "zsh" => Some(Shell::Zsh),
            "fish" => Some(Shell::Fish),
            "powershell" | "pwsh" => Some(Shell::PowerShell),
            "elvish" => Some(Shell::Elvish),
            _ => None,
        }
    }
    
    pub fn file_extension(&self) -> &str {
        match self {
            Shell::Bash => "bash",
            Shell::Zsh => "zsh",
            Shell::Fish => "fish",
            Shell::PowerShell => "ps1",
            Shell::Elvish => "elv",
        }
    }
}

fn generate_completions(app: &Command, shell: Shell, output_path: &str) -> Result<(), CliError> {
    let completions = app.generate_completions(shell)?;
    std::fs::write(output_path, completions).map_err(|_| CliError::IoError)
}

// ============================================================================
// Argument Groups
// ============================================================================

struct ArgGroup {
    name: String,
    args: Vec<String>,
    required: bool,
    multiple: bool,
}

impl ArgGroup {
    pub fn new(name: &str) -> Self {
        ArgGroup {
            name: name.into(),
            args: Vec::new(),
            required: false,
            multiple: false,
        }
    }
    
    pub fn arg(mut self, arg: &str) -> Self {
        self.args.push(arg.into());
        self
    }
    
    pub fn args(mut self, args: &[&str]) -> Self {
        self.args.extend(args.iter().map(|s| s.to_string()));
        self
    }
    
    pub fn required(mut self, required: bool) -> Self {
        self.required = required;
        self
    }
    
    pub fn multiple(mut self, multiple: bool) -> Self {
        self.multiple = multiple;
        self
    }
}

// ============================================================================
// Value Hints (for completions)
// ============================================================================

enum ValueHint {
    Unknown,
    Other,
    Path,
    FilePath,
    DirPath,
    ExecutablePath,
    Hostname,
    Username,
    Email,
    Url,
    AnyPath,
}

// ============================================================================
// Error Types
// ============================================================================

enum CliError {
    AppCreationFailed,
    ArgCreationFailed,
    SubcommandCreationFailed,
    ParseFailed,
    HelpGenerationFailed,
    CompletionGenerationFailed,
    ParseError(String),
    InvalidUtf8,
    IoError,
    MissingRequiredArgument(String),
    UnknownArgument(String),
    InvalidValue(String),
    ArgumentConflict(String),
    SubcommandRequired,
    InvalidSubcommand(String),
    VersionMismatch,
}

impl CliError {
    pub fn to_string(&self) -> String {
        match self {
            CliError::AppCreationFailed => "Failed to create CLI app".into(),
            CliError::ArgCreationFailed => "Failed to create argument".into(),
            CliError::SubcommandCreationFailed => "Failed to create subcommand".into(),
            CliError::ParseFailed => "Failed to parse arguments".into(),
            CliError::HelpGenerationFailed => "Failed to generate help".into(),
            CliError::CompletionGenerationFailed => "Failed to generate completions".into(),
            CliError::ParseError(msg) => format!("Parse error: {}", msg),
            CliError::InvalidUtf8 => "Invalid UTF-8".into(),
            CliError::IoError => "I/O error".into(),
            CliError::MissingRequiredArgument(arg) => format!("Missing required argument: {}", arg),
            CliError::UnknownArgument(arg) => format!("Unknown argument: {}", arg),
            CliError::InvalidValue(msg) => format!("Invalid value: {}", msg),
            CliError::ArgumentConflict(msg) => format!("Argument conflict: {}", msg),
            CliError::SubcommandRequired => "Subcommand required".into(),
            CliError::InvalidSubcommand(cmd) => format!("Invalid subcommand: {}", cmd),
            CliError::VersionMismatch => "Version mismatch".into(),
        }
    }
}

fn args_to_json(args: &[String]) -> String {
    let mut json = String::from("[");
    for (i, arg) in args.iter().enumerate() {
        if i > 0 {
            json.push(',');
        }
        json.push_str(&format!("\"{}\"", arg.replace('"', "\\\"")));
    }
    json.push(']');
    json
}

