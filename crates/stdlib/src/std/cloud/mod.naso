    fn naso_cloud_k8s_configmap_get(client: u64, name_ptr: *const u8, name_len: usize, namespace_ptr: *const u8, namespace_len: usize, out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_cloud_k8s_secret_get(client: u64, name_ptr: *const u8, name_len: usize, namespace_ptr: *const u8, namespace_len: usize, out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_cloud_k8s_watch_resources(client: u64, resource_ptr: *const u8, resource_len: usize, callback_ptr: *const u8) -> u64;
    fn naso_cloud_k8s_leader_elect(client: u64, lock_name_ptr: *const u8, lock_name_len: usize, identity_ptr: *const u8, identity_len: usize, ttl_secs: u32) -> u64;
    fn naso_cloud_k8s_leader_renew(client: u64, lock_name_ptr: *const u8, lock_name_len: usize, identity_ptr: *const u8, identity_len: usize) -> u64;
    fn naso_cloud_k8s_leader_resign(client: u64, lock_name_ptr: *const u8, lock_name_len: usize, identity_ptr: *const u8, identity_len: usize) -> u64;

    fn naso_cloud_vm_metadata_get(key_ptr: *const u8, key_len: usize, out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_cloud_vm_instance_id(out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_cloud_vm_zone(out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_cloud_vm_tags(out_ptr: *mut u8, out_max_len: usize) -> u64;

    fn naso_cloud_health_register(endpoint: *const u8, endpoint_len: usize, check_ptr: *const u8, check_len: usize) -> u64;
    fn naso_cloud_health_unregister(registration: u64);
    fn naso_cloud_health_check_all(out_ptr: *mut u8, out_max_len: usize) -> u64;

    fn naso_cloud_shutdown_signal_register(callback_ptr: *const u8) -> u64;
    fn naso_cloud_shutdown_signal_unregister(handle: u64);
    fn naso_cloud_shutdown_initiated() -> bool;
    fn naso_cloud_shutdown_deadline_ns() -> u64;
}

// ============================================================================
// Cloud Provider Detection
// ============================================================================

enum CloudProvider {
    Kubernetes,
    Aws,
    Gcp,
    Azure,
    DigitalOcean,
    Hetzner,
    BareMetal,
    Unknown,
}

fn detect_cloud_provider() -> CloudProvider {
    // Check for Kubernetes first
    if std::path::Path::new("/var/run/secrets/kubernetes.io/serviceaccount/token").exists() {
        return CloudProvider::Kubernetes;
    }

    // Check cloud metadata endpoints
    if vm_metadata_exists("http://169.254.169.254/latest/meta-data/") {
        return CloudProvider::Aws;
    }
    if vm_metadata_exists("http://metadata.google.internal/computeMetadata/v1/") {
        return CloudProvider::Gcp;
    }
    if vm_metadata_exists("http://169.254.169.254/metadata/instance") {
        return CloudProvider::Azure;
    }
    if vm_metadata_exists("http://169.254.169.254/metadata/v1/") {
        return CloudProvider::DigitalOcean;
    }
    if vm_metadata_exists("http://169.254.169.254/hetzner/v1/") {
        return CloudProvider::Hetzner;
    }

    CloudProvider::BareMetal
}

fn vm_metadata_exists(url: &str) -> bool {
    // Would do a quick HTTP HEAD request
    false // Placeholder
}

// ============================================================================
// Kubernetes Integration
// ============================================================================

struct K8sConfig {
    api_server: Option<String>,
    token: Option<String>,
    ca_cert: Option<String>,
    namespace: Option<String>,
    qps: f32,
    burst: u32,
}

impl K8sConfig {
    pub fn in_cluster() -> Result<Self, CloudError> {
        let token = std::fs::read_to_string("/var/run/secrets/kubernetes.io/serviceaccount/token")
            .map_err(|_| CloudError::K8sConfigMissing)?;
        let ca_cert = std::fs::read_to_string("/var/run/secrets/kubernetes.io/serviceaccount/ca.crt")
            .map_err(|_| CloudError::K8sConfigMissing)?;
        let namespace = std::fs::read_to_string("/var/run/secrets/kubernetes.io/serviceaccount/namespace")
            .unwrap_or_else(|_| "default".into());

        Ok(K8sConfig {
            api_server: Some("https://kubernetes.default.svc".into()),
            token: Some(token.trim().into()),
            ca_cert: Some(ca_cert),
            namespace: Some(namespace.trim().into()),
            qps: 50.0,
            burst: 100,
        })
    }

    pub fn from_kubeconfig(path: &str) -> Result<Self, CloudError> {
        // Parse kubeconfig file
        Err(CloudError::NotImplemented)
    }

    pub fn api_server(mut self, server: &str) -> Self {
        self.api_server = Some(server.into());
        self
    }

    pub fn namespace(mut self, ns: &str) -> Self {
        self.namespace = Some(ns.into());
        self
    }

    pub fn qps(mut self, qps: f32) -> Self {
        self.qps = qps;
        self
    }

    pub fn burst(mut self, burst: u32) -> Self {
        self.burst = burst;
        self
    }

    fn to_json(&self) -> String {
        let mut json = String::from("{");
        if let Some(s) = &self.api_server {
            json.push_str(&format!("\"api_server\":\"{}\",", s));
        }
        if let Some(s) = &self.token {
            json.push_str(&format!("\"token\":\"{}\",", s));
        }
        if let Some(s) = &self.ca_cert {
            json.push_str(&format!("\"ca_cert\":\"{}\",", s.replace('\n', "\\n")));
        }
        if let Some(s) = &self.namespace {
            json.push_str(&format!("\"namespace\":\"{}\",", s));
        }
        json.push_str(&format!("\"qps\":{},\"burst\":{}}}", self.qps, self.burst));
        json
    }
}

struct K8sClient {
    inner: u64,
    config: K8sConfig,
}

impl K8sClient {
    pub fn new(config: K8sConfig) -> Result<Self, CloudError> {
        let json = config.to_json();
        let inner = naso_cloud_k8s_client_new(json.as_ptr(), json.len());
        if inner == 0 {
            return Err(CloudError::K8sClientCreationFailed);
        }
        Ok(K8sClient { inner, config })
    }

    pub fn pod_info(&self) -> Result<PodInfo, CloudError> {
        let mut out = vec![0u8; 8192];
        let len = naso_cloud_k8s_pod_info(self.inner, out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(CloudError::K8sRequestFailed);
        }
        out.truncate(len as usize);
        PodInfo::from_json(&String::from_utf8(out).map_err(|_| CloudError::InvalidJson)?)
    }

    pub fn discover_service(&self, name: &str, namespace: Option<&str>) -> Result<ServiceEndpoints, CloudError> {
        let ns = namespace.unwrap_or(self.config.namespace.as_deref().unwrap_or("default"));
        let mut out = vec![0u8; 8192];
        let len = naso_cloud_k8s_service_discover(
            self.inner,
            name.as_ptr(), name.len(),
            ns.as_ptr(), ns.len(),
            out.as_mut_ptr(), out.len(),
        );
        if len == 0 {
            return Err(CloudError::K8sRequestFailed);
        }
        out.truncate(len as usize);
        ServiceEndpoints::from_json(&String::from_utf8(out).map_err(|_| CloudError::InvalidJson)?)
    }

    pub fn get_configmap(&self, name: &str, namespace: Option<&str>) -> Result<ConfigMap, CloudError> {
        let ns = namespace.unwrap_or(self.config.namespace.as_deref().unwrap_or("default"));
        let mut out = vec![0u8; 65536];
        let len = naso_cloud_k8s_configmap_get(
            self.inner,
            name.as_ptr(), name.len(),
            ns.as_ptr(), ns.len(),
            out.as_mut_ptr(), out.len(),
        );
        if len == 0 {
            return Err(CloudError::K8sRequestFailed);
        }
        out.truncate(len as usize);
        ConfigMap::from_json(&String::from_utf8(out).map_err(|_| CloudError::InvalidJson)?)
    }

    pub fn get_secret(&self, name: &str, namespace: Option<&str>) -> Result<Secret, CloudError> {
        let ns = namespace.unwrap_or(self.config.namespace.as_deref().unwrap_or("default"));
        let mut out = vec![0u8; 65536];
        let len = naso_cloud_k8s_secret_get(
            self.inner,
            name.as_ptr(), name.len(),
            ns.as_ptr(), ns.len(),
            out.as_mut_ptr(), out.len(),
        );
        if len == 0 {
            return Err(CloudError::K8sRequestFailed);
        }
        out.truncate(len as usize);
        Secret::from_json(&String::from_utf8(out).map_err(|_| CloudError::InvalidJson)?)
    }

    pub fn watch_resources(&self, resource: &str, callback: impl Fn(String) + Send + 'static) -> Result<WatchHandle, CloudError> {
        // Would register a watch with callback
        Err(CloudError::NotImplemented)
    }

    pub fn leader_election(&self, lock_name: &str, identity: &str, ttl_secs: u32) -> Result<LeaderLock, CloudError> {
        let handle = naso_cloud_k8s_leader_elect(
            self.inner,
            lock_name.as_ptr(), lock_name.len(),
            identity.as_ptr(), identity.len(),
            ttl_secs,
        );
        if handle == 0 {
            return Err(CloudError::LeaderElectionFailed);
        }
        Ok(LeaderLock {
            client: self.inner,
            lock_name: lock_name.into(),
            identity: identity.into(),
            handle,
        })
    }
}

impl Drop for K8sClient {
    fn drop(&mut self) {
        naso_cloud_k8s_client_free(self.inner);
    }
}

