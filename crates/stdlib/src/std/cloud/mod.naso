    namespace: String,
    uid: String,
    node_name: String,
    pod_ip: String,
    host_ip: String,
    phase: String,
    labels: HashMap<String, String>,
    annotations: HashMap<String, String>,
    containers: Vec<ContainerInfo>,
}

impl PodInfo {
    fn from_json(json: &str) -> Result<Self, CloudError> {
        // Parse JSON
        Ok(PodInfo {
            name: extract_json_field(json, "name").unwrap_or_default(),
            namespace: extract_json_field(json, "namespace").unwrap_or_default(),
            uid: extract_json_field(json, "uid").unwrap_or_default(),
            node_name: extract_json_field(json, "nodeName").unwrap_or_default(),
            pod_ip: extract_json_field(json, "podIP").unwrap_or_default(),
            host_ip: extract_json_field(json, "hostIP").unwrap_or_default(),
            phase: extract_json_field(json, "phase").unwrap_or_default(),
            labels: parse_json_object(extract_json_field(json, "labels").unwrap_or("{}".into())),
            annotations: parse_json_object(extract_json_field(json, "annotations").unwrap_or("{}".into())),
            containers: vec![],
        })
    }
}

