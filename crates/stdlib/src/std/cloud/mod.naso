struct VmMetadata;

impl VmMetadata {
    pub fn get(key: &str) -> Result<String, CloudError> {
        let mut out = vec![0u8; 4096];
        let len = naso_cloud_vm_metadata_get(key.as_ptr(), key.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(CloudError::VmMetadataNotFound);
        }
        out.truncate(len as usize);
        Ok(String::from_utf8(out).map_err(|_| CloudError::InvalidUtf8)?)
    }

    pub fn instance_id() -> Result<String, CloudError> {
        let mut out = vec![0u8; 256];
        let len = naso_cloud_vm_instance_id(out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(CloudError::VmMetadataNotFound);
        }
        out.truncate(len as usize);
        Ok(String::from_utf8(out).map_err(|_| CloudError::InvalidUtf8)?)
    }

    pub fn zone() -> Result<String, CloudError> {
        let mut out = vec![0u8; 256];
        let len = naso_cloud_vm_zone(out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(CloudError::VmMetadataNotFound);
        }
        out.truncate(len as usize);
        Ok(String::from_utf8(out).map_err(|_| CloudError::InvalidUtf8)?)
    }

    pub fn tags() -> Result<HashMap<String, String>, CloudError> {
        let mut out = vec![0u8; 4096];
        let len = naso_cloud_vm_tags(out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(CloudError::VmMetadataNotFound);
        }
        out.truncate(len as usize);
        let json = String::from_utf8(out).map_err(|_| CloudError::InvalidUtf8)?;
        Ok(parse_json_object(&json))
    }

    pub fn provider() -> CloudProvider {
        detect_cloud_provider()
    }
}

// ============================================================================
// Health Checks
// ============================================================================

enum HealthStatus {
    Healthy,
    Degraded,
    Unhealthy,
    Unknown,
}

struct HealthCheck {
    name: String,
    check_fn: Box<dyn Fn() -> HealthCheckResult + Send + Sync>,
    interval_secs: u64,
    timeout_secs: u64,
    critical: bool,
}

struct HealthCheckResult {
    status: HealthStatus,
    message: String,
    details: HashMap<String, String>,
    timestamp: u64,
}

impl HealthCheck {
    pub fn new(name: &str, check_fn: impl Fn() -> HealthCheckResult + Send + Sync + 'static) -> Self {
        HealthCheck {
            name: name.into(),
            check_fn: Box::new(check_fn),
            interval_secs: 30,
            timeout_secs: 5,
            critical: false,
        }
    }

    pub fn interval(mut self, secs: u64) -> Self {
        self.interval_secs = secs;
        self
    }

    pub fn timeout(mut self, secs: u64) -> Self {
        self.timeout_secs = secs;
        self
    }

    pub fn critical(mut self, critical: bool) -> Self {
        self.critical = critical;
        self
    }

    pub fn run(&self) -> HealthCheckResult {
        (self.check_fn)()
    }
}

struct HealthRegistry {
    checks: Vec<HealthCheck>,
    http_endpoint: Option<String>,
}

impl HealthRegistry {
    pub fn new() -> Self {
        HealthRegistry {
            checks: Vec::new(),
            http_endpoint: None,
        }
    }

    pub fn register(&mut self, check: HealthCheck) {
        self.checks.push(check);
    }

    pub fn with_http_endpoint(mut self, endpoint: &str) -> Self {
        self.http_endpoint = Some(endpoint.into());
        self
    }

    pub fn run_all(&self) -> HealthReport {
        let mut results = Vec::new();
        let mut overall = HealthStatus::Healthy;

        for check in &self.checks {
            let result = check.run();
            if check.critical && matches!(result.status, HealthStatus::Unhealthy) {
                overall = HealthStatus::Unhealthy;
            } else if matches!(result.status, HealthStatus::Degraded) && overall == HealthStatus::Healthy {
                overall = HealthStatus::Degraded;
            }
            results.push((check.name.clone(), result));
        }

        HealthReport {
            overall,
            checks: results,
            timestamp: current_timestamp(),
        }
    }

    pub fn start_http_server(&self, addr: &str) -> Result<(), CloudError> {
        // Would start HTTP server for health endpoint
        Err(CloudError::NotImplemented)
    }
}

struct HealthReport {
    overall: HealthStatus,
    checks: Vec<(String, HealthCheckResult)>,
    timestamp: u64,
}

impl HealthReport {
    pub fn to_json(&self) -> String {
        let mut json = String::from("{");
        json.push_str(&format!("\"status\":\"{}\",", self.overall.as_str()));
        json.push_str(&format!("\"timestamp\":{},", self.timestamp));
        json.push_str("\"checks\":{");
        for (i, (name, result)) in self.checks.iter().enumerate() {
            if i > 0 { json.push(','); }
            json.push_str(&format!("\"{}\":{}", name, result.to_json()));
        }
        json.push_str("}}");
        json
    }
}

impl HealthStatus {
    fn as_str(&self) -> &str {
        match self {
            HealthStatus::Healthy => "healthy",
            HealthStatus::Degraded => "degraded",
            HealthStatus::Unhealthy => "unhealthy",
            HealthStatus::Unknown => "unknown",
        }
    }
}

impl HealthCheckResult {
    fn to_json(&self) -> String {
        let mut json = String::from("{");
        json.push_str(&format!("\"status\":\"{}\",", self.status.as_str()));
        json.push_str(&format!("\"message\":\"{}\",", self.message));
        json.push_str(&format!("\"timestamp\":{},", self.timestamp));
        json.push_str("\"details\":{");
        for (i, (k, v)) in self.details.iter().enumerate() {
            if i > 0 { json.push(','); }
            json.push_str(&format!("\"{}\":\"{}\"", k, v));
        }
        json.push_str("}}");
        json
    }
}

// ============================================================================
// Graceful Shutdown
// ============================================================================

struct ShutdownManager {
    handlers: Vec<Box<dyn FnOnce() + Send>>,
    signal_registered: bool,
    deadline_ns: Option<u64>,
}

impl ShutdownManager {
    pub fn new() -> Self {
        ShutdownManager {
            handlers: Vec::new(),
            signal_registered: false,
            deadline_ns: None,
        }
    }

    pub fn on_shutdown(&mut self, handler: impl FnOnce() + Send + 'static) {
        self.handlers.push(Box::new(handler));
    }

    pub fn register_signals(&mut self) -> Result<(), CloudError> {
        if self.signal_registered {
            return Ok(());
        }

        let handle = naso_cloud_shutdown_signal_register(shutdown_callback as *const u8);
        if handle == 0 {
            return Err(CloudError::ShutdownRegistrationFailed);
        }

        self.signal_registered = true;

        // Store deadline if available
        if naso_cloud_shutdown_initiated() {
            self.deadline_ns = Some(naso_cloud_shutdown_deadline_ns());
        }

        Ok(())
    }

    pub fn execute(&mut self) {
        for handler in self.handlers.drain(..) {
            handler();
        }
    }

    pub fn is_initiated(&self) -> bool {
        naso_cloud_shutdown_initiated()
    }

    pub fn deadline_ns(&self) -> Option<u64> {
        if naso_cloud_shutdown_initiated() {
            Some(naso_cloud_shutdown_deadline_ns())
        } else {
            self.deadline_ns
        }
    }

    pub fn time_remaining_ns(&self) -> Option<u64> {
        self.deadline_ns().map(|d| {
            let now = current_timestamp_ns();
            if d > now { d - now } else { 0 }
        })
    }
}

fn shutdown_callback() {
    // Called from C when shutdown signal received
    // Would trigger Rust shutdown handlers
}

fn current_timestamp_ns() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos() as u64
}

// ============================================================================
// Service Discovery
// ============================================================================

enum ServiceDiscoveryBackend {
    Kubernetes,
    Consul,
    Etcd,
    Dns,
    Static,
}

struct ServiceInstance {
    id: String,
    name: String,
    address: String,
    port: u16,
    tags: Vec<String>,
    metadata: HashMap<String, String>,
    health_check: Option<HealthCheck>,
}

struct ServiceDiscovery {
    backend: ServiceDiscoveryBackend,
    k8s_client: Option<K8sClient>,
    consul_addr: Option<String>,
    etcd_endpoints: Vec<String>,
}

impl ServiceDiscovery {
    pub fn kubernetes(client: K8sClient) -> Self {
        ServiceDiscovery {
            backend: ServiceDiscoveryBackend::Kubernetes,
            k8s_client: Some(client),
            consul_addr: None,
            etcd_endpoints: Vec::new(),
        }
    }

    pub fn consul(addr: &str) -> Self {
        ServiceDiscovery {
            backend: ServiceDiscoveryBackend::Consul,
            k8s_client: None,
            consul_addr: Some(addr.into()),
            etcd_endpoints: Vec::new(),
        }
    }

    pub fn etcd(endpoints: &[&str]) -> Self {
        ServiceDiscovery {
            backend: ServiceDiscoveryBackend::Etcd,
            k8s_client: None,
            consul_addr: None,
            etcd_endpoints: endpoints.iter().map(|s| s.to_string()).collect(),
        }
    }

    pub fn discover(&self, service: &str) -> Result<Vec<ServiceInstance>, CloudError> {
        match self.backend {
            ServiceDiscoveryBackend::Kubernetes => {
                if let Some(client) = &self.k8s_client {
                    let endpoints = client.discover_service(service, None)?;
                    Ok(endpoints.endpoints.into_iter().map(|e| ServiceInstance {
                        id: e.ip.clone(),
                        name: service.into(),
                        address: e.ip,
                        port: endpoints.ports.first().map(|p| p.port).unwrap_or(80),
                        tags: vec![],
                        metadata: HashMap::new(),
                        health_check: None,
                    })).collect())
                } else {
                    Err(CloudError::NotConfigured)
                }
            }
            _ => Err(CloudError::NotImplemented),
        }
    }

    pub fn register(&self, instance: ServiceInstance) -> Result<(), CloudError> {
        // Register with backend
        Err(CloudError::NotImplemented)
    }

    pub fn deregister(&self, instance_id: &str) -> Result<(), CloudError> {
        Err(CloudError::NotImplemented)
    }
}

// ============================================================================
// Configuration Management
// ============================================================================

struct ConfigManager {
    sources: Vec<ConfigSource>,
    cache: HashMap<String, String>,
    watch_handles: Vec<WatchHandle>,
}

enum ConfigSource {
    Environment,
    File(String),
    K8sConfigMap(K8sClient, String, Option<String>),
    K8sSecret(K8sClient, String, Option<String>),
    Consul(String),
    Etcd(Vec<String>),
    Vault(String),
}

impl ConfigManager {
    pub fn new() -> Self {
        ConfigManager {
            sources: Vec::new(),
            cache: HashMap::new(),
            watch_handles: Vec::new(),
        }
    }

    pub fn add_env(mut self) -> Self {
        self.sources.push(ConfigSource::Environment);
        self
    }

    pub fn add_file(mut self, path: &str) -> Self {
        self.sources.push(ConfigSource::File(path.into()));
        self
    }

    pub fn add_k8s_configmap(mut self, client: K8sClient, name: &str, namespace: Option<&str>) -> Self {
        self.sources.push(ConfigSource::K8sConfigMap(client, name.into(), namespace.map(|s| s.into())));
        self
    }

    pub fn add_k8s_secret(mut self, client: K8sClient, name: &str, namespace: Option<&str>) -> Self {
        self.sources.push(ConfigSource::K8sSecret(client, name.into(), namespace.map(|s| s.into())));
        self
    }

    pub fn load(&mut self) -> Result<(), CloudError> {
        for source in &self.sources {
            self.load_source(source)?;
        }
        Ok(())
    }

    fn load_source(&mut self, source: &ConfigSource) -> Result<(), CloudError> {
        match source {
            ConfigSource::Environment => {
                for (key, value) in std::env::vars() {
                    self.cache.insert(key, value);
                }
            }
            ConfigSource::File(path) => {
                let content = std::fs::read_to_string(path).map_err(|_| CloudError::ConfigFileNotFound)?;
                // Parse based on extension
                if path.ends_with(".json") {
                    self.parse_json(&content)?;
                } else if path.ends_with(".yaml") || path.ends_with(".yml") {
                    self.parse_yaml(&content)?;
                } else if path.ends_with(".toml") {
                    self.parse_toml(&content)?;
                }
            }
            ConfigSource::K8sConfigMap(client, name, namespace) => {
                let cm = client.get_configmap(name, namespace.as_deref())?;
                for (k, v) in cm.data {
                    self.cache.insert(k, v);
                }
            }
            ConfigSource::K8sSecret(client, name, namespace) => {
                let secret = client.get_secret(name, namespace.as_deref())?;
                for (k, v) in secret.string_data {
                    self.cache.insert(k, v);
                }
            }
            _ => return Err(CloudError::NotImplemented),
        }
        Ok(())
    }

    fn parse_json(&mut self, content: &str) -> Result<(), CloudError> {
        let obj = parse_json_object(content);
        for (k, v) in obj {
            self.cache.insert(k, v);
        }
        Ok(())
    }

    fn parse_yaml(&mut self, _content: &str) -> Result<(), CloudError> {
        Err(CloudError::NotImplemented)
    }

    fn parse_toml(&mut self, _content: &str) -> Result<(), CloudError> {
        Err(CloudError::NotImplemented)
    }

    pub fn get(&self, key: &str) -> Option<&String> {
        self.cache.get(key)
    }

    pub fn get_string(&self, key: &str) -> Option<String> {
        self.cache.get(key).cloned()
    }

    pub fn get_int(&self, key: &str) -> Option<i64> {
        self.cache.get(key).and_then(|v| v.parse().ok())
    }

    pub fn get_bool(&self, key: &str) -> Option<bool> {
        self.cache.get(key).and_then(|v| v.parse().ok())
    }

    pub fn get_float(&self, key: &str) -> Option<f64> {
        self.cache.get(key).and_then(|v| v.parse().ok())
    }

    pub fn require(&self, key: &str) -> Result<String, CloudError> {
        self.cache.get(key).cloned().ok_or(CloudError::ConfigMissing(key.into()))
    }

    pub fn watch(&mut self, key: &str, callback: impl Fn(String) + Send + 'static) -> Result<(), CloudError> {
        // Would set up file watch or configmap watch
        Err(CloudError::NotImplemented)
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum CloudError {
    K8sConfigMissing,
    K8sClientCreationFailed,
    K8sRequestFailed,
    InvalidJson,
    InvalidUtf8,
    VmMetadataNotFound,
    ConfigFileNotFound,
    ConfigMissing(String),
    NotConfigured,
    NotImplemented,
    LeaderElectionFailed,
    ShutdownRegistrationFailed,
    HealthCheckFailed,
    ServiceDiscoveryFailed,
}

impl CloudError {
    pub fn to_string(&self) -> String {
        match self {
            CloudError::K8sConfigMissing => "Kubernetes in-cluster config not found".into(),
            CloudError::K8sClientCreationFailed => "Failed to create Kubernetes client".into(),
            CloudError::K8sRequestFailed => "Kubernetes API request failed".into(),
            CloudError::InvalidJson => "Invalid JSON response".into(),
            CloudError::InvalidUtf8 => "Invalid UTF-8".into(),
            CloudError::VmMetadataNotFound => "VM metadata not found".into(),
            CloudError::ConfigFileNotFound => "Configuration file not found".into(),
            CloudError::ConfigMissing(key) => format!("Required config '{}' missing", key),
            CloudError::NotConfigured => "Client not configured".into(),
            CloudError::NotImplemented => "Not implemented".into(),
            CloudError::LeaderElectionFailed => "Leader election failed".into(),
            CloudError::ShutdownRegistrationFailed => "Failed to register shutdown handler".into(),
            CloudError::HealthCheckFailed => "Health check failed".into(),
            CloudError::ServiceDiscoveryFailed => "Service discovery failed".into(),
        }
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

fn extract_json_field(json: &str, field: &str) -> Option<String> {
    // Simple JSON field extraction (would use proper parser)
    let pattern = format!("\"{}\":", field);
    if let Some(start) = json.find(&pattern) {
        let value_start = start + pattern.len();
        let remaining = &json[value_start..];
        if remaining.starts_with('"') {
            if let Some(end) = remaining[1..].find('"') {
                return Some(remaining[1..end+1].into());
            }
        } else if remaining.starts_with('{') || remaining.starts_with('[') {
            // Object or array - find matching bracket
            let mut depth = 0;
            let mut in_string = false;
            let mut escaped = false;
            for (i, c) in remaining.char_indices() {
                if !escaped && c == '"' {
                    in_string = !in_string;
                } else if !escaped && c == '\\' {
                    escaped = true;
                    continue;
                } else {
                    escaped = false;
                }
                if !in_string {
                    match c {
                        '{' | '[' => depth += 1,
                        '}' | ']' => {
                            depth -= 1;
                            if depth == 0 {
                                return Some(remaining[..=i].into());
                            }
                        }
                        _ => {}
                    }
                }
            }
        } else {
            // Primitive value
            let end = remaining.find([',', '}']).unwrap_or(remaining.len());
            return Some(remaining[..end].trim().into());
        }
    }
    None
}

fn parse_json_object(json: &str) -> HashMap<String, String> {
    let mut map = HashMap::new();
    let content = json.trim();
    if content == "{}" { return map; }
    if !content.starts_with('{') || !content.ends_with('}') { return map; }

    let inner = &content[1..content.len()-1];
    let mut current = String::new();
    let mut key = String::new();
    let mut in_key = true;
    let mut in_string = false;
    let mut escaped = false;

    for c in inner.chars() {
        if !escaped && c == '"' {
            in_string = !in_string;
            continue;
        }
        if !escaped && c == '\\' {
            escaped = true;
            current.push(c);
            continue;
        }
        escaped = false;

        if !in_string && c == ':' && in_key {
            key = current.trim().trim_matches('"').into();
            current.clear();
            in_key = false;
            continue;
        }
        if !in_string && c == ',' && !in_key {
            let value = current.trim().trim_matches('"').into();
            map.insert(key, value);
            current.clear();
            in_key = true;
            continue;
        }
        current.push(c);
    }

    if !current.is_empty() && !in_key {
        let value = current.trim().trim_matches('"').into();
        map.insert(key, value);
    }

    map
}

