struct ConfigMap {
    name: String,
    namespace: String,
    data: HashMap<String, String>,
    binary_data: HashMap<String, Vec<u8>>,
}

impl ConfigMap {
    fn from_json(json: &str) -> Result<Self, CloudError> {
        Ok(ConfigMap {
            name: extract_json_field(json, "name").unwrap_or_default(),
            namespace: extract_json_field(json, "namespace").unwrap_or_default(),
            data: parse_json_object(extract_json_field(json, "data").unwrap_or("{}".into())),
            binary_data: HashMap::new(),
        })
    }

    pub fn get(&self, key: &str) -> Option<&String> {
        self.data.get(key)
    }

    pub fn get_string(&self, key: &str) -> Option<String> {
        self.data.get(key).cloned()
    }
}

