}

// ============================================================================
// SLO Builders
// ============================================================================

struct SloBuilder {
    name: String,
    description: String,
    sli: Option<ServiceLevelIndicator>,
    target: f64,
    window: MeasurementWindow,
}

impl SloBuilder {
    pub fn new(name: &str) -> Self {
        SloBuilder {
            name: name.into(),
            description: String::new(),
            sli: None,
            target: 0.999,
            window: MeasurementWindow::Rolling { duration_secs: 3600 },
        }
    }

    pub fn description(mut self, desc: &str) -> Self {
        self.description = desc.into();
        self
    }

    pub fn latency_p99(mut self, threshold_ms: f64) -> Self {
        self.sli = Some(ServiceLevelIndicator::Latency { percentile: 0.99, threshold_ms });
        self
    }

    pub fn latency_p999(mut self, threshold_ms: f64) -> Self {
        self.sli = Some(ServiceLevelIndicator::Latency { percentile: 0.999, threshold_ms });
        self
    }

    pub fn availability(mut self) -> Self {
        self.sli = Some(ServiceLevelIndicator::Availability);
        self
    }

    pub fn error_rate(mut self, max_rate: f64) -> Self {
        self.sli = Some(ServiceLevelIndicator::ErrorRate { max_rate });
        self
    }

    pub fn throughput(mut self, min_rps: f64) -> Self {
        self.sli = Some(ServiceLevelIndicator::Throughput { min_rps });
        self
    }

    pub fn target(mut self, target: f64) -> Self {
        self.target = target.clamp(0.0, 1.0);
        self
    }

    pub fn window_rolling(mut self, secs: u64) -> Self {
        self.window = MeasurementWindow::Rolling { duration_secs: secs };
        self
    }

    pub fn build(self) -> Result<SloObjective, EnterpriseError> {
        let sli = self.sli.ok_or(EnterpriseError::ConfigError("SLI not specified".into()))?;
        Ok(SloObjective {
            name: self.name,
            description: self.description,
            sli,
            target: self.target,
            window: self.window,
        })
    }
}