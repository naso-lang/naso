// ============================================================================
// Naso HAL (Hardware Abstraction Layer) - Phase 19.8
// ============================================================================
// Cross-platform hardware abstraction for embedded and systems programming
// GPIO, I2C, SPI, UART, PWM, ADC, DMA, interrupts, timers, watchdog
// ============================================================================

extern "C" {
    // GPIO
    fn naso_hal_gpio_open(port: u8, pin: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_gpio_close(handle: u64) -> u64;
    fn naso_hal_gpio_read(handle: u64) -> u64;
    fn naso_hal_gpio_write(handle: u64, value: u8) -> u64;
    fn naso_hal_gpio_toggle(handle: u64) -> u64;
    fn naso_hal_gpio_set_mode(handle: u64, mode: u8) -> u64;
    fn naso_hal_gpio_set_pull(handle: u64, pull: u8) -> u64;
    fn naso_hal_gpio_set_drive(handle: u64, drive: u8) -> u64;
    fn naso_hal_gpio_enable_interrupt(handle: u64, trigger: u8, callback: u64) -> u64;
    fn naso_hal_gpio_disable_interrupt(handle: u64) -> u64;
    
    // I2C
    fn naso_hal_i2c_open(bus: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_i2c_close(handle: u64) -> u64;
    fn naso_hal_i2c_write(handle: u64, addr: u16, data_ptr: *const u8, data_len: usize) -> u64;
    fn naso_hal_i2c_read(handle: u64, addr: u16, buffer_ptr: *mut u8, buffer_len: usize) -> u64;
    fn naso_hal_i2c_write_read(handle: u64, addr: u16, write_ptr: *const u8, write_len: usize, read_ptr: *mut u8, read_len: usize) -> u64;
    fn naso_hal_i2c_scan(handle: u64, result_ptr: *mut u8, result_max_len: usize) -> u64;
    fn naso_hal_i2c_set_frequency(handle: u64, frequency: u32) -> u64;
    
    // SPI
    fn naso_hal_spi_open(bus: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_spi_close(handle: u64) -> u64;
    fn naso_hal_spi_transfer(handle: u64, tx_ptr: *const u8, rx_ptr: *mut u8, len: usize) -> u64;
    fn naso_hal_spi_write(handle: u64, data_ptr: *const u8, data_len: usize) -> u64;
    fn naso_hal_spi_read(handle: u64, buffer_ptr: *mut u8, buffer_len: usize) -> u64;
    fn naso_hal_spi_set_frequency(handle: u64, frequency: u32) -> u64;
    fn naso_hal_spi_set_mode(handle: u64, mode: u8) -> u64;
    fn naso_hal_spi_set_bit_order(handle: u64, order: u8) -> u64;
    
    // UART
    fn naso_hal_uart_open(port: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_uart_close(handle: u64) -> u64;
    fn naso_hal_uart_write(handle: u64, data_ptr: *const u8, data_len: usize) -> u64;
    fn naso_hal_uart_read(handle: u64, buffer_ptr: *mut u8, buffer_len: usize) -> u64;
    fn naso_hal_uart_flush(handle: u64) -> u64;
    fn naso_hal_uart_set_baudrate(handle: u64, baudrate: u32) -> u64;
    fn naso_hal_uart_set_config(handle: u64, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_uart_enable_rx_interrupt(handle: u64, callback: u64) -> u64;
    fn naso_hal_uart_disable_rx_interrupt(handle: u64) -> u64;
    
    // PWM
    fn naso_hal_pwm_open(channel: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_pwm_close(handle: u64) -> u64;
    fn naso_hal_pwm_set_duty(handle: u64, duty: u32) -> u64;
    fn naso_hal_pwm_set_period(handle: u64, period: u32) -> u64;
    fn naso_hal_pwm_set_frequency(handle: u64, frequency: u32) -> u64;
    fn naso_hal_pwm_enable(handle: u64) -> u64;
    fn naso_hal_pwm_disable(handle: u64) -> u64;
    fn naso_hal_pwm_get_max_duty(handle: u64) -> u64;
    
    // ADC
    fn naso_hal_adc_open(channel: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_adc_close(handle: u64) -> u64;
    fn naso_hal_adc_read(handle: u64) -> u64;
    fn naso_hal_adc_read_voltage(handle: u64) -> u64;
    fn naso_hal_adc_set_resolution(handle: u64, bits: u8) -> u64;
    fn naso_hal_adc_set_reference(handle: u64, reference: u8) -> u64;
    fn naso_hal_adc_enable_continuous(handle: u64, callback: u64) -> u64;
    fn naso_hal_adc_disable_continuous(handle: u64) -> u64;
    
    // DMA
    fn naso_hal_dma_alloc(channel: u8, size: usize, alignment: usize) -> u64;
    fn naso_hal_dma_free(handle: u64) -> u64;
    fn naso_hal_dma_start(handle: u64, src_ptr: *const u8, dst_ptr: *mut u8, len: usize, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_dma_wait(handle: u64, timeout_ms: u32) -> u64;
    fn naso_hal_dma_abort(handle: u64) -> u64;
    fn naso_hal_dma_set_callback(handle: u64, callback: u64) -> u64;
    
    // Timer
    fn naso_hal_timer_open(timer_id: u8, config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_timer_close(handle: u64) -> u64;
    fn naso_hal_timer_start(handle: u64) -> u64;
    fn naso_hal_timer_stop(handle: u64) -> u64;
    fn naso_hal_timer_set_period(handle: u64, period_us: u64) -> u64;
    fn naso_hal_timer_get_counter(handle: u64) -> u64;
    fn naso_hal_timer_set_callback(handle: u64, callback: u64) -> u64;
    fn naso_hal_timer_enable_interrupt(handle: u64) -> u64;
    fn naso_hal_timer_disable_interrupt(handle: u64) -> u64;
    
    // Watchdog
    fn naso_hal_wdt_open(config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_hal_wdt_close(handle: u64) -> u64;
    fn naso_hal_wdt_feed(handle: u64) -> u64;
    fn naso_hal_wdt_set_timeout(handle: u64, timeout_ms: u32) -> u64;
    fn naso_hal_wdt_get_remaining(handle: u64) -> u64;
    
    // RTC
    fn naso_hal_rtc_open() -> u64;
    fn naso_hal_rtc_close(handle: u64) -> u64;
    fn naso_hal_rtc_get_time(handle: u64, time_ptr: *mut u8, time_max_len: usize) -> u64;
    fn naso_hal_rtc_set_time(handle: u64, time_ptr: *const u8, time_len: usize) -> u64;
    fn naso_hal_rtc_set_alarm(handle: u64, time_ptr: *const u8, time_len: usize, callback: u64) -> u64;
    fn naso_hal_rtc_disable_alarm(handle: u64) -> u64;
    
    // Power Management
    fn naso_hal_pm_sleep(mode: u8) -> u64;
    fn naso_hal_pm_deep_sleep(mode: u8, wakeup_ptr: *const u8, wakeup_len: usize) -> u64;
    fn naso_hal_pm_get_wakeup_reason(reason_ptr: *mut u8, reason_max_len: usize) -> u64;
    
    // Random
    fn naso_hal_random_bytes(buffer_ptr: *mut u8, len: usize) -> u64;
    fn naso_hal_random_u32() -> u64;
    fn naso_hal_random_u64() -> u64;
    
    // System Info
    fn naso_hal_get_chip_id(id_ptr: *mut u8, id_max_len: usize) -> u64;
    fn naso_hal_get_chip_revision() -> u64;
    fn naso_hal_get_flash_size() -> u64;
    fn naso_hal_get_ram_size() -> u64;
    fn naso_hal_get_cpu_frequency() -> u64;
    fn naso_hal_get_unique_id(id_ptr: *mut u8, id_max_len: usize) -> u64;
    fn naso_hal_get_reset_reason(reason_ptr: *mut u8, reason_max_len: usize) -> u64;
    
    // Interrupts
    fn naso_hal_interrupt_enable(irq: u32) -> u64;
    fn naso_hal_interrupt_disable(irq: u32) -> u64;
    fn naso_hal_interrupt_set_priority(irq: u32, priority: u8) -> u64;
    fn naso_hal_interrupt_set_handler(irq: u32, handler: u64) -> u64;
    fn naso_hal_interrupt_pending(irq: u32) -> u64;
    
    // Board Support
    fn naso_hal_board_init() -> u64;
    fn naso_hal_board_get_led_pins(leds_ptr: *mut u8, leds_max_len: usize) -> u64;
    fn naso_hal_board_get_button_pins(buttons_ptr: *mut u8, buttons_max_len: usize) -> u64;
}

// ============================================================================
// GPIO
// ============================================================================

enum GpioMode {
    Input = 0,
    Output = 1,
    Alternate = 2,
    Analog = 3,
}

enum GpioPull {
    None = 0,
    Up = 1,
    Down = 2,
}

enum GpioDrive {
    Low = 0,
    Medium = 1,
    High = 2,
    VeryHigh = 3,
}

enum GpioInterruptTrigger {
    Rising = 0,
    Falling = 1,
    Both = 2,
    LowLevel = 3,
    HighLevel = 4,
}

struct GpioConfig {
    mode: GpioMode,
    pull: GpioPull,
    drive: GpioDrive,
    initial_value: Option<bool>,
}

impl Default for GpioConfig {
    fn default() -> Self {
        GpioConfig {
            mode: GpioMode::Input,
            pull: GpioPull::None,
            drive: GpioDrive::Medium,
            initial_value: None,
        }
    }
}

struct GpioPin {
    handle: u64,
    port: u8,
    pin: u8,
}

impl GpioPin {
    pub fn new(port: u8, pin: u8, config: GpioConfig) -> Result<Self, HalError> {
        let config_json = gpio_config_to_json(&config);
        let handle = naso_hal_gpio_open(port, pin, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::GpioOpenFailed);
        }
        Ok(GpioPin { handle, port, pin })
    }
    
    pub fn input(port: u8, pin: u8, pull: GpioPull) -> Result<Self, HalError> {
        let config = GpioConfig { mode: GpioMode::Input, pull, ..Default::default() };
        Self::new(port, pin, config)
    }
    
    pub fn output(port: u8, pin: u8, initial: bool) -> Result<Self, HalError> {
        let config = GpioConfig { mode: GpioMode::Output, initial_value: Some(initial), ..Default::default() };
        Self::new(port, pin, config)
    }
    
    pub fn read(&self) -> Result<bool, HalError> {
        let result = naso_hal_gpio_read(self.handle);
        if result == u64::MAX {
            return Err(HalError::GpioReadFailed);
        }
        Ok(result != 0)
    }
    
    pub fn write(&mut self, value: bool) -> Result<(), HalError> {
        let result = naso_hal_gpio_write(self.handle, if value { 1 } else { 0 });
        if result == 0 {
            return Err(HalError::GpioWriteFailed);
        }
        Ok(())
    }
    
    pub fn toggle(&mut self) -> Result<(), HalError> {
        let result = naso_hal_gpio_toggle(self.handle);
        if result == 0 {
            return Err(HalError::GpioWriteFailed);
        }
        Ok(())
    }
    
    pub fn set_mode(&mut self, mode: GpioMode) -> Result<(), HalError> {
        let result = naso_hal_gpio_set_mode(self.handle, mode as u8);
        if result == 0 {
            return Err(HalError::GpioConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_pull(&mut self, pull: GpioPull) -> Result<(), HalError> {
        let result = naso_hal_gpio_set_pull(self.handle, pull as u8);
        if result == 0 {
            return Err(HalError::GpioConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_drive(&mut self, drive: GpioDrive) -> Result<(), HalError> {
        let result = naso_hal_gpio_set_drive(self.handle, drive as u8);
        if result == 0 {
            return Err(HalError::GpioConfigFailed);
        }
        Ok(())
    }
    
    pub fn enable_interrupt(&mut self, trigger: GpioInterruptTrigger, callback: impl FnMut(bool) + Send + 'static) -> Result<(), HalError> {
        // Would register callback in runtime
        let cb_ptr = register_callback(Box::new(callback));
        let result = naso_hal_gpio_enable_interrupt(self.handle, trigger as u8, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn disable_interrupt(&mut self) -> Result<(), HalError> {
        let result = naso_hal_gpio_disable_interrupt(self.handle);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
}

impl Drop for GpioPin {
    fn drop(&mut self) {
        naso_hal_gpio_close(self.handle);
    }
}

fn gpio_config_to_json(config: &GpioConfig) -> String {
    format!(
        "{{\"mode\":{},\"pull\":{},\"drive\":{},\"initial_value\":{}}}",
        config.mode as u8,
        config.pull as u8,
        config.drive as u8,
        config.initial_value.map(|v| if v { "true" } else { "false" }).unwrap_or("null")
    )
}

// ============================================================================
// I2C
// ============================================================================

struct I2cConfig {
    frequency: u32,
    timeout_ms: u32,
    addressing_mode: I2cAddressingMode,
}

enum I2cAddressingMode {
    SevenBit = 0,
    TenBit = 1,
}

impl Default for I2cConfig {
    fn default() -> Self {
        I2cConfig {
            frequency: 100_000,
            timeout_ms: 1000,
            addressing_mode: I2cAddressingMode::SevenBit,
        }
    }
}

struct I2c {
    handle: u64,
    bus: u8,
}

impl I2c {
    pub fn new(bus: u8, config: I2cConfig) -> Result<Self, HalError> {
        let config_json = i2c_config_to_json(&config);
        let handle = naso_hal_i2c_open(bus, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::I2cOpenFailed);
        }
        Ok(I2c { handle, bus })
    }
    
    pub fn write(&mut self, addr: u16, data: &[u8]) -> Result<usize, HalError> {
        let result = naso_hal_i2c_write(self.handle, addr, data.as_ptr(), data.len());
        if result == u64::MAX {
            return Err(HalError::I2cWriteFailed);
        }
        Ok(result as usize)
    }
    
    pub fn read(&mut self, addr: u16, buffer: &mut [u8]) -> Result<usize, HalError> {
        let result = naso_hal_i2c_read(self.handle, addr, buffer.as_mut_ptr(), buffer.len());
        if result == u64::MAX {
            return Err(HalError::I2cReadFailed);
        }
        Ok(result as usize)
    }
    
    pub fn write_read(&mut self, addr: u16, write_data: &[u8], read_buffer: &mut [u8]) -> Result<usize, HalError> {
        let result = naso_hal_i2c_write_read(self.handle, addr, write_data.as_ptr(), write_data.len(), read_buffer.as_mut_ptr(), read_buffer.len());
        if result == u64::MAX {
            return Err(HalError::I2cWriteReadFailed);
        }
        Ok(result as usize)
    }
    
    pub fn scan(&mut self) -> Result<Vec<u16>, HalError> {
        let mut result = vec![0u8; 1024];
        let len = naso_hal_i2c_scan(self.handle, result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::I2cScanFailed);
        }
        result.truncate(len as usize);
        // Parse addresses from result
        let mut addresses = Vec::new();
        for i in (0..result.len()).step_by(2) {
            if i + 1 < result.len() {
                addresses.push(u16::from_le_bytes([result[i], result[i+1]]));
            }
        }
        Ok(addresses)
    }
    
    pub fn set_frequency(&mut self, frequency: u32) -> Result<(), HalError> {
        let result = naso_hal_i2c_set_frequency(self.handle, frequency);
        if result == 0 {
            return Err(HalError::I2cConfigFailed);
        }
        Ok(())
    }
}

impl Drop for I2c {
    fn drop(&mut self) {
        naso_hal_i2c_close(self.handle);
    }
}

fn i2c_config_to_json(config: &I2cConfig) -> String {
    format!(
        "{{\"frequency\":{},\"timeout_ms\":{},\"addressing_mode\":{}}}",
        config.frequency,
        config.timeout_ms,
        config.addressing_mode as u8
    )
}

// ============================================================================
// SPI
// ============================================================================

enum SpiMode {
    Mode0 = 0, // CPOL=0, CPHA=0
    Mode1 = 1, // CPOL=0, CPHA=1
    Mode2 = 2, // CPOL=1, CPHA=0
    Mode3 = 3, // CPOL=1, CPHA=1
}

enum SpiBitOrder {
    MsbFirst = 0,
    LsbFirst = 1,
}

struct SpiConfig {
    frequency: u32,
    mode: SpiMode,
    bit_order: SpiBitOrder,
    bits_per_word: u8,
}

impl Default for SpiConfig {
    fn default() -> Self {
        SpiConfig {
            frequency: 1_000_000,
            mode: SpiMode::Mode0,
            bit_order: SpiBitOrder::MsbFirst,
            bits_per_word: 8,
        }
    }
}

struct Spi {
    handle: u64,
    bus: u8,
}

impl Spi {
    pub fn new(bus: u8, config: SpiConfig) -> Result<Self, HalError> {
        let config_json = spi_config_to_json(&config);
        let handle = naso_hal_spi_open(bus, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::SpiOpenFailed);
        }
        Ok(Spi { handle, bus })
    }
    
    pub fn transfer(&mut self, tx: &[u8], rx: &mut [u8]) -> Result<usize, HalError> {
        if tx.len() != rx.len() {
            return Err(HalError::InvalidBufferSize);
        }
        let result = naso_hal_spi_transfer(self.handle, tx.as_ptr(), rx.as_mut_ptr(), tx.len());
        if result == u64::MAX {
            return Err(HalError::SpiTransferFailed);
        }
        Ok(result as usize)
    }
    
    pub fn write(&mut self, data: &[u8]) -> Result<usize, HalError> {
        let result = naso_hal_spi_write(self.handle, data.as_ptr(), data.len());
        if result == u64::MAX {
            return Err(HalError::SpiWriteFailed);
        }
        Ok(result as usize)
    }
    
    pub fn read(&mut self, buffer: &mut [u8]) -> Result<usize, HalError> {
        let result = naso_hal_spi_read(self.handle, buffer.as_mut_ptr(), buffer.len());
        if result == u64::MAX {
            return Err(HalError::SpiReadFailed);
        }
        Ok(result as usize)
    }
    
    pub fn set_frequency(&mut self, frequency: u32) -> Result<(), HalError> {
        let result = naso_hal_spi_set_frequency(self.handle, frequency);
        if result == 0 {
            return Err(HalError::SpiConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_mode(&mut self, mode: SpiMode) -> Result<(), HalError> {
        let result = naso_hal_spi_set_mode(self.handle, mode as u8);
        if result == 0 {
            return Err(HalError::SpiConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_bit_order(&mut self, order: SpiBitOrder) -> Result<(), HalError> {
        let result = naso_hal_spi_set_bit_order(self.handle, order as u8);
        if result == 0 {
            return Err(HalError::SpiConfigFailed);
        }
        Ok(())
    }
}

impl Drop for Spi {
    fn drop(&mut self) {
        naso_hal_spi_close(self.handle);
    }
}

fn spi_config_to_json(config: &SpiConfig) -> String {
    format!(
        "{{\"frequency\":{},\"mode\":{},\"bit_order\":{},\"bits_per_word\":{}}}",
        config.frequency,
        config.mode as u8,
        config.bit_order as u8,
        config.bits_per_word
    )
}

// ============================================================================
// UART
// ============================================================================

enum UartParity {
    None = 0,
    Even = 1,
    Odd = 2,
}

enum UartStopBits {
    One = 0,
    Two = 1,
}

enum UartFlowControl {
    None = 0,
    RtsCts = 1,
    XonXoff = 2,
}

struct UartConfig {
    baudrate: u32,
    data_bits: u8,
    parity: UartParity,
    stop_bits: UartStopBits,
    flow_control: UartFlowControl,
    timeout_ms: u32,
}

impl Default for UartConfig {
    fn default() -> Self {
        UartConfig {
            baudrate: 115_200,
            data_bits: 8,
            parity: UartParity::None,
            stop_bits: UartStopBits::One,
            flow_control: UartFlowControl::None,
            timeout_ms: 1000,
        }
    }
}

struct Uart {
    handle: u64,
    port: u8,
}

impl Uart {
    pub fn new(port: u8, config: UartConfig) -> Result<Self, HalError> {
        let config_json = uart_config_to_json(&config);
        let handle = naso_hal_uart_open(port, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::UartOpenFailed);
        }
        Ok(Uart { handle, port })
    }
    
    pub fn write(&mut self, data: &[u8]) -> Result<usize, HalError> {
        let result = naso_hal_uart_write(self.handle, data.as_ptr(), data.len());
        if result == u64::MAX {
            return Err(HalError::UartWriteFailed);
        }
        Ok(result as usize)
    }
    
    pub fn read(&mut self, buffer: &mut [u8]) -> Result<usize, HalError> {
        let result = naso_hal_uart_read(self.handle, buffer.as_mut_ptr(), buffer.len());
        if result == u64::MAX {
            return Err(HalError::UartReadFailed);
        }
        Ok(result as usize)
    }
    
    pub fn flush(&mut self) -> Result<(), HalError> {
        let result = naso_hal_uart_flush(self.handle);
        if result == 0 {
            return Err(HalError::UartFlushFailed);
        }
        Ok(())
    }
    
    pub fn set_baudrate(&mut self, baudrate: u32) -> Result<(), HalError> {
        let result = naso_hal_uart_set_baudrate(self.handle, baudrate);
        if result == 0 {
            return Err(HalError::UartConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_config(&mut self, config: UartConfig) -> Result<(), HalError> {
        let config_json = uart_config_to_json(&config);
        let result = naso_hal_uart_set_config(self.handle, config_json.as_ptr(), config_json.len());
        if result == 0 {
            return Err(HalError::UartConfigFailed);
        }
        Ok(())
    }
    
    pub fn enable_rx_interrupt(&mut self, callback: impl FnMut(&[u8]) + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(callback));
        let result = naso_hal_uart_enable_rx_interrupt(self.handle, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn disable_rx_interrupt(&mut self) -> Result<(), HalError> {
        let result = naso_hal_uart_disable_rx_interrupt(self.handle);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
}

impl Drop for Uart {
    fn drop(&mut self) {
        naso_hal_uart_close(self.handle);
    }
}

fn uart_config_to_json(config: &UartConfig) -> String {
    format!(
        "{{\"baudrate\":{},\"data_bits\":{},\"parity\":{},\"stop_bits\":{},\"flow_control\":{},\"timeout_ms\":{}}}",
        config.baudrate,
        config.data_bits,
        config.parity as u8,
        config.stop_bits as u8,
        config.flow_control as u8,
        config.timeout_ms
    )
}

// ============================================================================
// PWM
// ============================================================================

struct PwmConfig {
    frequency: u32,
    duty_cycle: u32, // 0 to max_duty
    polarity: PwmPolarity,
}

enum PwmPolarity {
    Normal = 0,
    Inverted = 1,
}

impl Default for PwmConfig {
    fn default() -> Self {
        PwmConfig {
            frequency: 1000,
            duty_cycle: 0,
            polarity: PwmPolarity::Normal,
        }
    }
}

struct Pwm {
    handle: u64,
    channel: u8,
    max_duty: u32,
}

impl Pwm {
    pub fn new(channel: u8, config: PwmConfig) -> Result<Self, HalError> {
        let config_json = pwm_config_to_json(&config);
        let handle = naso_hal_pwm_open(channel, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::PwmOpenFailed);
        }
        
        let max_duty = naso_hal_pwm_get_max_duty(handle) as u32;
        
        Ok(Pwm { handle, channel, max_duty })
    }
    
    pub fn set_duty(&mut self, duty: u32) -> Result<(), HalError> {
        if duty > self.max_duty {
            return Err(HalError::InvalidDutyCycle);
        }
        let result = naso_hal_pwm_set_duty(self.handle, duty);
        if result == 0 {
            return Err(HalError::PwmSetFailed);
        }
        Ok(())
    }
    
    pub fn set_duty_percent(&mut self, percent: f32) -> Result<(), HalError> {
        let duty = ((percent.clamp(0.0, 100.0) / 100.0) * self.max_duty as f32) as u32;
        self.set_duty(duty)
    }
    
    pub fn set_period(&mut self, period_us: u32) -> Result<(), HalError> {
        let result = naso_hal_pwm_set_period(self.handle, period_us);
        if result == 0 {
            return Err(HalError::PwmSetFailed);
        }
        Ok(())
    }
    
    pub fn set_frequency(&mut self, frequency: u32) -> Result<(), HalError> {
        let result = naso_hal_pwm_set_frequency(self.handle, frequency);
        if result == 0 {
            return Err(HalError::PwmSetFailed);
        }
        Ok(())
    }
    
    pub fn enable(&mut self) -> Result<(), HalError> {
        let result = naso_hal_pwm_enable(self.handle);
        if result == 0 {
            return Err(HalError::PwmEnableFailed);
        }
        Ok(())
    }
    
    pub fn disable(&mut self) -> Result<(), HalError> {
        let result = naso_hal_pwm_disable(self.handle);
        if result == 0 {
            return Err(HalError::PwmDisableFailed);
        }
        Ok(())
    }
    
    pub fn get_max_duty(&self) -> u32 {
        self.max_duty
    }
}

impl Drop for Pwm {
    fn drop(&mut self) {
        naso_hal_pwm_close(self.handle);
    }
}

fn pwm_config_to_json(config: &PwmConfig) -> String {
    format!(
        "{{\"frequency\":{},\"duty_cycle\":{},\"polarity\":{}}}",
        config.frequency,
        config.duty_cycle,
        config.polarity as u8
    )
}

// ============================================================================
// ADC
// ============================================================================

enum AdcReference {
    Internal = 0,
    External = 1,
    Vcc = 2,
}

struct AdcConfig {
    resolution_bits: u8,
    reference: AdcReference,
    sampling_time: u32, // ADC cycles
}

impl Default for AdcConfig {
    fn default() -> Self {
        AdcConfig {
            resolution_bits: 12,
            reference: AdcReference::Vcc,
            sampling_time: 15,
        }
    }
}

struct Adc {
    handle: u64,
    channel: u8,
    resolution_bits: u8,
    reference_voltage: f32, // V
}

impl Adc {
    pub fn new(channel: u8, config: AdcConfig) -> Result<Self, HalError> {
        let config_json = adc_config_to_json(&config);
        let handle = naso_hal_adc_open(channel, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::AdcOpenFailed);
        }
        
        let reference_voltage = match config.reference {
            AdcReference::Internal => 1.1,
            AdcReference::External => 3.3, // Would be configured
            AdcReference::Vcc => 3.3,
        };
        
        Ok(Adc {
            handle,
            channel,
            resolution_bits: config.resolution_bits,
            reference_voltage,
        })
    }
    
    pub fn read(&mut self) -> Result<u32, HalError> {
        let result = naso_hal_adc_read(self.handle);
        if result == u64::MAX {
            return Err(HalError::AdcReadFailed);
        }
        Ok(result as u32)
    }
    
    pub fn read_voltage(&mut self) -> Result<f32, HalError> {
        let result = naso_hal_adc_read_voltage(self.handle);
        if result == u64::MAX {
            return Err(HalError::AdcReadFailed);
        }
        // Result is in millivolts as u32
        Ok((result as u32) as f32 / 1000.0)
    }
    
    pub fn set_resolution(&mut self, bits: u8) -> Result<(), HalError> {
        if bits > 16 {
            return Err(HalError::InvalidResolution);
        }
        let result = naso_hal_adc_set_resolution(self.handle, bits);
        if result == 0 {
            return Err(HalError::AdcConfigFailed);
        }
        self.resolution_bits = bits;
        Ok(())
    }
    
    pub fn set_reference(&mut self, reference: AdcReference) -> Result<(), HalError> {
        let result = naso_hal_adc_set_reference(self.handle, reference as u8);
        if result == 0 {
            return Err(HalError::AdcConfigFailed);
        }
        self.reference_voltage = match reference {
            AdcReference::Internal => 1.1,
            AdcReference::External => 3.3,
            AdcReference::Vcc => 3.3,
        };
        Ok(())
    }
    
    pub fn enable_continuous(&mut self, callback: impl FnMut(u32) + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(callback));
        let result = naso_hal_adc_enable_continuous(self.handle, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn disable_continuous(&mut self) -> Result<(), HalError> {
        let result = naso_hal_adc_disable_continuous(self.handle);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn max_value(&self) -> u32 {
        (1u32 << self.resolution_bits) - 1
    }
}

impl Drop for Adc {
    fn drop(&mut self) {
        naso_hal_adc_close(self.handle);
    }
}

fn adc_config_to_json(config: &AdcConfig) -> String {
    format!(
        "{{\"resolution_bits\":{},\"reference\":{},\"sampling_time\":{}}}",
        config.resolution_bits,
        config.reference as u8,
        config.sampling_time
    )
}

// ============================================================================
// DMA
// ============================================================================

enum DmaDirection {
    PeripheralToMemory = 0,
    MemoryToPeripheral = 1,
    MemoryToMemory = 2,
}

enum DmaDataSize {
    Byte = 0,
    HalfWord = 1,
    Word = 2,
}

enum DmaPriority {
    Low = 0,
    Medium = 1,
    High = 2,
    VeryHigh = 3,
}

struct DmaConfig {
    direction: DmaDirection,
    peripheral_addr: u32,
    memory_increment: bool,
    peripheral_increment: bool,
    data_size: DmaDataSize,
    priority: DmaPriority,
    circular: bool,
}

struct Dma {
    handle: u64,
    channel: u8,
}

impl Dma {
    pub fn new(channel: u8, buffer_size: usize, alignment: usize) -> Result<Self, HalError> {
        let handle = naso_hal_dma_alloc(channel, buffer_size, alignment);
        if handle == 0 {
            return Err(HalError::DmaAllocFailed);
        }
        Ok(Dma { handle, channel })
    }
    
    pub fn start(&mut self, src: &[u8], dst: &mut [u8], config: DmaConfig) -> Result<(), HalError> {
        if src.len() != dst.len() {
            return Err(HalError::InvalidBufferSize);
        }
        let config_json = dma_config_to_json(&config);
        let result = naso_hal_dma_start(self.handle, src.as_ptr(), dst.as_mut_ptr(), src.len(), config_json.as_ptr(), config_json.len());
        if result == 0 {
            return Err(HalError::DmaStartFailed);
        }
        Ok(())
    }
    
    pub fn wait(&mut self, timeout_ms: u32) -> Result<bool, HalError> {
        let result = naso_hal_dma_wait(self.handle, timeout_ms);
        if result == u64::MAX {
            return Err(HalError::DmaWaitFailed);
        }
        Ok(result != 0)
    }
    
    pub fn abort(&mut self) -> Result<(), HalError> {
        let result = naso_hal_dma_abort(self.handle);
        if result == 0 {
            return Err(HalError::DmaAbortFailed);
        }
        Ok(())
    }
    
    pub fn set_callback(&mut self, callback: impl FnMut() + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(callback));
        let result = naso_hal_dma_set_callback(self.handle, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
}

impl Drop for Dma {
    fn drop(&mut self) {
        naso_hal_dma_free(self.handle);
    }
}

fn dma_config_to_json(config: &DmaConfig) -> String {
    format!(
        "{{\"direction\":{},\"peripheral_addr\":{},\"memory_increment\":{},\"peripheral_increment\":{},\"data_size\":{},\"priority\":{},\"circular\":{}}}",
        config.direction as u8,
        config.peripheral_addr,
        config.memory_increment as u8,
        config.peripheral_increment as u8,
        config.data_size as u8,
        config.priority as u8,
        config.circular as u8
    )
}

// ============================================================================
// Timer
// ============================================================================

enum TimerMode {
    OneShot = 0,
    Periodic = 1,
    Pwm = 2,
    Capture = 3,
}

struct TimerConfig {
    frequency_hz: u32,
    mode: TimerMode,
    auto_reload: bool,
}

impl Default for TimerConfig {
    fn default() -> Self {
        TimerConfig {
            frequency_hz: 1_000_000, // 1 MHz
            mode: TimerMode::Periodic,
            auto_reload: true,
        }
    }
}

struct Timer {
    handle: u64,
    timer_id: u8,
}

impl Timer {
    pub fn new(timer_id: u8, config: TimerConfig) -> Result<Self, HalError> {
        let config_json = timer_config_to_json(&config);
        let handle = naso_hal_timer_open(timer_id, config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::TimerOpenFailed);
        }
        Ok(Timer { handle, timer_id })
    }
    
    pub fn start(&mut self) -> Result<(), HalError> {
        let result = naso_hal_timer_start(self.handle);
        if result == 0 {
            return Err(HalError::TimerStartFailed);
        }
        Ok(())
    }
    
    pub fn stop(&mut self) -> Result<(), HalError> {
        let result = naso_hal_timer_stop(self.handle);
        if result == 0 {
            return Err(HalError::TimerStopFailed);
        }
        Ok(())
    }
    
    pub fn set_period_us(&mut self, period_us: u64) -> Result<(), HalError> {
        let result = naso_hal_timer_set_period(self.handle, period_us);
        if result == 0 {
            return Err(HalError::TimerConfigFailed);
        }
        Ok(())
    }
    
    pub fn get_counter(&mut self) -> Result<u64, HalError> {
        let result = naso_hal_timer_get_counter(self.handle);
        if result == u64::MAX {
            return Err(HalError::TimerReadFailed);
        }
        Ok(result)
    }
    
    pub fn set_callback(&mut self, callback: impl FnMut() + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(callback));
        let result = naso_hal_timer_set_callback(self.handle, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn enable_interrupt(&mut self) -> Result<(), HalError> {
        let result = naso_hal_timer_enable_interrupt(self.handle);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
    
    pub fn disable_interrupt(&mut self) -> Result<(), HalError> {
        let result = naso_hal_timer_disable_interrupt(self.handle);
        if result == 0 {
            return Err(HalError::InterruptSetupFailed);
        }
        Ok(())
    }
}

impl Drop for Timer {
    fn drop(&mut self) {
        naso_hal_timer_close(self.handle);
    }
}

fn timer_config_to_json(config: &TimerConfig) -> String {
    format!(
        "{{\"frequency_hz\":{},\"mode\":{},\"auto_reload\":{}}}",
        config.frequency_hz,
        config.mode as u8,
        config.auto_reload as u8
    )
}

