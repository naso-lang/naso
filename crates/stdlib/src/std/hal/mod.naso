    enable_in_debug: bool,
}

impl Default for WdtConfig {
    fn default() -> Self {
        WdtConfig {
            timeout_ms: 5000,
            window_ms: None,
            enable_in_sleep: true,
            enable_in_debug: false,
        }
    }
}

struct Watchdog {
    handle: u64,
}

impl Watchdog {
    pub fn new(config: WdtConfig) -> Result<Self, HalError> {
        let config_json = wdt_config_to_json(&config);
        let handle = naso_hal_wdt_open(config_json.as_ptr(), config_json.len());
        if handle == 0 {
            return Err(HalError::WdtOpenFailed);
        }
        Ok(Watchdog { handle })
    }
    
    pub fn feed(&mut self) -> Result<(), HalError> {
        let result = naso_hal_wdt_feed(self.handle);
        if result == 0 {
            return Err(HalError::WdtFeedFailed);
        }
        Ok(())
    }
    
    pub fn set_timeout(&mut self, timeout_ms: u32) -> Result<(), HalError> {
        let result = naso_hal_wdt_set_timeout(self.handle, timeout_ms);
        if result == 0 {
            return Err(HalError::WdtConfigFailed);
        }
        Ok(())
    }
    
    pub fn get_remaining(&mut self) -> Result<u32, HalError> {
        let result = naso_hal_wdt_get_remaining(self.handle);
        if result == u64::MAX {
            return Err(HalError::WdtReadFailed);
        }
        Ok(result as u32)
    }
}

impl Drop for Watchdog {
    fn drop(&mut self) {
        naso_hal_wdt_close(self.handle);
    }
}

fn wdt_config_to_json(config: &WdtConfig) -> String {
    format!(
        "{{\"timeout_ms\":{},\"window_ms\":{},\"enable_in_sleep\":{},\"enable_in_debug\":{}}}",
        config.timeout_ms,
        config.window_ms.map(|v| v.to_string()).unwrap_or("null".into()),
        config.enable_in_sleep as u8,
        config.enable_in_debug as u8
    )
}

// ============================================================================
// RTC
// ============================================================================

struct RtcTime {
    year: u16,
    month: u8,
    day: u8,
    hour: u8,
    minute: u8,
    second: u8,
    subsecond: u32,
}

impl RtcTime {
    pub fn new(year: u16, month: u8, day: u8, hour: u8, minute: u8, second: u8) -> Self {
        RtcTime {
            year, month, day, hour, minute, second, subsecond: 0
        }
    }
    
    pub fn now() -> Self {
        // Would use system time
        RtcTime { year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0, subsecond: 0 }
    }
}

struct Rtc {
    handle: u64,
}

impl Rtc {
    pub fn new() -> Result<Self, HalError> {
        let handle = naso_hal_rtc_open();
        if handle == 0 {
            return Err(HalError::RtcOpenFailed);
        }
        Ok(Rtc { handle })
    }
    
    pub fn get_time(&mut self) -> Result<RtcTime, HalError> {
        let mut result = vec![0u8; 64];
        let len = naso_hal_rtc_get_time(self.handle, result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::RtcReadFailed);
        }
        result.truncate(len as usize);
        parse_rtc_time(&result)
    }
    
    pub fn set_time(&mut self, time: &RtcTime) -> Result<(), HalError> {
        let time_json = rtc_time_to_json(time);
        let result = naso_hal_rtc_set_time(self.handle, time_json.as_ptr(), time_json.len());
        if result == 0 {
            return Err(HalError::RtcWriteFailed);
        }
        Ok(())
    }
    
    pub fn set_alarm(&mut self, time: &RtcTime, callback: impl FnMut() + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(callback));
        let time_json = rtc_time_to_json(time);
        let result = naso_hal_rtc_set_alarm(self.handle, time_json.as_ptr(), time_json.len(), cb_ptr);
        if result == 0 {
            return Err(HalError::RtcAlarmFailed);
        }
        Ok(())
    }
    
    pub fn disable_alarm(&mut self) -> Result<(), HalError> {
        let result = naso_hal_rtc_disable_alarm(self.handle);
        if result == 0 {
            return Err(HalError::RtcAlarmFailed);
        }
        Ok(())
    }
}

impl Drop for Rtc {
    fn drop(&mut self) {
        naso_hal_rtc_close(self.handle);
    }
}

fn rtc_time_to_json(time: &RtcTime) -> String {
    format!(
        "{{\"year\":{},\"month\":{},\"day\":{},\"hour\":{},\"minute\":{},\"second\":{},\"subsecond\":{}}}",
        time.year, time.month, time.day, time.hour, time.minute, time.second, time.subsecond
    )
}

fn parse_rtc_time(data: &[u8]) -> Result<RtcTime, HalError> {
    // Parse JSON
    Ok(RtcTime::now())
}

// ============================================================================
// Power Management
// ============================================================================

enum SleepMode {
    Idle = 0,
    Light = 1,
    Deep = 2,
    Standby = 3,
    Shutdown = 4,
}

enum WakeupSource {
    Timer = 0,
    Gpio = 1,
    Uart = 2,
    Rtc = 3,
    All = 4,
}

struct DeepSleepConfig {
    mode: SleepMode,
    wakeup_sources: Vec<WakeupSource>,
    gpio_wakeup_pin: Option<(u8, u8)>, // (port, pin)
    timer_duration_ms: Option<u32>,
}

struct PowerManager;

impl PowerManager {
    pub fn sleep(mode: SleepMode) -> Result<(), HalError> {
        let result = naso_hal_pm_sleep(mode as u8);
        if result == 0 {
            return Err(HalError::PmSleepFailed);
        }
        Ok(())
    }
    
    pub fn deep_sleep(config: DeepSleepConfig) -> Result<(), HalError> {
        let config_json = deep_sleep_config_to_json(&config);
        let result = naso_hal_pm_deep_sleep(config.mode as u8, config_json.as_ptr(), config_json.len());
        if result == 0 {
            return Err(HalError::PmDeepSleepFailed);
        }
        Ok(())
    }
    
    pub fn get_wakeup_reason() -> Result<WakeupReason, HalError> {
        let mut result = vec![0u8; 128];
        let len = naso_hal_pm_get_wakeup_reason(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::PmWakeupReasonFailed);
        }
        result.truncate(len as usize);
        parse_wakeup_reason(&result)
    }
}

enum WakeupReason {
    Unknown,
    Reset,
    Gpio(u8, u8), // port, pin
    Timer,
    Rtc,
    Uart,
    Watchdog,
    External,
}

fn deep_sleep_config_to_json(config: &DeepSleepConfig) -> String {
    let wakeup_str = config.wakeup_sources.iter().map(|s| s.to_string()).collect::<Vec<_>>().join(",");
    let gpio_str = config.gpio_wakeup_pin.map(|(p, pin)| format!("{}:{}", p, pin)).unwrap_or("none".into());
    let timer_str = config.timer_duration_ms.map(|t| t.to_string()).unwrap_or("none".into());
    format!(
        "{{\"wakeup_sources\":[{}],\"gpio_wakeup\":\"{}\",\"timer_duration_ms\":{}}}",
        wakeup_str, gpio_str, timer_str
    )
}

fn parse_wakeup_reason(data: &[u8]) -> Result<WakeupReason, HalError> {
    // Parse JSON
    Ok(WakeupReason::Unknown)
}

// ============================================================================
// Random Number Generation
// ============================================================================

struct HalRng;

impl HalRng {
    pub fn fill(buffer: &mut [u8]) -> Result<(), HalError> {
        let result = naso_hal_random_bytes(buffer.as_mut_ptr(), buffer.len());
        if result == 0 {
            return Err(HalError::RngFailed);
        }
        Ok(())
    }
    
    pub fn u32() -> u32 {
        naso_hal_random_u32() as u32
    }
    
    pub fn u64() -> u64 {
        naso_hal_random_u64()
    }
    
    pub fn u64_range(min: u64, max: u64) -> u64 {
        if min >= max { return min; }
        min + (Self::u64() % (max - min))
    }
}

// ============================================================================
// System Information
// ============================================================================

struct SystemInfo;

impl SystemInfo {
    pub fn chip_id() -> Result<String, HalError> {
        let mut result = vec![0u8; 64];
        let len = naso_hal_get_chip_id(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::SysInfoFailed);
        }
        result.truncate(len as usize);
        String::from_utf8(result).map_err(|_| HalError::InvalidUtf8)
    }
    
    pub fn chip_revision() -> u32 {
        naso_hal_get_chip_revision() as u32
    }
    
    pub fn flash_size() -> u32 {
        naso_hal_get_flash_size() as u32
    }
    
    pub fn ram_size() -> u32 {
        naso_hal_get_ram_size() as u32
    }
    
    pub fn cpu_frequency() -> u32 {
        naso_hal_get_cpu_frequency() as u32
    }
    
    pub fn unique_id() -> Result<Vec<u8>, HalError> {
        let mut result = vec![0u8; 32];
        let len = naso_hal_get_unique_id(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::SysInfoFailed);
        }
        result.truncate(len as usize);
        Ok(result)
    }
    
    pub fn reset_reason() -> Result<ResetReason, HalError> {
        let mut result = vec![0u8; 128];
        let len = naso_hal_get_reset_reason(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::SysInfoFailed);
        }
        result.truncate(len as usize);
        parse_reset_reason(&result)
    }
}

enum ResetReason {
    PowerOn,
    BrownOut,
    Watchdog,
    Software,
    External,
    Debug,
    Unknown,
}

fn parse_reset_reason(data: &[u8]) -> Result<ResetReason, HalError> {
    // Parse JSON
    Ok(ResetReason::Unknown)
}

// ============================================================================
// Interrupt Controller
// ============================================================================

struct InterruptController;

impl InterruptController {
    pub fn enable(irq: u32) -> Result<(), HalError> {
        let result = naso_hal_interrupt_enable(irq);
        if result == 0 {
            return Err(HalError::InterruptEnableFailed);
        }
        Ok(())
    }
    
    pub fn disable(irq: u32) -> Result<(), HalError> {
        let result = naso_hal_interrupt_disable(irq);
        if result == 0 {
            return Err(HalError::InterruptDisableFailed);
        }
        Ok(())
    }
    
    pub fn set_priority(irq: u32, priority: u8) -> Result<(), HalError> {
        let result = naso_hal_interrupt_set_priority(irq, priority);
        if result == 0 {
            return Err(HalError::InterruptConfigFailed);
        }
        Ok(())
    }
    
    pub fn set_handler(irq: u32, handler: impl FnMut() + Send + 'static) -> Result<(), HalError> {
        let cb_ptr = register_callback(Box::new(handler));
        let result = naso_hal_interrupt_set_handler(irq, cb_ptr);
        if result == 0 {
            return Err(HalError::InterruptConfigFailed);
        }
        Ok(())
    }
    
    pub fn is_pending(irq: u32) -> bool {
        naso_hal_interrupt_pending(irq) != 0
    }
}

// ============================================================================
// Board Support
// ============================================================================

struct BoardSupport;

impl BoardSupport {
    pub fn init() -> Result<(), HalError> {
        let result = naso_hal_board_init();
        if result == 0 {
            return Err(HalError::BoardInitFailed);
        }
        Ok(())
    }
    
    pub fn led_pins() -> Result<Vec<(u8, u8)>, HalError> {
        let mut result = vec![0u8; 64];
        let len = naso_hal_board_get_led_pins(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::BoardInfoFailed);
        }
        result.truncate(len as usize);
        parse_pin_list(&result)
    }
    
    pub fn button_pins() -> Result<Vec<(u8, u8)>, HalError> {
        let mut result = vec![0u8; 64];
        let len = naso_hal_board_get_button_pins(result.as_mut_ptr(), result.len());
        if len == u64::MAX {
            return Err(HalError::BoardInfoFailed);
        }
        result.truncate(len as usize);
        parse_pin_list(&result)
    }
}

fn parse_pin_list(data: &[u8]) -> Result<Vec<(u8, u8)>, HalError> {
    let mut pins = Vec::new();
    for i in (0..data.len()).step_by(2) {
        if i + 1 < data.len() {
            pins.push((data[i], data[i+1]));
        }
    }
    Ok(pins)
}

// ============================================================================
// Error Types
// ============================================================================

enum HalError {
    GpioOpenFailed,
    GpioReadFailed,
    GpioWriteFailed,
    GpioConfigFailed,
    I2cOpenFailed,
    I2cWriteFailed,
    I2cReadFailed,
    I2cWriteReadFailed,
    I2cScanFailed,
    I2cConfigFailed,
    SpiOpenFailed,
    SpiTransferFailed,
    SpiWriteFailed,
    SpiReadFailed,
    SpiConfigFailed,
    UartOpenFailed,
    UartWriteFailed,
    UartReadFailed,
    UartFlushFailed,
    UartConfigFailed,
    PwmOpenFailed,
    PwmSetFailed,
    PwmEnableFailed,
    PwmDisableFailed,
    AdcOpenFailed,
    AdcReadFailed,
    AdcConfigFailed,
    DmaAllocFailed,
    DmaStartFailed,
    DmaWaitFailed,
    DmaAbortFailed,
    TimerOpenFailed,
    TimerStartFailed,
    TimerStopFailed,
    TimerConfigFailed,
    TimerReadFailed,
    WdtOpenFailed,
    WdtFeedFailed,
    WdtConfigFailed,
    WdtReadFailed,
    RtcOpenFailed,
    RtcReadFailed,
    RtcWriteFailed,
    RtcAlarmFailed,
    PmSleepFailed,
    PmDeepSleepFailed,
    PmWakeupReasonFailed,
    RngFailed,
    SysInfoFailed,
    InterruptEnableFailed,
    InterruptDisableFailed,
    InterruptConfigFailed,
    InterruptSetupFailed,
    BoardInitFailed,
    BoardInfoFailed,
    InvalidBufferSize,
    InvalidDutyCycle,
    InvalidResolution,
    InvalidUtf8,
}

impl HalError {
    pub fn to_string(&self) -> String {
        match self {
            HalError::GpioOpenFailed => "Failed to open GPIO".into(),
            HalError::GpioReadFailed => "Failed to read GPIO".into(),
            HalError::GpioWriteFailed => "Failed to write GPIO".into(),
            HalError::GpioConfigFailed => "Failed to configure GPIO".into(),
            HalError::I2cOpenFailed => "Failed to open I2C".into(),
            HalError::I2cWriteFailed => "Failed to write I2C".into(),
            HalError::I2cReadFailed => "Failed to read I2C".into(),
            HalError::I2cWriteReadFailed => "Failed I2C write-read".into(),
            HalError::I2cScanFailed => "Failed to scan I2C".into(),
            HalError::I2cConfigFailed => "Failed to configure I2C".into(),
            HalError::SpiOpenFailed => "Failed to open SPI".into(),
            HalError::SpiTransferFailed => "Failed SPI transfer".into(),
            HalError::SpiWriteFailed => "Failed SPI write".into(),
            HalError::SpiReadFailed => "Failed SPI read".into(),
            HalError::SpiConfigFailed => "Failed to configure SPI".into(),
            HalError::UartOpenFailed => "Failed to open UART".into(),
            HalError::UartWriteFailed => "Failed UART write".into(),
            HalError::UartReadFailed => "Failed UART read".into(),
            HalError::UartFlushFailed => "Failed UART flush".into(),
            HalError::UartConfigFailed => "Failed to configure UART".into(),
            HalError::PwmOpenFailed => "Failed to open PWM".into(),
            HalError::PwmSetFailed => "Failed to set PWM".into(),
            HalError::PwmEnableFailed => "Failed to enable PWM".into(),
            HalError::PwmDisableFailed => "Failed to disable PWM".into(),
            HalError::AdcOpenFailed => "Failed to open ADC".into(),
            HalError::AdcReadFailed => "Failed to read ADC".into(),
            HalError::AdcConfigFailed => "Failed to configure ADC".into(),
            HalError::DmaAllocFailed => "Failed to allocate DMA".into(),
            HalError::DmaStartFailed => "Failed to start DMA".into(),
            HalError::DmaWaitFailed => "Failed to wait DMA".into(),
            HalError::DmaAbortFailed => "Failed to abort DMA".into(),
            HalError::TimerOpenFailed => "Failed to open timer".into(),
            HalError::TimerStartFailed => "Failed to start timer".into(),
            HalError::TimerStopFailed => "Failed to stop timer".into(),
            HalError::TimerConfigFailed => "Failed to configure timer".into(),
            HalError::TimerReadFailed => "Failed to read timer".into(),
            HalError::WdtOpenFailed => "Failed to open watchdog".into(),
            HalError::WdtFeedFailed => "Failed to feed watchdog".into(),
            HalError::WdtConfigFailed => "Failed to configure watchdog".into(),
            HalError::WdtReadFailed => "Failed to read watchdog".into(),
            HalError::RtcOpenFailed => "Failed to open RTC".into(),
            HalError::RtcReadFailed => "Failed to read RTC".into(),
            HalError::RtcWriteFailed => "Failed to write RTC".into(),
            HalError::RtcAlarmFailed => "Failed RTC alarm".into(),
            HalError::PmSleepFailed => "Failed to sleep".into(),
            HalError::PmDeepSleepFailed => "Failed deep sleep".into(),
            HalError::PmWakeupReasonFailed => "Failed to get wakeup reason".into(),
            HalError::RngFailed => "Failed RNG".into(),
            HalError::SysInfoFailed => "Failed system info".into(),
            HalError::InterruptEnableFailed => "Failed to enable interrupt".into(),
            HalError::InterruptDisableFailed => "Failed to disable interrupt".into(),
            HalError::InterruptConfigFailed => "Failed to configure interrupt".into(),
            HalError::InterruptSetupFailed => "Failed interrupt setup".into(),
            HalError::BoardInitFailed => "Failed board init".into(),
            HalError::BoardInfoFailed => "Failed board info".into(),
            HalError::InvalidBufferSize => "Invalid buffer size".into(),
            HalError::InvalidDutyCycle => "Invalid duty cycle".into(),
            HalError::InvalidResolution => "Invalid resolution".into(),
            HalError::InvalidUtf8 => "Invalid UTF-8".into(),
        }
    }
}

// ============================================================================
// Callback Registration (Runtime Support)
// ============================================================================

fn register_callback<F: FnMut() + Send + 'static>(callback: Box<F>) -> u64 {
    // Store callback in runtime registry, return handle
    // Implementation depends on async runtime
    0
}

fn register_callback_with_arg<F: FnMut(u8) + Send + 'static>(callback: Box<F>) -> u64 {
    0
}

fn register_callback_with_buffer<F: FnMut(&[u8]) + Send + 'static>(callback: Box<F>) -> u64 {
    0
}

// ============================================================================
// Embedded HAL Traits Compatibility
// ============================================================================

// These traits mirror the embedded-hal crate for compatibility

trait InputPin {
    fn is_high(&self) -> Result<bool, HalError>;
    fn is_low(&self) -> Result<bool, HalError>;
}

trait OutputPin {
    fn set_high(&mut self) -> Result<(), HalError>;
    fn set_low(&mut self) -> Result<(), HalError>;
    fn toggle(&mut self) -> Result<(), HalError>;
    fn is_set_high(&self) -> Result<bool, HalError>;
    fn is_set_low(&self) -> Result<bool, HalError>;
}

trait StatefulOutputPin: OutputPin {
    fn is_set_high(&self) -> Result<bool, HalError>;
    fn is_set_low(&self) -> Result<bool, HalError>;
}

trait ToggleableOutputPin {
    fn toggle(&mut self) -> Result<(), HalError>;
}

impl InputPin for GpioPin {
    fn is_high(&self) -> Result<bool, HalError> {
        self.read()
    }
    
    fn is_low(&self) -> Result<bool, HalError> {
        self.read().map(|v| !v)
    }
}

impl OutputPin for GpioPin {
    fn set_high(&mut self) -> Result<(), HalError> {
        self.write(true)
    }
    
    fn set_low(&mut self) -> Result<(), HalError> {
        self.write(false)
    }
    
    fn toggle(&mut self) -> Result<(), HalError> {
        self.toggle()
    }
    
    fn is_set_high(&self) -> Result<bool, HalError> {
        self.read()
    }
    
    fn is_set_low(&self) -> Result<bool, HalError> {
        self.read().map(|v| !v)
    }
}

// I2C traits
trait I2cWrite {
    fn write(&mut self, addr: u8, data: &[u8]) -> Result<(), HalError>;
    fn write_iter(&mut self, addr: u8, data: &mut dyn Iterator<Item = u8>) -> Result<(), HalError>;
}

trait I2cRead {
    fn read(&mut self, addr: u8, buffer: &mut [u8]) -> Result<(), HalError>;
    fn read_iter(&mut self, addr: u8, buffer: &mut dyn Iterator<Item = &mut u8>) -> Result<(), HalError>;
}

trait I2cWriteRead {
    fn write_read(&mut self, addr: u8, write: &[u8], read: &mut [u8]) -> Result<(), HalError>;
}

// SPI traits
trait SpiBus {
    fn transfer(&mut self, tx: &[u8], rx: &mut [u8]) -> Result<(), HalError>;
    fn write(&mut self, data: &[u8]) -> Result<(), HalError>;
    fn read(&mut self, buffer: &mut [u8]) -> Result<(), HalError>;
    fn transfer_iter(&mut self, tx: &mut dyn Iterator<Item = u8>, rx: &mut dyn Iterator<Item = &mut u8>) -> Result<(), HalError>;
}

// UART traits
trait UartRead {
    fn read(&mut self, buffer: &mut [u8]) -> Result<usize, HalError>;
}

trait UartWrite {
    fn write(&mut self, data: &[u8]) -> Result<usize, HalError>;
    fn flush(&mut self) -> Result<(), HalError>;
}

// ============================================================================
// HAL Initialization
// ============================================================================

fn hal_init() -> Result<(), HalError> {
    BoardSupport::init()
}

