fn hot_reloader() -> HotReloader {
    HotReloader::new()
}

fn rolling_update(reloader: Arc<Mutex<HotReloader>>) -> RollingUpdate {
    RollingUpdate::new(reloader)
}

// ============================================================================
// Integration with Async Runtime
// ============================================================================

struct HotReloadableService {
    reloader: Arc<Mutex<HotReloader>>,
    module_name: String,
    handler_name: String,
}

impl HotReloadableService {
    pub fn new(reloader: Arc<Mutex<HotReloader>>, module_name: &str, handler_name: &str) -> Self {
        HotReloadableService {
            reloader,
            module_name: module_name.into(),
            handler_name: handler_name.into(),
        }
    }

    pub fn handle_request(&self, request: Vec<u8>) -> Result<Vec<u8>, HotReloadError> {
        let reloader = self.reloader.lock().unwrap();
        reloader.call(&self.module_name, &self.handler_name, &request)
    }

    pub fn reload(&self, new_path: &str) -> Result<(), HotReloadError> {
        let mut reloader = self.reloader.lock().unwrap();
        reloader.reload_module(&self.module_name)
    }
}

// ============================================================================
// File Watcher for Auto-Reload
// ============================================================================

struct FileWatcher {
    paths: HashMap<String, std::time::SystemTime>,
    callback: Box<dyn Fn(&str) + Send + Sync>,
    interval_ms: u64,
    running: bool,
}

impl FileWatcher {
    pub fn new(callback: impl Fn(&str) + Send + Sync + 'static) -> Self {
        FileWatcher {
            paths: HashMap::new(),
            callback: Box::new(callback),
            interval_ms: 1000,
            running: false,
        }
    }

    pub fn watch(&mut self, path: &str) -> Result<(), HotReloadError> {
        let metadata = std::fs::metadata(path).map_err(|_| HotReloadError::DependencyMissing)?;
        self.paths.insert(path.into(), metadata.modified().map_err(|_| HotReloadError::DependencyMissing)?);
        Ok(())
    }

    pub fn interval(mut self, ms: u64) -> Self {
        self.interval_ms = ms;
        self
    }

    pub fn start(&mut self) {
        self.running = true;
        let paths = self.paths.clone();
        let callback = self.callback.clone();
        let interval = self.interval_ms;

        std::thread::spawn(move || {
            let mut last_modified = paths;
            while true {
                std::thread::sleep(std::time::Duration::from_millis(interval));
                for (path, last_time) in &mut last_modified {
                    if let Ok(metadata) = std::fs::metadata(path) {
                        if let Ok(modified) = metadata.modified() {
                            if modified > *last_time {
                                *last_time = modified;
                                callback(path);
                            }
                        }
                    }
                }
            }
        });
    }

    pub fn stop(&mut self) {
        self.running = false;
    }
}