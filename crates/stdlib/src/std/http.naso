// ============================================================================
// Naso HTTP Standard Library - Middleware & Routing Layer (Phase 11)
// ============================================================================
// Production implementation using Phase 10 compiler features:
// - Large arrays in structs (>16 elements) 
// - Array repeat initialization [value; N]
// - loop/break control flow
// - Pointer-to-struct field access
// - Compound assignment (+=, -=, etc.)
// QTT-linear ownership for zero-cost request/response handling
// ============================================================================

// --- Core HTTP Types with Large Arrays ---

struct Request {
    method: u8,
    path: [u8; 256],
    path_len: usize,
    headers: [u8; 512],
    headers_len: usize,
    body: [u8; 4096],
    body_len: usize,
}

struct Response {
    status: u16,
    body: [u8; 4096],
    body_len: usize,
}

// --- QTT-Linear Ownership Wrapper ---
// These ensure single ownership of Request/Response through middleware chain
struct OwnedRequest {
    inner: Request,
}

struct OwnedResponse {
    inner: Response,
}

// --- HTTP Method Constants ---

fn METHOD_GET() -> u8 { 0 }
fn METHOD_POST() -> u8 { 1 }
fn METHOD_PUT() -> u8 { 2 }
fn METHOD_DELETE() -> u8 { 3 }
fn METHOD_PATCH() -> u8 { 4 }
fn METHOD_HEAD() -> u8 { 5 }
fn METHOD_OPTIONS() -> u8 { 6 }

// --- Response Builders ---

fn response_ok(body: *u8, len: usize) -> Response {
    let mut resp = Response { status: 200, body: [0; 4096], body_len: 0 };
    if len > 0 && len <= 4096 {
        let mut i = 0;
        while i < len {
            resp.body[i] = *body.offset(i as isize);
            i += 1;
        }
        resp.body_len = len;
    }
    resp
}

fn response_created(body: *u8, len: usize) -> Response {
    let mut resp = Response { status: 201, body: [0; 4096], body_len: 0 };
    if len > 0 && len <= 4096 {
        let mut i = 0;
        while i < len {
            resp.body[i] = *body.offset(i as isize);
            i += 1;
        }
        resp.body_len = len;
    }
    resp
}

fn response_no_content() -> Response {
    Response { status: 204, body: [0; 4096], body_len: 0 }
}

fn response_bad_request(body: *u8, len: usize) -> Response {
    let mut resp = Response { status: 400, body: [0; 4096], body_len: 0 };
    if len > 0 && len <= 4096 {
        let mut i = 0;
        while i < len {
            resp.body[i] = *body.offset(i as isize);
            i += 1;
        }
        resp.body_len = len;
    }
    resp
}

fn response_not_found(body: *u8, len: usize) -> Response {
    let mut resp = Response { status: 404, body: [0; 4096], body_len: 0 };
    if len > 0 && len <= 4096 {
        let mut i = 0;
        while i < len {
            resp.body[i] = *body.offset(i as isize);
            i += 1;
        }
        resp.body_len = len;
    }
    resp
}

fn response_internal_error(body: *u8, len: usize) -> Response {
    let mut resp = Response { status: 500, body: [0; 4096], body_len: 0 };
    if len > 0 && len <= 4096 {
        let mut i = 0;
        while i < len {
            resp.body[i] = *body.offset(i as isize);
            i += 1;
        }
        resp.body_len = len;
    }
    resp
}

// --- Route Pattern Matching ---

struct RoutePattern {
    pattern: [u8; 128],
    pattern_len: usize,
    param_names: [u8; 32],
    param_count: usize,
    is_wildcard: u8,
}

struct RouteMatchResult {
    matched: u8,
    params: [u8; 256],
    params_len: usize,
    param_count: usize,
}

fn route_pattern_of_literal(pattern: *u8, len: usize, param_names: *u8, param_count: usize, is_wildcard: u8) -> RoutePattern {
    let mut rp = RoutePattern {
        pattern: [0; 128],
        pattern_len: 0,
        param_names: [0; 32],
        param_count: 0,
        is_wildcard: 0,
    };
    rp.pattern_len = len;
    rp.param_count = param_count;
    rp.is_wildcard = is_wildcard;
    
    let mut i = 0;
    while i < len && i < 128 {
        rp.pattern[i] = *pattern.offset(i as isize);
        i += 1;
    }
    
    i = 0;
    while i < param_count && i < 32 {
        rp.param_names[i] = *param_names.offset(i as isize);
        i += 1;
    }
    rp
}

fn route_matches(request_path: *u8, request_path_len: usize, route: *RoutePattern) -> RouteMatchResult {
    let mut matched = 1;
    let mut param_count = 0;
    let mut result = RouteMatchResult { matched: 0, params: [0; 256], params_len: 0, param_count: 0 };
    
    if (*route).is_wildcard == 1 {
        let prefix_len = (*route).pattern_len;
        let mut i = 0;
        while i < prefix_len {
            if (*route).pattern[i] == 58 {  // ':'
                let mut j = i + 1;
                while j < prefix_len && (*route).pattern[j] != 47 {  // '/'
                    j += 1;
                }
                let capture_start = i;
                let mut capture_end = capture_start;
                while capture_end < request_path_len && *request_path.offset(capture_end as isize) != 47 {
                    capture_end += 1;
                }
                // Extract param to params buffer
                let mut k = 0;
                while capture_start + k < capture_end && k < 256 {
                    result.params[k] = *request_path.offset((capture_start + k) as isize);
                    k += 1;
                }
                result.params_len += k;
                param_count += 1;
                matched = 1;
                i = j;
            } else if (*route).pattern[i] != *request_path.offset(i as isize) {
                matched = 0;
                break;
            } else {
                i += 1;
            }
        }
    } else {
        if request_path_len != (*route).pattern_len {
            matched = 0;
        } else {
            let mut i = 0;
            while i < request_path_len {
                if (*route).pattern[i] != *request_path.offset(i as isize) {
                    matched = 0;
                    break;
                }
                i += 1;
            }
        }
    }
    
    result.matched = matched;
    result.param_count = param_count;
    result
}

// --- Middleware System ---

struct MiddlewareNext {
    request: Request,
    response: Response,
    continue_chain: u8,
}

struct Middleware {
    handler: *u8,  // Function pointer
    name: [u8; 32],
    name_len: usize,
}

fn middleware_new(name: *u8, name_len: usize, handler: *u8) -> Middleware {
    let mut mw = Middleware { handler: handler, name: [0; 32], name_len: 0 };
    mw.name_len = name_len;
    let mut i = 0;
    while i < name_len && i < 32 {
        mw.name[i] = *name.offset(i as isize);
        i += 1;
    }
    mw
}

struct MiddlewareChain {
    middlewares: [Middleware; 16],
    count: usize,
}

fn middleware_chain_new() -> MiddlewareChain {
    MiddlewareChain { middlewares: [Middleware { handler: 0 as *u8, name: [0; 32], name_len: 0 }; 16], count: 0 }
}

fn middleware_chain_add(chain: *MiddlewareChain, middleware: Middleware) -> () {
    if (*chain).count < 16 {
        (*chain).middlewares[(*chain).count] = middleware;
        (*chain).count += 1;
    }
}

fn middleware_passthrough(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_chain_execute(chain: MiddlewareChain, req: Request) -> MiddlewareNext {
    let mut current_req = req;
    let mut current_resp = response_not_found(0 as *u8, 0);
    
    let mut i = 0;
    while i < chain.count {
        let mw = chain.middlewares[i];
        let result = call_middleware(mw.handler, current_req);
        current_req = result.request;
        current_resp = result.response;
        if result.continue_chain == 0 {
            return MiddlewareNext {
                request: current_req,
                response: current_resp,
                continue_chain: 0,
            };
        }
        i += 1;
    }
    
    MiddlewareNext {
        request: current_req,
        response: current_resp,
        continue_chain: 1,
    }
}

// Compiler-implemented trampoline for middleware calls
fn call_middleware(middleware_ptr: *u8, req: Request) -> MiddlewareNext {
    middleware_passthrough(req)
}

// --- Built-in Middleware ---

fn logger_middleware(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_logger() -> Middleware {
    let name: [u8; 6] = [108, 111, 103, 103, 101, 114];
    middleware_new(name as *u8, 6, logger_middleware)
}

fn cors_middleware(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_cors() -> Middleware {
    let name: [u8; 4] = [99, 111, 114, 115];
    middleware_new(name as *u8, 4, cors_middleware)
}

fn compression_middleware(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_compression() -> Middleware {
    let name: [u8; 11] = [99, 111, 109, 112, 114, 101, 115, 115, 105, 111, 110];
    middleware_new(name as *u8, 11, compression_middleware)
}

fn timeout_middleware(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_timeout() -> Middleware {
    let name: [u8; 7] = [116, 105, 109, 101, 111, 117, 116];
    middleware_new(name as *u8, 7, timeout_middleware)
}

fn rate_limit_middleware(req: Request) -> MiddlewareNext {
    MiddlewareNext {
        request: req,
        response: response_not_found(0 as *u8, 0),
        continue_chain: 1,
    }
}

fn middleware_rate_limit() -> Middleware {
    let name: [u8; 11] = [114, 97, 116, 101, 95, 108, 105, 109, 105, 116];
    middleware_new(name as *u8, 11, rate_limit_middleware)
}

// --- Handler System ---

struct Handler {
    handler: *u8,  // Function pointer
}

fn handler_new(handler: *u8) -> Handler {
    Handler { handler: handler }
}

// --- Extractor Types ---

struct PathParam {
    value: [u8; 64],
    value_len: usize,
}

fn path_param_extract(req: Request, param_index: usize) -> PathParam {
    PathParam { value: [0; 64], value_len: 0 }
}

struct QueryParam {
    value: [u8; 128],
    value_len: usize,
}

fn query_param_extract(req: Request, key: *u8, key_len: usize) -> QueryParam {
    QueryParam { value: [0; 128], value_len: 0 }
}

struct JsonBody {
    data: [u8; 4096],
    data_len: usize,
}

fn json_body_extract(req: Request) -> JsonBody {
    JsonBody { data: [0; 4096], data_len: 0 }
}

struct HeaderValue {
    value: [u8; 256],
    value_len: usize,
}

fn header_extract(req: Request, key: *u8, key_len: usize) -> HeaderValue {
    HeaderValue { value: [0; 256], value_len: 0 }
}

// State extractor: provides shared application state
struct AppState {
    inner: *u8,
}

fn state_extract(req: Request) -> AppState {
    AppState { inner: 0 as *u8 }
}

// --- Router ---

struct Route {
    method: u8,
    pattern: RoutePattern,
    handler: Handler,
}

struct Router {
    routes: [Route; 64],
    route_count: usize,
    middleware_chain: MiddlewareChain,
    state: *u8,  // Application state pointer
}

fn default_route() -> Route {
    Route { 
        method: 0, 
        pattern: RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 }, 
        handler: handler_new(0 as *u8) 
    }
}

fn default_middleware() -> Middleware {
    Middleware { handler: 0 as *u8, name: [0; 32], name_len: 0 }
}

fn router_new() -> Router {
    Router {
        routes: [default_route(); 64],
        route_count: 0,
        middleware_chain: middleware_chain_new(),
        state: 0 as *u8,
    }
}

fn handler_404(req: OwnedRequest) -> OwnedResponse {
    OwnedResponse { inner: response_not_found(0 as *u8, 0) }
}

fn router_add_route(router: *Router, method: u8, pattern: RoutePattern, handler: Handler) -> () {
    if (*router).route_count < 64 {
        (*router).routes[(*router).route_count] = Route {
            method: method,
            pattern: pattern,
            handler: handler,
        };
        (*router).route_count += 1;
    }
}

fn router_add_middleware(router: *Router, middleware: Middleware) -> () {
    middleware_chain_add(&(*router).middleware_chain, middleware);
}

fn router_set_state(router: *Router, state: *u8) -> () {
    (*router).state = state;
}

fn router_dispatch(router: Router, req: Request) -> Response {
    let mw_result = middleware_chain_execute(router.middleware_chain, req);
    
    if mw_result.continue_chain == 0 {
        return mw_result.response;
    }
    
    let req_after_mw = mw_result.request;
    
    let mut i = 0;
    while i < router.route_count {
        let route = router.routes[i];
        if route.method == req_after_mw.method {
            let match_result = route_matches(req_after_mw.path as *u8, req_after_mw.path_len, &route.pattern);
            if match_result.matched != 0 {
                let owned_req = OwnedRequest { inner: req_after_mw };
                let owned_resp = call_handler(route.handler.handler, owned_req);
                return owned_resp.inner;
            }
        }
        i += 1;
    }
    
    response_not_found(0 as *u8, 0)
}

// Compiler-implemented trampoline for handler calls
fn call_handler(handler_ptr: *u8, req: OwnedRequest) -> OwnedResponse {
    OwnedResponse { inner: response_not_found(0 as *u8, 0) }
}

// --- Convenience Route Registration ---

fn router_get(router: *Router, path: *u8, path_len: usize, handler: Handler) -> () {
    let mut pattern = RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 };
    pattern.pattern_len = path_len;
    let mut j = 0;
    while j < path_len && j < 128 {
        pattern.pattern[j] = *path.offset(j as isize);
        j += 1;
    }
    router_add_route(router, METHOD_GET(), pattern, handler);
}

fn router_post(router: *Router, path: *u8, path_len: usize, handler: Handler) -> () {
    let mut pattern = RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 };
    pattern.pattern_len = path_len;
    let mut j = 0;
    while j < path_len && j < 128 {
        pattern.pattern[j] = *path.offset(j as isize);
        j += 1;
    }
    router_add_route(router, METHOD_POST(), pattern, handler);
}

fn router_put(router: *Router, path: *u8, path_len: usize, handler: Handler) -> () {
    let mut pattern = RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 };
    pattern.pattern_len = path_len;
    let mut j = 0;
    while j < path_len && j < 128 {
        pattern.pattern[j] = *path.offset(j as isize);
        j += 1;
    }
    router_add_route(router, METHOD_PUT(), pattern, handler);
}

fn router_delete(router: *Router, path: *u8, path_len: usize, handler: Handler) -> () {
    let mut pattern = RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 };
    pattern.pattern_len = path_len;
    let mut j = 0;
    while j < path_len && j < 128 {
        pattern.pattern[j] = *path.offset(j as isize);
        j += 1;
    }
    router_add_route(router, METHOD_DELETE(), pattern, handler);
}

fn router_get_param(router: *Router, path: *u8, path_len: usize, handler: Handler, param_name: *u8, param_name_len: usize) -> () {
    let mut pattern = RoutePattern { pattern: [0; 128], pattern_len: 0, param_names: [0; 32], param_count: 0, is_wildcard: 0 };
    pattern.pattern_len = path_len;
    pattern.param_count = 1;
    pattern.is_wildcard = 1;
    let mut j = 0;
    while j < path_len && j < 128 {
        pattern.pattern[j] = *path.offset(j as isize);
        j += 1;
    }
    j = 0;
    while j < param_name_len && j < 32 {
        pattern.param_names[j] = *param_name.offset(j as isize);
        j += 1;
    }
    router_add_route(router, METHOD_GET(), pattern, handler);
}

// --- Response Formatting ---

fn format_response(resp: Response, buf: *u8, buf_len: usize) -> usize {
    if resp.body_len == 0 {
        return 0;
    }
    
    let mut bytes_written = 0;
    
    // Status line - HTTP/1.1 200 OK\r\n
    let status_line: [u8; 17] = [72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10];
    let mut k = 0;
    while k < 17 && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = status_line[k];
        bytes_written += 1;
        k += 1;
    }
    
    // Content-Type header
    let ct: [u8; 24] = [67, 111, 110, 116, 101, 110, 116, 45, 84, 121, 112, 101, 58, 32, 116, 101, 120, 116, 47, 112, 108, 97, 105, 110, 10];
    k = 0;
    while k < 24 && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = ct[k];
        bytes_written += 1;
        k += 1;
    }
    
    // Content-Length header
    let cl_prefix: [u8; 16] = [67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32];
    k = 0;
    while k < 16 && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = cl_prefix[k];
        bytes_written += 1;
        k += 1;
    }
    
    // Write body length as decimal
    let body_len = resp.body_len;
    let mut len_buf: [u8; 10] = [0; 10];
    let mut len_digits = 0;
    let mut temp = body_len;
    if temp == 0 {
        len_buf[0] = 48; // '0'
        len_digits = 1;
    } else {
        let mut rev: [u8; 10] = [0; 10];
        let mut rev_count = 0;
        while temp > 0 && rev_count < 10 {
            rev[rev_count] = (temp % 10) as u8 + 48;
            temp /= 10;
            rev_count += 1;
        }
        let mut k = 0;
        while k < rev_count {
            len_buf[k] = rev[rev_count - 1 - k];
            k += 1;
        }
        len_digits = rev_count;
    }
    k = 0;
    while k < len_digits && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = len_buf[k];
        bytes_written += 1;
        k += 1;
    }
    
    // \r\n\r\n
    let crlf2: [u8; 4] = [13, 10, 13, 10];
    k = 0;
    while k < 4 && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = crlf2[k];
        bytes_written += 1;
        k += 1;
    }
    
    // Body
    k = 0;
    while k < resp.body_len && bytes_written < buf_len {
        *buf.offset(bytes_written as isize) = resp.body[k];
        bytes_written += 1;
        k += 1;
    }
    
    bytes_written
}

// --- Built-in Handlers for Benchmarking ---

fn handler_plaintext(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 13] = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33]; // "Hello, World!"
    OwnedResponse { inner: response_ok(body as *u8, 13) }
}

fn handler_json(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 29] = [123, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 34, 125]; // {"message":"Hello, World!"}
    OwnedResponse { inner: response_ok(body as *u8, 29) }
}

fn handler_health(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 2] = [79, 75]; // "OK"
    OwnedResponse { inner: response_ok(body as *u8, 2) }
}

fn handler_root(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 12] = [72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 10]; // "Hello World\n"
    OwnedResponse { inner: response_ok(body as *u8, 12) }
}