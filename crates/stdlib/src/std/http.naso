// --- Handler System ---

struct Handler {
    handler: *u8,  // Function pointer
}

fn handler_new(handler: *u8) -> Handler {
    Handler { handler: handler }
}

// --- Extractor Types ---

struct PathParam {
    value: *u8,
    value_len: Int,
}

fn path_param_extract(req: Request, param_index: Int) -> PathParam {
    PathParam { value: 0 as *u8, value_len: 0 }
}

struct QueryParam {
    value: *u8,
    value_len: Int,
}

fn query_param_extract(req: Request, key: *u8, key_len: Int) -> QueryParam {
    QueryParam { value: 0 as *u8, value_len: 0 }
}

struct JsonBody {
    data: *u8,
    data_len: Int,
}

fn json_body_extract(req: Request) -> JsonBody {
    JsonBody { data: 0 as *u8, data_len: 0 }
}

struct HeaderValue {
    value: *u8,
    value_len: Int,
}

fn header_extract(req: Request, key: *u8, key_len: Int) -> HeaderValue {
    HeaderValue { value: 0 as *u8, value_len: 0 }
}

// State extractor: provides shared application state
struct AppState {
    inner: *u8,
}

fn state_extract(req: Request) -> AppState {
    AppState { inner: 0 as *u8 }
}

// --- Router ---

struct Route {
    method: Int,
    pattern: RoutePattern,
    handler: Handler,
}

struct Router {
    routes: [Route; 64],
    route_count: Int,
    middleware_chain: MiddlewareChain,
    state: *u8,  // Application state pointer
}

fn default_route() -> Route {
    Route { method: 0, pattern: RoutePattern { pattern: 0 as *u8, pattern_len: 0, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 }, handler: handler_new(0 as *u8) }
}

fn default_middleware() -> Middleware {
    Middleware { handler: 0 as *u8, name: 0 as *u8, name_len: 0 }
}

fn router_new() -> Router {
    Router {
        routes: [default_route(); 64],
        route_count: 0,
        middleware_chain: middleware_chain_new(),
        state: 0 as *u8,
    }
}

fn handler_404(req: OwnedRequest) -> OwnedResponse {
    OwnedResponse { inner: response_not_found(0 as *u8, 0) }
}

fn router_add_route(router: *Router, method: Int, pattern: RoutePattern, handler: Handler) -> () {
    if router.route_count < 64 {
        router.routes[router.route_count] = Route {
            method: method,
            pattern: pattern,
            handler: handler,
        };
        router.route_count += 1;
    }
}

fn router_add_middleware(router: *Router, middleware: Middleware) -> () {
    middleware_chain_add(&router.middleware_chain, middleware);
}

fn router_set_state(router: *Router, state: *u8) -> () {
    router.state = state;
}

fn router_dispatch(router: Router, req: Request) -> Response {
    let mw_result = middleware_chain_execute(router.middleware_chain, req);
    
    if mw_result.continue_chain == 0 {
        return mw_result.response;
    }
    
    let req_after_mw = mw_result.request;
    
    for i in 0..router.route_count {
        // In real implementation, would read from routes pointer
        let route = Route { method: 0, pattern: RoutePattern { pattern: 0 as *u8, pattern_len: 0, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 }, handler: handler_new(0 as *u8) };
        if route.method == req_after_mw.method {
            let match_result = route_matches(req_after_mw.path, req_after_mw.path_len, &route.pattern);
            if match_result.matched != 0 {
                let owned_req = OwnedRequest { inner: req_after_mw };
                let owned_resp = call_handler(route.handler.handler, owned_req);
                return owned_resp.inner;
            }
        }
    }
    
    response_not_found(0 as *u8, 0)
}

// Compiler-implemented trampoline for handler calls
fn call_handler(handler_ptr: *u8, req: OwnedRequest) -> OwnedResponse {
    OwnedResponse { inner: response_not_found(0 as *u8, 0) }
}

// --- Convenience Route Registration ---

fn router_get(router: *Router, path: *u8, path_len: Int, handler: Handler) -> () {
    let pattern = RoutePattern { pattern: path, pattern_len: path_len, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 };
    router_add_route(router, METHOD_GET(), pattern, handler);
}

fn router_post(router: *Router, path: *u8, path_len: Int, handler: Handler) -> () {
    let pattern = RoutePattern { pattern: path, pattern_len: path_len, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 };
    router_add_route(router, METHOD_POST(), pattern, handler);
}

fn router_put(router: *Router, path: *u8, path_len: Int, handler: Handler) -> () {
    let pattern = RoutePattern { pattern: path, pattern_len: path_len, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 };
    router_add_route(router, METHOD_PUT(), pattern, handler);
}

fn router_delete(router: *Router, path: *u8, path_len: Int, handler: Handler) -> () {
    let pattern = RoutePattern { pattern: path, pattern_len: path_len, param_names: 0 as *u8, param_count: 0, is_wildcard: 0 };
    router_add_route(router, METHOD_DELETE(), pattern, handler);
}

fn router_get_param(router: *Router, path: *u8, path_len: Int, handler: Handler, param_name: *u8, param_name_len: Int) -> () {
    let pattern = RoutePattern { pattern: path, pattern_len: path_len, param_names: param_name, param_count: 1, is_wildcard: 1 };
    router_add_route(router, METHOD_GET(), pattern, handler);
}

// --- Response Formatting ---

fn format_response(resp: Response, buf: *u8, buf_len: usize) -> usize {
    if resp.body == 0 as *u8 || resp.body_len == 0 {
        return 0;
    }
    
    let mut bytes_written = 0;
    
    let status_line = match resp.status {
        200 => "HTTP/1.1 200 OK\r\n",
        201 => "HTTP/1.1 201 Created\r\n",
        204 => "HTTP/1.1 204 No Content\r\n",
        400 => "HTTP/1.1 400 Bad Request\r\n",
        404 => "HTTP/1.1 404 Not Found\r\n",
        500 => "HTTP/1.1 500 Internal Server Error\r\n",
        _ => "HTTP/1.1 200 OK\r\n",
    };
    
    for i in 0..(status_line.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = status_line.as_bytes()[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    let headers = "Content-Type: text/plain\r\n";
    for i in 0..(headers.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = headers.as_bytes()[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    let cl_str = "Content-Length: ";
    for i in 0..(cl_str.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = cl_str.as_bytes()[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    for i in 0..resp.body_len {
        if bytes_written < buf_len {
            buf[bytes_written] = resp.body[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    bytes_written
}

// --- Built-in Handlers for Benchmarking ---

fn handler_plaintext(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 13] = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33];
    OwnedResponse { inner: response_ok(body as *u8, 13) }
}

fn handler_json(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 29] = [123, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 34, 125];
    OwnedResponse { inner: response_ok(body as *u8, 29) }
}

fn handler_health(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 2] = [79, 75];
    OwnedResponse { inner: response_ok(body as *u8, 2) }
}

fn handler_root(req: OwnedRequest) -> OwnedResponse {
    let body: [u8; 12] = [72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 10];
    OwnedResponse { inner: response_ok(body as *u8, 12) }
}
