// ============================================================================
// Naso Metrics (naso_metrics) - Phase 19.6
// ============================================================================
// High-performance metrics collection with Prometheus, OpenTelemetry,
// and custom exporters support
// ============================================================================

extern "C" {
    fn naso_metrics_registry_new() -> u64;
    fn naso_metrics_counter_new(registry: u64, name_ptr: *const u8, name_len: usize, help_ptr: *const u8, help_len: usize, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_new(registry: u64, name_ptr: *const u8, name_len: usize, help_ptr: *const u8, help_len: usize, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_histogram_new(registry: u64, name_ptr: *const u8, name_len: usize, help_ptr: *const u8, help_len: usize, labels_ptr: *const u8, labels_len: usize, buckets_ptr: *const f64, buckets_len: usize) -> u64;
    fn naso_metrics_summary_new(registry: u64, name_ptr: *const u8, name_len: usize, help_ptr: *const u8, help_len: usize, labels_ptr: *const u8, labels_len: usize, quantiles_ptr: *const f64, quantiles_len: usize) -> u64;
    fn naso_metrics_counter_inc(counter: u64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_counter_add(counter: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_set(gauge: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_inc(gauge: u64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_dec(gauge: u64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_add(gauge: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_gauge_sub(gauge: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_histogram_observe(histogram: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_summary_observe(summary: u64, value: f64, labels_ptr: *const u8, labels_len: usize) -> u64;
    fn naso_metrics_registry_gather(registry: u64, out_ptr: *mut u8, out_max_len: usize) -> u64;
    fn naso_metrics_registry_free(registry: u64);
    fn naso_metrics_exporter_prometheus_new(registry: u64, path: *const u8, path_len: usize) -> u64;
    fn naso_metrics_exporter_otlp_new(registry: u64, endpoint: *const u8, endpoint_len: usize) -> u64;
    fn naso_metrics_exporter_free(exporter: u64);
}

// ============================================================================
// Metrics Registry
// ============================================================================

struct MetricsRegistry {
    inner: u64,
    counters: HashMap<String, Counter>,
    gauges: HashMap<String, Gauge>,
    histograms: HashMap<String, Histogram>,
    summaries: HashMap<String, Summary>,
}

impl MetricsRegistry {
    pub fn new() -> Result<Self, MetricsError> {
        let inner = naso_metrics_registry_new();
        if inner == 0 {
            return Err(MetricsError::RegistryCreationFailed);
        }
        Ok(MetricsRegistry {
            inner,
            counters: HashMap::new(),
            gauges: HashMap::new(),
            histograms: HashMap::new(),
            summaries: HashMap::new(),
        })
    }
    
    pub fn register_counter(&mut self, name: &str, help: &str, labels: &[(&str, &str)]) -> Result<Counter, MetricsError> {
        let labels_json = labels_to_json(labels);
        let counter = naso_metrics_counter_new(
            self.inner,
            name.as_ptr(), name.len(),
            help.as_ptr(), help.len(),
            labels_json.as_ptr(), labels_json.len(),
        );
        if counter == 0 {
            return Err(MetricsError::CounterCreationFailed);
        }
        let c = Counter { inner: counter, name: name.into() };
        self.counters.insert(name.into(), c.clone());
        Ok(c)
    }
    
    pub fn register_gauge(&mut self, name: &str, help: &str, labels: &[(&str, &str)]) -> Result<Gauge, MetricsError> {
        let labels_json = labels_to_json(labels);
        let gauge = naso_metrics_gauge_new(
            self.inner,
            name.as_ptr(), name.len(),
            help.as_ptr(), help.len(),
            labels_json.as_ptr(), labels_json.len(),
        );
        if gauge == 0 {
            return Err(MetricsError::GaugeCreationFailed);
        }
        let g = Gauge { inner: gauge, name: name.into() };
        self.gauges.insert(name.into(), g.clone());
        Ok(g)
    }
    
    pub fn register_histogram(&mut self, name: &str, help: &str, labels: &[(&str, &str)], buckets: &[f64]) -> Result<Histogram, MetricsError> {
        let labels_json = labels_to_json(labels);
        let histogram = naso_metrics_histogram_new(
            self.inner,
            name.as_ptr(), name.len(),
            help.as_ptr(), help.len(),
            labels_json.as_ptr(), labels_json.len(),
            buckets.as_ptr(), buckets.len(),
        );
        if histogram == 0 {
            return Err(MetricsError::HistogramCreationFailed);
        }
        let h = Histogram { inner: histogram, name: name.into() };
        self.histograms.insert(name.into(), h.clone());
        Ok(h)
    }
    
    pub fn register_summary(&mut self, name: &str, help: &str, labels: &[(&str, &str)], quantiles: &[f64]) -> Result<Summary, MetricsError> {
        let labels_json = labels_to_json(labels);
        let summary = naso_metrics_summary_new(
            self.inner,
            name.as_ptr(), name.len(),
            help.as_ptr(), help.len(),
            labels_json.as_ptr(), labels_json.len(),
            quantiles.as_ptr(), quantiles.len(),
        );
        if summary == 0 {
            return Err(MetricsError::SummaryCreationFailed);
        }
        let s = Summary { inner: summary, name: name.into() };
        self.summaries.insert(name.into(), s.clone());
        Ok(s)
    }
    
    pub fn gather(&self) -> Result<String, MetricsError> {
        let mut out = vec![0u8; 65536];
        let len = naso_metrics_registry_gather(self.inner, out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(MetricsError::GatherFailed);
        }
        out.truncate(len as usize);
        String::from_utf8(out).map_err(|_| MetricsError::InvalidUtf8)
    }
    
    pub fn prometheus_exporter(&self, path: &str) -> Result<MetricsExporter, MetricsError> {
        let exporter = naso_metrics_exporter_prometheus_new(self.inner, path.as_ptr(), path.len());
        if exporter == 0 {
            return Err(MetricsError::ExporterCreationFailed);
        }
        Ok(MetricsExporter { inner: exporter, exporter_type: ExporterType::Prometheus })
    }
    
    pub fn otlp_exporter(&self, endpoint: &str) -> Result<MetricsExporter, MetricsError> {
        let exporter = naso_metrics_exporter_otlp_new(self.inner, endpoint.as_ptr(), endpoint.len());
        if exporter == 0 {
            return Err(MetricsError::ExporterCreationFailed);
        }
        Ok(MetricsExporter { inner: exporter, exporter_type: ExporterType::Otlp })
    }
}

impl Drop for MetricsRegistry {
    fn drop(&mut self) {
        naso_metrics_registry_free(self.inner);
    }
}

fn labels_to_json(labels: &[(&str, &str)]) -> String {
    let mut json = String::from("{");
    for (i, (k, v)) in labels.iter().enumerate() {
        if i > 0 {
            json.push(',');
        }
        json.push_str(&format!("\"{}\":\"{}\"", k, v));
    }
    json.push('}');
    json
}

// ============================================================================
// Counter
// ============================================================================

struct Counter {
    inner: u64,
    name: String,
}

impl Counter {
    pub fn inc(&self, labels: &[(&str, &str)]) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(labels);
        let result = naso_metrics_counter_inc(self.inner, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
    
    pub fn add(&self, value: f64, labels: &[(&str, &str)]) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(labels);
        let result = naso_metrics_counter_add(self.inner, value, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
    
    pub fn with_labels(&self, labels: &[(&str, &str)]) -> LabeledCounter {
        LabeledCounter {
            counter: self.inner,
            labels: labels.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),
        }
    }
}

struct LabeledCounter {
    counter: u64,
    labels: Vec<(String, String)>,
}

impl LabeledCounter {
    pub fn inc(&self) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(&self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>());
        let result = naso_metrics_counter_inc(self.counter, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
    
    pub fn add(&self, value: f64) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(&self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>());
        let result = naso_metrics_counter_add(self.counter, value, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
}

