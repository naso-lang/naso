        let result = naso_metrics_gauge_dec(self.gauge, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
    
    pub fn add(&self, value: f64) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(&self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>());
        let result = naso_metrics_gauge_add(self.gauge, value, labels_json.as_ptr(), labels_json.len());
        if result == 0 {
            return Err(MetricsError::IncrementFailed);
        }
        Ok(())
    }
    
    pub fn sub(&self, value: f64) -> Result<(), MetricsError> {
        let labels_json = labels_to_json(&self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>());
        let result = naso_metrics_gauge_sub(self.gauge, value, labels_json.as_ptr(), labels_json.len());
