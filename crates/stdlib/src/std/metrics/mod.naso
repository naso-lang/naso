// ============================================================================
// Standard Metrics (RED, USE)
// ============================================================================

// RED: Rate, Errors, Duration
struct RedMetrics {
    requests_total: Counter,
    requests_duration: Histogram,
    errors_total: Counter,
}

impl RedMetrics {
    pub fn new(registry: &mut MetricsRegistry, subsystem: &str) -> Result<Self, MetricsError> {
        let requests_total = registry.register_counter(
            &format!("{}_requests_total", subsystem),
            "Total number of requests",
            &[("method", ""), ("endpoint", ""), ("status", "")],
        )?;
        
        let requests_duration = registry.register_histogram(
            &format!("{}_request_duration_seconds", subsystem),
            "Request duration in seconds",
            &[("method", ""), ("endpoint", "")],
            &[0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0],
        )?;
        
        let errors_total = registry.register_counter(
            &format!("{}_errors_total", subsystem),
            "Total number of errors",
            &[("method", ""), ("endpoint", ""), ("error_type", "")],
        )?;
        
        Ok(RedMetrics {
            requests_total,
            requests_duration,
            errors_total,
        })
    }
    
    pub fn record_request(&self, method: &str, endpoint: &str, status: u16, duration_secs: f64) -> Result<(), MetricsError> {
        self.requests_total.inc(&[("method", method), ("endpoint", endpoint), ("status", &status.to_string())])?;
        self.requests_duration.observe(duration_secs, &[("method", method), ("endpoint", endpoint)])?;
        
        if status >= 400 {
            let error_type = if status >= 500 { "server_error" } else { "client_error" };
            self.errors_total.inc(&[("method", method), ("endpoint", endpoint), ("error_type", error_type)])?;
        }
        
        Ok(())
    }
}

// USE: Utilization, Saturation, Errors
struct UseMetrics {
    utilization: Gauge,
    saturation: Gauge,
    errors: Counter,
}

impl UseMetrics {
    pub fn new(registry: &mut MetricsRegistry, resource: &str) -> Result<Self, MetricsError> {
        let utilization = registry.register_gauge(
            &format!("{}_utilization", resource),
            "Resource utilization (0-1)",
            &[],
        )?;
        
        let saturation = registry.register_gauge(
            &format!("{}_saturation", resource),
            "Resource saturation (queue length, etc.)",
            &[],
        )?;
        
        let errors = registry.register_counter(
            &format!("{}_errors_total", resource),
            "Total number of resource errors",
            &[("error_type", "")],
        )?;
        
        Ok(UseMetrics {
            utilization,
            saturation,
            errors,
        })
    }
}

// ============================================================================
// Common Metric Builders
// ============================================================================

struct CounterBuilder {
    registry: Option<&'static mut MetricsRegistry>, // Simplified
    name: String,
    help: String,
    labels: Vec<(String, String)>,
}

impl CounterBuilder {
    pub fn new(name: &str) -> Self {
        CounterBuilder {
            registry: None,
            name: name.into(),
            help: String::new(),
            labels: Vec::new(),
        }
    }
    
    pub fn help(mut self, help: &str) -> Self {
        self.help = help.into();
        self
    }
    
    pub fn label(mut self, key: &str, value: &str) -> Self {
        self.labels.push((key.into(), value.into()));
        self
    }
    
    pub fn register(self, registry: &mut MetricsRegistry) -> Result<Counter, MetricsError> {
        registry.register_counter(&self.name, &self.help, &self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>())
    }
}

struct GaugeBuilder {
    registry: Option<&'static mut MetricsRegistry>,
    name: String,
    help: String,
    labels: Vec<(String, String)>,
}

impl GaugeBuilder {
    pub fn new(name: &str) -> Self {
        GaugeBuilder {
            registry: None,
            name: name.into(),
            help: String::new(),
            labels: Vec::new(),
        }
    }
    
    pub fn help(mut self, help: &str) -> Self {
        self.help = help.into();
        self
    }
    
    pub fn label(mut self, key: &str, value: &str) -> Self {
        self.labels.push((key.into(), value.into()));
        self
    }
    
    pub fn register(self, registry: &mut MetricsRegistry) -> Result<Gauge, MetricsError> {
        registry.register_gauge(&self.name, &self.help, &self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>())
    }
}

struct HistogramBuilder {
    registry: Option<&'static mut MetricsRegistry>,
    name: String,
    help: String,
    labels: Vec<(String, String)>,
    buckets: Vec<f64>,
}

impl HistogramBuilder {
    pub fn new(name: &str) -> Self {
        HistogramBuilder {
            registry: None,
            name: name.into(),
            help: String::new(),
            labels: Vec::new(),
            buckets: vec![0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0],
        }
    }
    
    pub fn help(mut self, help: &str) -> Self {
        self.help = help.into();
        self
    }
    
    pub fn label(mut self, key: &str, value: &str) -> Self {
        self.labels.push((key.into(), value.into()));
        self
    }
    
    pub fn buckets(mut self, buckets: &[f64]) -> Self {
        self.buckets = buckets.into();
        self
    }
    
    pub fn exponential_buckets(mut self, start: f64, factor: f64, count: usize) -> Self {
        self.buckets = (0..count).map(|i| start * factor.powi(i as i32)).collect();
        self
    }
    
    pub fn linear_buckets(mut self, start: f64, width: f64, count: usize) -> Self {
        self.buckets = (0..count).map(|i| start + width * i as f64).collect();
        self
    }
    
    pub fn register(self, registry: &mut MetricsRegistry) -> Result<Histogram, MetricsError> {
        registry.register_histogram(&self.name, &self.help, &self.labels.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect::<Vec<_>>(), &self.buckets)
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum MetricsError {
    RegistryCreationFailed,
    CounterCreationFailed,
    GaugeCreationFailed,
    HistogramCreationFailed,
    SummaryCreationFailed,
    IncrementFailed,
    SetFailed,
    ObserveFailed,
    GatherFailed,
    ExporterCreationFailed,
    InvalidUtf8,
    InvalidLabel,
    DuplicateMetric,
    MetricNotFound,
    IoError(IoError),
}

impl MetricsError {
    pub fn to_string(&self) -> String {
        match self {
            MetricsError::RegistryCreationFailed => "Failed to create metrics registry".into(),
            MetricsError::CounterCreationFailed => "Failed to create counter".into(),
            MetricsError::GaugeCreationFailed => "Failed to create gauge".into(),
            MetricsError::HistogramCreationFailed => "Failed to create histogram".into(),
            MetricsError::SummaryCreationFailed => "Failed to create summary".into(),
            MetricsError::IncrementFailed => "Failed to increment metric".into(),
            MetricsError::SetFailed => "Failed to set metric".into(),
            MetricsError::ObserveFailed => "Failed to observe metric".into(),
            MetricsError::GatherFailed => "Failed to gather metrics".into(),
            MetricsError::ExporterCreationFailed => "Failed to create exporter".into(),
            MetricsError::InvalidUtf8 => "Invalid UTF-8".into(),
            MetricsError::InvalidLabel => "Invalid label".into(),
            MetricsError::DuplicateMetric => "Metric already exists".into(),
            MetricsError::MetricNotFound => "Metric not found".into(),
            MetricsError::IoError(e) => format!("I/O error: {}", e.to_string()),
        }
    }
}

// ============================================================================
// Global Metrics Instance (for convenience)
// ============================================================================

static mut GLOBAL_REGISTRY: Option<MetricsRegistry> = None;

fn init_global_registry() -> Result<(), MetricsError> {
    unsafe {
        GLOBAL_REGISTRY = Some(MetricsRegistry::new()?);
        Ok(())
    }
}

fn global_registry() -> Result<&'static mut MetricsRegistry, MetricsError> {
    unsafe {
        GLOBAL_REGISTRY.as_mut().ok_or(MetricsError::RegistryCreationFailed)
    }
}

fn counter(name: &str, help: &str, labels: &[(&str, &str)]) -> Result<Counter, MetricsError> {
    global_registry()?.register_counter(name, help, labels)
}

fn gauge(name: &str, help: &str, labels: &[(&str, &str)]) -> Result<Gauge, MetricsError> {
    global_registry()?.register_gauge(name, help, labels)
}

fn histogram(name: &str, help: &str, labels: &[(&str, &str)], buckets: &[f64]) -> Result<Histogram, MetricsError> {
    global_registry()?.register_histogram(name, help, labels, buckets)
}

fn summary(name: &str, help: &str, labels: &[(&str, &str)], quantiles: &[f64]) -> Result<Summary, MetricsError> {
    global_registry()?.register_summary(name, help, labels, quantiles)
}