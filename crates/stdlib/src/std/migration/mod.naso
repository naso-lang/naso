// Convenience Functions
// ============================================================================

fn migrate_c_to_naso(input: &str, output: &str) -> Result<MigrationResult, MigrationError> {
    let pipeline = MigrationPipeline::new(SourceLanguage::C, TargetLanguage::NasoWithVerification)?;
    pipeline.migrate_file(input, output)
}

fn migrate_rust_to_naso(input: &str, output: &str) -> Result<MigrationResult, MigrationError> {
    let pipeline = MigrationPipeline::new(SourceLanguage::Rust, TargetLanguage::NasoWithVerification)?;
    pipeline.migrate_file(input, output)
}

fn migrate_go_to_naso(input: &str, output: &str) -> Result<MigrationResult, MigrationError> {
    let pipeline = MigrationPipeline::new(SourceLanguage::Go, TargetLanguage::NasoWithVerification)?;
    pipeline.migrate_file(input, output)
}

