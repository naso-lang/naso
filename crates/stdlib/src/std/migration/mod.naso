    pipeline.migrate_file(input, output)
}

fn migrate_project(language: SourceLanguage, input: &str, output: &str) -> Result<ProjectMigrationResult, MigrationError> {
    let pipeline = MigrationPipeline::new(language, TargetLanguage::NasoWithVerification)?;
    pipeline.migrate_project(input, output)
}

fn migration_pipeline(language: SourceLanguage) -> Result<MigrationPipeline, MigrationError> {
