// ============================================================================
// Helper Functions
// ============================================================================

fn walk_dir(dir: &str) -> Result<Vec<std::fs::DirEntry>, MigrationError> {
    let mut entries = Vec::new();
    for entry in std::fs::read_dir(dir).map_err(|_| MigrationError::IoError)? {
        entries.push(entry.map_err(|_| MigrationError::IoError)?);
    }
    Ok(entries)
}

fn extract_json_field(json: &str, field: &str) -> Option<String> {
    let pattern = format!("\"{}\":", field);
    if let Some(start) = json.find(&pattern) {
        let value_start = start + pattern.len();
        let remaining = &json[value_start..];
        if remaining.starts_with('"') {
            if let Some(end) = remaining[1..].find('"') {
                return Some(remaining[1..end+1].into());
            }
        } else {
            let end = remaining.find([',', '}']).unwrap_or(remaining.len());
            return Some(remaining[..end].trim().into());
        }
    }
    None
}

// Default implementations
impl Default for SourceSpan {
    fn default() -> Self {
        SourceSpan {
            file: String::new(),
            start_line: 0,
            start_col: 0,
            end_line: 0,
            end_col: 0,
            start_offset: 0,
            end_offset: 0,
        }
    }
}

impl TranslatedCode {
    fn empty() -> Self {
        TranslatedCode {
            target_language: TargetLanguage::Naso,
            source_language: SourceLanguage::C,
            files: vec![],
            mappings: vec![],
            diagnostics: vec![],
            verification_hints: vec![],
        }
    }

    fn to_source_ast(&self) -> SourceAst {
        SourceAst {
            language: self.source_language,
            file_path: String::new(),
            nodes: vec![],
            symbols: HashMap::new(),
            types: HashMap::new(),
            functions: HashMap::new(),
            globals: vec![],
            imports: vec![],
            metadata: AstMetadata {
                language_version: String::new(),
                target_triple: None,
                features: vec![],
                parse_errors: vec![],
                parse_warnings: vec![],
            },
        }
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum MigrationError {
    ParserCreationFailed,
    ParseFailed,
    TranslationFailed,
    VerificationFailed,
    BindingGenerationFailed,
    InvalidUtf8,
    IoError,
    InvalidSourceLanguage,
    InvalidTargetLanguage,
    UnsupportedConstruct(String),
    VerificationMismatch,
    TransformerFailed(String),
    ValidatorFailed(String),
    ConfigError(String),
}

impl MigrationError {
    pub fn to_string(&self) -> String {
        match self {
            MigrationError::ParserCreationFailed => "Failed to create migration parser".into(),
            MigrationError::ParseFailed => "Failed to parse source file".into(),
            MigrationError::TranslationFailed => "Translation failed".into(),
            MigrationError::VerificationFailed => "Verification failed".into(),
            MigrationError::BindingGenerationFailed => "Binding generation failed".into(),
            MigrationError::InvalidUtf8 => "Invalid UTF-8".into(),
            MigrationError::IoError => "I/O error".into(),
            MigrationError::InvalidSourceLanguage => "Invalid source language".into(),
            MigrationError::InvalidTargetLanguage => "Invalid target language".into(),
            MigrationError::UnsupportedConstruct(s) => format!("Unsupported construct: {}", s),
            MigrationError::VerificationMismatch => "Verification mismatch".into(),
            MigrationError::TransformerFailed(s) => format!("Transformer failed: {}", s),
            MigrationError::ValidatorFailed(s) => format!("Validator failed: {}", s),
            MigrationError::ConfigError(s) => format!("Configuration error: {}", s),
        }
    }
}

