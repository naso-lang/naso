// #[profile]
// fn my_function() { ... }

// #[profile("custom_name")]
// async fn my_async_function() { ... }

fn profile_scope(name: &str) -> ProfileScope {
    ProfileScope::new(name)
}

// ============================================================================
// Profile-Guided Optimization Integration
// ============================================================================

struct PgoData {
    profile_path: String,
    profile_type: ProfileFormat,
}

impl PgoData {
    pub fn from_file(path: &str, format: ProfileFormat) -> Result<Self, ProfilingError> {
        if !std::path::Path::new(path).exists() {
            return Err(ProfilingError::FileNotFound);
        }
        Ok(PgoData {
            profile_path: path.into(),
            profile_type: format,
        })
    }

    pub fn apply_to_build(&self) -> Result<(), ProfilingError> {
        // Would integrate with build system to apply PGO data
        // e.g., pass -fprofile-use to LLVM
        Ok(())
    }
}

// ============================================================================
// Custom Profilers (for domain-specific profiling)
// ============================================================================

trait CustomProfiler {
    fn name(&self) -> &str;
    fn start(&mut self) -> Result<(), ProfilingError>;
    fn stop(&mut self) -> Result<ProfileData, ProfilingError>;
    fn event(&self, name: &str, data: &str);
}

struct QuantumCircuitProfiler {
    circuit_id: String,
    gate_counts: HashMap<String, u64>,
    depth: u32,
}

impl QuantumCircuitProfiler {
    pub fn new(circuit_id: &str) -> Self {
        QuantumCircuitProfiler {
            circuit_id: circuit_id.into(),
            gate_counts: HashMap::new(),
            depth: 0,
        }
    }

    pub fn record_gate(&mut self, gate: &str, count: u64) {
        *self.gate_counts.entry(gate.into()).or_insert(0) += count;
    }

    pub fn record_depth(&mut self, depth: u32) {
        self.depth = depth.max(self.depth);
    }
}

impl CustomProfiler for QuantumCircuitProfiler {
    fn name(&self) -> &str {
        "quantum_circuit"
    }

    fn start(&mut self) -> Result<(), ProfilingError> {
        self.gate_counts.clear();
        self.depth = 0;
        Ok(())
    }

    fn stop(&mut self) -> Result<ProfileData, ProfilingError> {
        let mut json = String::from("{");
        json.push_str(&format!("\"circuit_id\":\"{}\",", self.circuit_id));
        json.push_str(&format!("\"depth\":{},", self.depth));
        json.push_str("\"gates\":{");
        for (i, (gate, count)) in self.gate_counts.iter().enumerate() {
            if i > 0 { json.push(','); }
            json.push_str(&format!("\"{}\":{}", gate, count));
        }
        json.push_str("}}");
        Ok(ProfileData {
            raw_data: json.into_bytes(),
            config: ProfilingConfig {
                profiling_type: ProfilingType::Custom("quantum_circuit".into()),
                interval_ms: 0,
                sample_rate: 1,
                include_kernel: false,
                include_idle: false,
                filter_threads: None,
                filter_functions: None,
            },
        })
    }

    fn event(&self, name: &str, data: &str) {
        // Record quantum-specific events
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum ProfilingError {
    StartFailed,
    StopFailed,
    ReportFailed,
    NotRunning,
    AlreadyRunning,
    UnsupportedType,
    UnsupportedFormat,
    InvalidUtf8,
    IoError,
    FileNotFound,
    PermissionDenied,
}

impl ProfilingError {
    pub fn to_string(&self) -> String {
        match self {
            ProfilingError::StartFailed => "Failed to start profiler".into(),
            ProfilingError::StopFailed => "Failed to stop profiler".into(),
            ProfilingError::ReportFailed => "Failed to generate report".into(),
            ProfilingError::NotRunning => "Profiler not running".into(),
            ProfilingError::AlreadyRunning => "Profiler already running".into(),
            ProfilingError::UnsupportedType => "Unsupported profiling type".into(),
            ProfilingError::UnsupportedFormat => "Unsupported report format".into(),
            ProfilingError::InvalidUtf8 => "Invalid UTF-8 in profile data".into(),
            ProfilingError::IoError => "I/O error".into(),
            ProfilingError::FileNotFound => "Profile file not found".into(),
            ProfilingError::PermissionDenied => "Permission denied (need root for some profilers)".into(),
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

fn profile_cpu(interval_ms: u32) -> Result<Profiler, ProfilingError> {
    Profiler::start(ProfilingConfig::cpu().interval_ms(interval_ms))
}

fn profile_memory(sample_rate: u32) -> Result<Profiler, ProfilingError> {
    Profiler::start(ProfilingConfig::memory(sample_rate))
}

fn profile_alloc() -> Result<Profiler, ProfilingError> {
    Profiler::start(ProfilingConfig::alloc())
}

fn profile_lock() -> Result<Profiler, ProfilingError> {
    Profiler::start(ProfilingConfig::lock())
}

fn profile_wall(interval_ms: u32) -> Result<Profiler, ProfilingError> {
    Profiler::start(ProfilingConfig::wall().interval_ms(interval_ms))
}

fn continuous_profiler() -> ContinuousProfiler {
    ContinuousProfiler::new()
}

fn pgo_data(path: &str, format: ProfileFormat) -> Result<PgoData, ProfilingError> {
    PgoData::from_file(path, format)
}

// ============================================================================
// Profiling Integration with Metrics/Tracing
// ============================================================================

struct ProfilingMetrics {
    cpu_samples_total: crate::metrics::Counter,
    memory_samples_total: crate::metrics::Counter,
    alloc_samples_total: crate::metrics::Counter,
    lock_events_total: crate::metrics::Counter,
    profiling_overhead_ns: crate::metrics::Histogram,
}

impl ProfilingMetrics {
    pub fn new(registry: &mut crate::metrics::MetricsRegistry) -> Result<Self, ProfilingError> {
        Ok(ProfilingMetrics {
            cpu_samples_total: registry.register_counter(
                "naso_profiling_cpu_samples_total",
                "Total CPU profiling samples collected",
                &[],
            ).map_err(|_| ProfilingError::StartFailed)?,
            memory_samples_total: registry.register_counter(
                "naso_profiling_memory_samples_total",
                "Total memory profiling samples collected",
                &[],
            ).map_err(|_| ProfilingError::StartFailed)?,
            alloc_samples_total: registry.register_counter(
                "naso_profiling_alloc_samples_total",
                "Total allocation profiling samples collected",
                &[],
            ).map_err(|_| ProfilingError::StartFailed)?,
            lock_events_total: registry.register_counter(
                "naso_profiling_lock_events_total",
                "Total lock contention events recorded",
                &[],
            ).map_err(|_| ProfilingError::StartFailed)?,
            profiling_overhead_ns: registry.register_histogram(
                "naso_profiling_overhead_nanoseconds",
                "Profiling overhead in nanoseconds",
                &[("type", "")],
                &[100.0, 1000.0, 10000.0, 100000.0, 1000000.0],
            ).map_err(|_| ProfilingError::StartFailed)?,
        })
    }
}

// ============================================================================
// Profiling Integration with Tracing
// ============================================================================

fn trace_profiling_event(name: &str, profiling_type: &str, duration_ns: u64) {
    crate::tracing::Event::new(name, crate::tracing::Level::Debug)
        .field("profiling_type", profiling_type)
        .field("duration_ns", duration_ns)
        .emit();
}