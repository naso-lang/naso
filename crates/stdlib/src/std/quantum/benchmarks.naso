// Quantum Benchmark Suite
//
// Standardized quantum advantage metrics:
// - Quantum Volume (QV)
// - Quantum Economic Value (QEV)
// - Algorithmic benchmarks (VQE, QAOA, QEC, QML)
// - Error rates, coherence times, gate fidelities
// - Cross-platform comparison framework

use crate::std::prelude::*;
use crate::std::quantum::primitives::*;
use crate::std::quantum::variational::*;
use crate::std::quantum::qec::*;
use crate::std::quantum::hybrid::*;
use crate::std::quantum::hardware_vqe::*;
use crate::std::quantum::hardware_qaoa::*;
use crate::std::quantum::hardware_qec::*;
use crate::std::tensor::Tensor;
use crate::std::math::{sin, cos, sqrt, pi, exp, log, random_f32};

// ============================================================
// Benchmark Configuration
// ============================================================

/// Complete benchmark suite configuration.
pub struct BenchmarkSuiteConfig {
    pub providers: [BenchmarkProviderConfig; N_PROVIDERS>,
    pub benchmarks: [BenchmarkType; N_BENCHMARKS>,
    pub output: BenchmarkOutputConfig,
    pub statistical: StatisticalConfig,
}

pub struct BenchmarkProviderConfig {
    pub name: str,
    pub provider: str,  // "ibm", "ionq", "rigetti", "quantinuum", "google"
    pub backend: str,
    pub api_token: str,
    pub max_qubits: usize,
    pub dedicated: bool,
}

pub enum BenchmarkType {
    QuantumVolume { max_qubits: usize, trials_per_qubit: usize },
    QuantumEconomicValue { workloads: [QEVWorkload; N> },
    VQEBenchmark { molecules: [VQEMolecule; N> },
    QAOABenchmark { problems: [QAOAProblemType; N> },
    QECBenchmark { codes: [QECCodeType; N>, distances: [usize; M> },
    QMLBenchmark { datasets: [QMLDataset; N> },
    GateFidelity { gates: [GateType; N>, qubit_pairs: [(usize, usize); M> },
    CoherenceTime { qubits: [usize; N> },
    Crosstalk { qubit_groups: [[usize; 4]; N> },
    MidCircuitMeasurement { qubits: [usize; N> },
    DynamicCircuits { depth: usize, qubits: [usize; N> },
}

pub struct QEVWorkload {
    pub name: str,
    pub problem_size: usize,
    pub classical_baseline_flops: u64,
    pub classical_baseline_time_secs: f32,
    pub quantum_algorithm: str,  // "vqe", "qaoa", "qml", "qpe"
    pub quantum_params: QuantumAlgorithmParams,
}

pub struct QuantumAlgorithmParams {
    pub qubits: usize,
    pub depth: usize,
    pub shots: usize,
    pub error_mitigation: str,
}

pub struct VQEMolecule {
    pub name: str,
    pub n_qubits: usize,
    pub n_terms: usize,
    pub expected_energy: f32,
    pub basis_set: str,
    pub geometry: str,
}

pub struct QAOAProblemType {
    pub name: str,
    pub n_qubits: usize,
    pub problem_class: str,  // "maxcut", "mis", "coloring", "tsp", "portfolio"
    pub graph_params: str,
    pub optimal_value: f32,
}

pub struct QECCodeType {
    pub name: str,  // "surface", "repetition", "steane", "shor", "color"
    pub logical_qubits: usize,
}

pub struct QMLDataset {
    pub name: str,
    pub n_samples: usize,
    pub n_features: usize,
    pub n_classes: usize,
    pub task: str,  // "classification", "regression", "generative"
}

pub enum GateType {
    SingleQubit { gate: str },  // "x", "y", "z", "h", "s", "t", "rx", "ry", "rz"
    TwoQubit { gate: str },     // "cx", "cz", "ecr", "ms", "iswap", "sqrt_iswap"
}

pub struct BenchmarkOutputConfig {
    pub format: OutputFormat,
    pub path: str,
    pub include_raw_data: bool,
    pub generate_plots: bool,
}

pub enum OutputFormat {
    JSON,
    CSV,
    HDF5,
    Parquet,
    All,
}

pub struct StatisticalConfig {
    pub confidence_level: f32,  // 0.95
    pub min_trials: usize,
    pub max_trials: usize,
    pub convergence_threshold: f32,
    pub outlier_removal: bool,
}

