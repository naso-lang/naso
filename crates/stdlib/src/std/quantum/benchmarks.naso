// ============================================================
// Benchmark Execution
// ============================================================

/// Run complete benchmark suite.
pub fn run_benchmark_suite(config: BenchmarkSuiteConfig) -> BenchmarkSuiteResults {
    let start_time = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_secs();
    
    var provider_results: [ProviderResults; N_PROVIDERS> = [];
    
    for provider_config in config.providers {
        let backend = init_benchmark_backend(provider_config);
        let calibration = backend.calibrate().await;
        
        let mut results = ProviderResults {
            provider: provider_config.name,
            backend: provider_config.backend,
            quantum_volume: None,
            qev: None,
            vqe: None,
            qaoa: None,
            qec: None,
            qml: None,
            gate_fidelity: None,
            coherence: None,
            crosstalk: None,
            mid_circuit: None,
            dynamic: None,
            metadata: ProviderMetadata {
                calibration_timestamp: calibration.timestamp,
                backend_version: "1.0",
                queue_time_avg_secs: 0.0,
                total_execution_time_secs: 0.0,
                total_shots: 0,
                errors: [],
            },
        };
        
        for benchmark in config.benchmarks {
            match benchmark {
                BenchmarkType::QuantumVolume { max_qubits, trials_per_qubit } => {
                    results.quantum_volume = Some(run_quantum_volume(backend, max_qubits, trials_per_qubit, config.statistical));
                }
                BenchmarkType::QuantumEconomicValue { workloads } => {
                    results.qev = Some(run_qev_benchmark(backend, workloads, config.statistical));
                }
                BenchmarkType::VQEBenchmark { molecules } => {
                    results.vqe = Some(run_vqe_benchmark(backend, molecules, config.statistical));
                }
                BenchmarkType::QAOABenchmark { problems } => {
                    results.qaoa = Some(run_qaoa_benchmark(backend, problems, config.statistical));
                }
                BenchmarkType::QECBenchmark { codes, distances } => {
                    results.qec = Some(run_qec_benchmark(backend, codes, distances, config.statistical));
                }
                BenchmarkType::QMLBenchmark { datasets } => {
                    results.qml = Some(run_qml_benchmark(backend, datasets, config.statistical));
                }
                BenchmarkType::GateFidelity { gates, qubit_pairs } => {
                    results.gate_fidelity = Some(run_gate_fidelity_benchmark(backend, gates, qubit_pairs, config.statistical));
                }
                BenchmarkType::CoherenceTime { qubits } => {
                    results.coherence = Some(run_coherence_benchmark(backend, qubits, config.statistical));
                }
                BenchmarkType::Crosstalk { qubit_groups } => {
                    results.crosstalk = Some(run_crosstalk_benchmark(backend, qubit_groups, config.statistical));
                }
                BenchmarkType::MidCircuitMeasurement { qubits } => {
                    results.mid_circuit = Some(run_mid_circuit_benchmark(backend, qubits, config.statistical));
                }
                BenchmarkType::DynamicCircuits { depth, qubits } => {
                    results.dynamic = Some(run_dynamic_circuit_benchmark(backend, depth, qubits, config.statistical));
                }
            }
        }
        
        provider_results.push(results);
    }
    
    // Compute cross-provider comparison
    let comparison = compute_cross_provider_comparison(provider_results);
    
    // Generate summary
    let summary = generate_benchmark_summary(provider_results);
    
    let total_time = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_secs() - start_time;
    
    BenchmarkSuiteResults {
        timestamp: start_time,
        providers: provider_results,
        comparison,
        summary: BenchmarkSummary {
            total_benchmarks: config.benchmarks.len() * config.providers.len(),
            completed: 0, // Would count completed
            failed: 0,
            total_time_secs: total_time as f32,
            key_findings: extract_key_findings(comparison),
        },
    }
}

// ============================================================
// Quantum Volume Benchmark
// ============================================================

/// Run Quantum Volume benchmark.
/// 
/// QV = max(2^n) where n = max qubits with heavy output prob > 2/3
/// at depth = n, with confidence > 0.977
pub fn run_quantum_volume(
    backend: QuantumBackend,
    max_qubits: usize,
    trials_per_qubit: usize,
    stats: StatisticalConfig
) -> QuantumVolumeResult {
    var per_qubit: [QVPerQubit; N_QUBITS> = [];
    var max_passed_qubits = 0;
    
    for n in 1..=max_qubits {
        // Generate QV circuits: random SU(4) on qubit pairs, depth = n
        let circuits = generate_qv_circuits(n, trials_per_qubit);
        
        var heavy_output_count = 0;
        var total_circuits = 0;
        
        for circuit in circuits {
            // Run on hardware
            let result = backend.execute(&circuit, ExecutionConfig { 
                shots: 1000, 
                ..Default::default() 
            }).await;
            
            // Compute ideal heavy outputs via simulation
            let ideal_heavy = compute_ideal_heavy_outputs(circuit);
            let measured_heavy = compute_measured_heavy_outputs(result.counts);
            
            // Heavy output probability
            let heavy_prob = measured_heavy / 1000.0;
            
            if heavy_prob > 2.0/3.0 {
                heavy_output_count += 1;
            }
            total_circuits += 1;
        }
        
        let heavy_output_prob = heavy_output_count as f32 / total_circuits as f32;
        let passed = heavy_output_prob > 2.0/3.0;
        
        if passed {
            max_passed_qubits = n;
        }
        
        per_qubit[n-1] = QVPerQubit {
            n_qubits: n,
            heavy_output_prob,
            std_dev: sqrt(heavy_output_prob * (1.0 - heavy_output_prob) / total_circuits as f32),
            passed,
            circuits: total_circuits,
            depth: n,
        };
    }
    
    let qv = if max_passed_qubits > 0 { 1 << max_passed_qubits } else { 1 };
    
    QuantumVolumeResult {
        qv,
        max_qubits_tested: max_qubits,
        heavy_output_probability: per_qubit[max_passed_qubits-1].heavy_output_prob,
        confidence: 0.977,
        circuits_tested: trials_per_qubit * max_qubits,
        per_qubit,
    }
}

fn generate_qv_circuits(n_qubits: usize, trials: usize) -> [QuantumCircuit; N> {
    // QV circuits: layers of random SU(4) on random qubit pairs
    var circuits: [QuantumCircuit; N> = [];
    
    for _ in 0..trials {
        let mut circuit = QuantumCircuit::new(n_qubits);
        
        for _ in 0..n_qubits { // depth = n_qubits
            // Random pairing
            let pairs = random_pairing(n_qubits);
            for (a, b) in pairs {
                // Random SU(4) decomposed to native gates
                apply_random_su4(&mut circuit, a, b);
            }
        }
        
        // Measure all qubits
        for i in 0..n_qubits {
            circuit.measure(i, i);
        }
        
        circuits.push(circuit);
    }
    
    circuits
}

fn random_pairing(n: usize) -> [(usize, usize); N/2] {
