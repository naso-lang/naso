fn get_quantum_hourly_rate(algorithm: str) -> f32 {
    match algorithm {
        "vqe" => 5000.0,  // $5000/hr for quantum compute
        "qaoa" => 3000.0,
        "qml" => 4000.0,
        "qpe" => 6000.0,
        _ => 5000.0,
    }
}

// ============================================================
// VQE Benchmark
// ============================================================

/// Run VQE benchmark on standard molecules.
pub fn run_vqe_benchmark(
    backend: QuantumBackend,
    molecules: [VQEMolecule; N>,
    stats: StatisticalConfig
) -> VQEBenchmarkResult {
    var molecule_results: [VQEMoleculeResult; N> = [];
    var total_error = 0.0;
    var success_count = 0;
    var total_time = 0.0;
    
    for molecule in molecules {
        // Build Hamiltonian
        let hamiltonian = build_molecule_hamiltonian(molecule);
        
        // Run VQE with hardware error mitigation
        let config = VQEHardwareConfig {
            shots: 10000,
            error_mitigation: ErrorMitigationStrategy::ZNE { scales: [1.0, 1.5, 2.0], shots_per_scale: 5000 },
            ..Default::default()
        };
        
        let ansatz = HardwareEfficientAnsatz::<molecule.n_qubits, 2>;
        var initial_params: Tensor[f32, 16> = tensor_zeros();
        
        let start = std::time::Instant::now();
        let result = vqe_on_ibm_hardware(hamiltonian, ansatz, initial_params, config);
        let elapsed = start.elapsed().as_secs_f32();
        
        let error = (result.result.ground_state_energy - molecule.expected_energy).abs();
        let converged = result.result.converged && error < 0.01; // 10 mHa threshold
        
        if converged { success_count += 1; }
        total_error += error;
        total_time += elapsed;
        
        molecule_results.push(VQEMoleculeResult {
            molecule: molecule.name,
            computed_energy: result.result.ground_state_energy,
            exact_energy: molecule.expected_energy,
            error,
            converged,
            iterations: result.result.iterations,
            time_secs: elapsed,
            shots: config.shots,
            error_mitigation: "ZNE",
        });
    }
    
    VQEBenchmarkResult {
        molecules: molecule_results,
        avg_energy_error: total_error / molecules.len() as f32,
        success_rate: success_count as f32 / molecules.len() as f32,
        avg_time_secs: total_time / molecules.len() as f32,
    }
}

fn build_molecule_hamiltonian(molecule: VQEMolecule) -> PauliHamiltonian<N_QUBITS, N_TERMS> {
    // Build from pre-computed integrals
    match molecule.name {
        "H2" => h2_hamiltonian_sto3g(),
        "LiH" => lih_hamiltonian_sto3g(),
        "HeH+" => heh_hamiltonian_sto3g(),
        _ => unimplemented!(),
    }
}

// ============================================================
// QAOA Benchmark
// ============================================================

/// Run QAOA benchmark on standard problems.
pub fn run_qaoa_benchmark(
    backend: QuantumBackend,
    problems: [QAOAProblemType; N>,
    stats: StatisticalConfig
) -> QAOABenchmarkResult {
    var problem_results: [QAOAProblemResult; N> = [];
    var total_ratio = 0.0;
    var success_count = 0;
    var total_time = 0.0;
    
    for problem in problems {
        let qaoa_problem = build_qaoa_problem(problem);
        
        var initial_params: QAOAParams<3> = tensor_zeros();
        
        let config = QAOAHardwareConfig {
            shots: 10000,
            error_mitigation: QAOAErrorMitigation::ZNE { scales: [1.0, 1.5, 2.0], shots_per_scale: 5000 },
            ..Default::default()
        };
        
        let start = std::time::Instant::now();
        let result = qaoa_on_ionq_hardware(qaoa_problem, initial_params, config);
        let elapsed = start.elapsed().as_secs_f32();
        
        let approx_ratio = result.result.best_value / problem.optimal_value;
        let converged = approx_ratio > 0.95;
        
        if converged { success_count += 1; }
        total_ratio += approx_ratio;
        total_time += elapsed;
        
        problem_results.push(QAOAProblemResult {
            problem: problem.name,
            optimal_value: problem.optimal_value,
            quantum_value: result.result.best_value,
            approx_ratio,
            converged,
            iterations: result.result.iterations,
            time_secs: elapsed,
            shots: config.shots,
            p_layers: 3,
        });
    }
    
    QAOABenchmarkResult {
        problems: problem_results,
        avg_approx_ratio: total_ratio / problems.len() as f32,
        success_rate: success_count as f32 / problems.len() as f32,
        avg_time_secs: total_time / problems.len() as f32,
    }
}

fn build_qaoa_problem(problem: QAOAProblemType) -> MaxCutProblem {
    match problem.problem_class {
        "maxcut" => MaxCutProblem { edges: parse_maxcut_edges(problem.graph_params) },
        _ => unimplemented!(),
    }
}

fn parse_maxcut_edges(params: str) -> [(usize, usize); N_EDGES] {
    unimplemented!()
}

// ============================================================
// QEC Benchmark
// ============================================================

/// Run QEC benchmark on standard codes.
pub fn run_qec_benchmark(
    backend: QuantumBackend,
    codes: [QECCodeType; N>,
    distances: [usize; M>,
    stats: StatisticalConfig
) -> QECBenchmarkResult {
    var code_results: [QECCodeResult; N> = [];
    var best_logical_error = f32::INFINITY;
    var best_threshold = 0.0;
    
    for code in codes {
        for &distance in distances {
            let config = QECHardwareConfig {
                code: match code.name {
                    "surface" => QECCodeType::SurfaceCode { 
                        data_qubits: allocate_surface_data(distance), 
                        ancilla_qubits: allocate_surface_ancilla(distance) 
                    },
                    "repetition" => QECCodeType::RepetitionCode { 
                        data_qubits: allocate_repetition_data(distance), 
                        ancilla_qubits: allocate_repetition_ancilla(distance) 
                    },
                    _ => continue,
                },
                distance,
                cycles: 10,
                shots_per_cycle: 1000,
                decoder: DecoderType::MWPM,
                ..Default::default()
            };
            
            let result = match code.name {
                "surface" => surface_code_on_ibm_hardware(config),
                "repetition" => repetition_code_on_ionq_hardware(config),
                _ => continue,
            };
            
            if result.logical_error_rate < best_logical_error {
                best_logical_error = result.logical_error_rate;
            }
            if result.threshold_estimate > best_threshold {
                best_threshold = result.threshold_estimate;
            }
            
            code_results.push(QECCodeResult {
                code: code.name,
                distance,
                physical_error_rate: result.physical_error_rate,
                logical_error_rate: result.logical_error_rate,
                cycles: config.cycles,
                decoder: "MWPM",
                threshold: result.threshold_estimate,
            });
        }
    }
    
    QECBenchmarkResult {
        codes: code_results,
        best_logical_error_rate: best_logical_error,
        threshold_estimate: best_threshold,
    }
}

