// ============================================================
// Dynamic Circuits Benchmark
// ============================================================

/// Run dynamic circuits benchmark (feedforward, real-time).
pub fn run_dynamic_circuit_benchmark(
    backend: QuantumBackend,
    depth: usize,
    qubits: [usize; N>,
    stats: StatisticalConfig
) -> DynamicCircuitResult {
    // Build dynamic circuit with mid-circuit measurement and feedforward
    let circuit = build_dynamic_circuit(depth, qubits);
    
    // Measure feedforward latency
    let start = std::time::Instant::now();
    let result = backend.execute(&circuit, ExecutionConfig { shots: 1000, ..Default::default() }).await;
    let latency = start.elapsed().as_nanos() as f32;
    
    // Verify correct feedforward behavior
    let success_rate = verify_dynamic_circuit(result.counts);
    
    DynamicCircuitResult {
        max_depth_tested: depth,
        success_rate,
        feedforward_latency_ns: latency,
    }
}

