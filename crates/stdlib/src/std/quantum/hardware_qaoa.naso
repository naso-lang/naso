// ============================================================
// Quantinuum QAOA Execution
// ============================================================

/// Execute QAOA on Quantinuum trapped-ion hardware.
///
/// Quantinuum H2: 56 qubits, all-to-all connectivity,
/// mid-circuit measurement, qubit reuse (quantum CCD).
pub fn qaoa_on_quantinuum_hardware<
    PROBLEM: QAOAProblem<N_QUBITS>,
    const N_QUBITS: usize,
    const P: usize
>(
    problem: PROBLEM,
    initial_params: QAOAParams<P>,
    config: QAOAHardwareConfig
) -> QAOAHardwareResult<P> {
    
    assert!(N_QUBITS <= 56, "Quantinuum H2 supports max 56 qubits, got {}", N_QUBITS);
    
    // Quantinuum supports mid-circuit measurement and qubit reuse
    // This enables QAOA with dynamic circuits for larger problems
    
    let backend = init_quantinuum_backend(config.provider);
    let calibration = backend.calibrate().await;
    
    // Build dynamic QAOA circuit with mid-circuit measurement
    // for qubit reuse on larger problems
    let dynamic_circuit = build_dynamic_qaoa_circuit::<N_QUBITS, P, PROBLEM>(problem);
    
    let result = qaoa_optimization_loop_quantinuum(
        dynamic_circuit,
        problem,
        initial_params,
        config,
        calibration,
        backend
    );
    
    QAOAHardwareResult {
        result,
        hardware_metadata: HardwareMetadata {
            provider: "Quantinuum",
            backend: get_quantinuum_backend_name(config.provider),
            total_shots: config.shots * (2 * P + 1),
            execution_time_secs: 0,
            error_mitigation_used: config.error_mitigation,
            calibration_timestamp: calibration.timestamp,
        },
    }
}

