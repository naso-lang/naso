fn init_ionq_backend(provider: QAOAProvider) -> IonQBackend {
    match provider {
        QAOAProvider::IonQ { backend, api_key } => {
            let config = BackendConfig {
                name: backend,
                api_token: Some(api_key),
                api_url: Some("https://api.ionq.co/v0.3".to_string()),
                timeout_secs: 300,
                poll_interval_secs: 10,
            };
            IonQBackend::new(config).unwrap()
        }
        _ => panic!("Expected IonQ provider"),
    }
}

fn init_quantinuum_backend(provider: QAOAProvider) -> QuantinuumBackend {
    unimplemented!()
}

fn get_ionq_backend_name(provider: QAOAProvider) -> str {
    match provider {
        QAOAProvider::IonQ { backend, .. } => backend,
        _ => "unknown",
    }
}

fn get_quantinuum_backend_name(provider: QAOAProvider) -> str {
    match provider {
        QAOAProvider::Quantinuum { backend, .. } => backend,
        _ => "unknown",
    }
}

fn measure_from_counts(counts: HashMap<String, usize>) -> [bool; N_QUBITS] {
    // Find most frequent bitstring
    var max_count = 0;
    var best_bitstring = "";
    for (bitstring, count) in counts {
        if count > max_count {
            max_count = count;
            best_bitstring = bitstring;
        }
    }
    
    var result: [bool; N_QUBITS] = [false; N_QUBITS];
    for (i, c) in best_bitstring.chars().enumerate() {
        result[i] = c == '1';
    }
    result
}

