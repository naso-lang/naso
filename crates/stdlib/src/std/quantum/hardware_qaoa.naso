/// MaxCut QAOA on IonQ (32-qubit complete graph).
/// Demonstrates advantage on dense graphs due to all-to-all connectivity.
pub fn demo_maxcut_qaoa_ionq<const N_QUBITS: usize>() -> f32 {
    // Create MaxCut problem on random 3-regular graph
    let edges = generate_random_3regular_edges(N_QUBITS);
    let problem = MaxCutProblem::<N_QUBITS, { N_QUBITS * 3 / 2 }> { edges };
    
    // QAOA with P=3 layers (6 params)
    var initial_params: QAOAParams<3> = tensor_zeros();
    for i in 0..6 {
        initial_params[i] = random_f32() * pi;
    }
    
    let config = QAOAHardwareConfig {
        provider: QAOAProvider::IonQ { backend: "ionq_forte", api_key: "" },
        error_mitigation: QAOAErrorMitigation::ZNE { scales: [1.0, 1.5, 2.0], shots_per_scale: 5000 },
        use_parametric: true,
        ..Default::default()
    };
    
    let result = qaoa_on_ionq_hardware(problem, initial_params, config);
    result.result.best_value
}

