/// QEC cycle benchmark: logical error rate vs cycles.
pub fn demo_qec_scaling_ibm<const MAX_CYCLES: usize>() -> [QECExperimentResult; MAX_CYCLES> {
    var results: [QECExperimentResult; MAX_CYCLES> = [];
    
    for c in 1..=MAX_CYCLES {
        let config = QECHardwareConfig {
            cycles: c,
            ..demo_surface_code_d3_ibm() // Would use base config
        };
        results[c-1] = surface_code_on_ibm_hardware(config);
    }
    
    results
}

/// Compare QEC codes on same hardware.
pub fn demo_qec_code_comparison_ibm() -> [QECExperimentResult; 3] {
    var results: [QECExperimentResult; 3] = [];
    
    // Surface code d=3
    results[0] = demo_surface_code_d3_ibm();
    
    // Repetition code d=3
    let rep_config = QECHardwareConfig {
        code: QECCodeType::RepetitionCode { 
            data_qubits: [0, 1, 2], 
            ancilla_qubits: [3, 4] 
        },
        cycles: 10,
        ..Default::default()
    };
    results[1] = repetition_code_on_ibm_hardware(rep_config);
    
    // Shor code
    // results[2] = shor_code_on_ibm_hardware(...);
    
    results
}

// ============================================================
// Result Types
// ============================================================

pub struct QECExperimentResult {
    pub code_type: str,
    pub distance: usize,
    pub physical_error_rate: f32,
    pub logical_error_rate: f32,
    pub threshold_estimate: f32,
    pub syndrome_histories: [1] [SyndromeHistory; N_CYCLES>,
    pub cycles: usize,
    pub shots_per_cycle: usize,
    pub hardware_metadata: HardwareMetadata,
}

pub struct SyndromeHistory {
    pub syndromes: [Syndrome; N_ANCILLA>,
    pub logical_errors: usize,
}

pub struct HardwareMetadata {
    pub provider: str,
    pub backend: str,
    pub total_shots: usize,
    pub execution_time_secs: u64,
    pub error_mitigation_used: QECErrorMitigation,
    pub decoder_used: DecoderType,
    pub calibration_timestamp: u64,
}

pub struct SurfaceCodeCircuits {
    pub encode_circuit: QuantumCircuit,
    pub syndrome_circuits: [QuantumCircuit; N_CYCLES>,
    pub decode_circuit: QuantumCircuit,
}

// ============================================================
// Helper Functions
// ============================================================

fn init_ibm_backend_qec(provider: QECProvider) -> IBMBackend {
    match provider {
        QECProvider::IBM { backend, api_token, layout: _ } => {
            let config = BackendConfig {
                name: backend,
                api_token: Some(api_token),
                api_url: Some("https://api.quantum-computing.ibm.com".to_string()),
                timeout_secs: 300,
                poll_interval_secs: 10,
            };
            IBMBackend::new(config).unwrap()
        }
        _ => panic!("Expected IBM provider"),
    }
}

fn init_ionq_backend_qec(provider: QECProvider) -> IonQBackend {
    match provider {
        QECProvider::IonQ { backend, api_key, layout: _ } => {
            let config = BackendConfig {
                name: backend,
                api_token: Some(api_key),
                api_url: Some("https://api.ionq.co/v0.3".to_string()),
                timeout_secs: 300,
                poll_interval_secs: 10,
            };
            IonQBackend::new(config).unwrap()
        }
        _ => panic!("Expected IonQ provider"),
    }
}

fn get_backend_name(provider: QECProvider) -> str {
    match provider {
        QECProvider::IBM { backend, .. } => backend,
        QECProvider::IonQ { backend, .. } => backend,
        QECProvider::Quantinuum { backend, .. } => backend,
        QECProvider::Google { backend, .. } => backend,
    }
}

fn get_ionq_backend_name(provider: QECProvider) -> str {
    match provider {
        QECProvider::IonQ { backend, .. } => backend,
        _ => "unknown",
    }
}

