fn estimate_physical_error_rate(calibration: CalibrationData) -> f32 {
    // Average gate error from calibration
    if calibration.gate_errors.is_empty() { return 1e-3; }
    calibration.gate_errors.values().sum::<f32>() / calibration.gate_errors.len() as f32
}

fn compute_threshold(logical_rates: [1] Tensor[f32, N_CYCLES>, physical_rate: f32) -> f32 {
    // Estimate threshold by finding physical rate where logical = physical
    // Simplified: return physical rate * sqrt(cycles)
    physical_rate * sqrt(N_CYCLES as f32)
}

// ============================================================
// Repetition Code on IonQ
// ============================================================

/// Execute Repetition Code QEC on IonQ trapped-ion hardware.
///
/// IonQ's all-to-all connectivity makes repetition codes efficient.
/// Distance d: d data qubits, d-1 ancilla qubits.
pub fn repetition_code_on_ionq_hardware(
    config: QECHardwareConfig
) -> QECExperimentResult {
    match config.code {
        QECCodeType::RepetitionCode { data_qubits, ancilla_qubits } => {
            run_repetition_code_ionq(data_qubits, ancilla_qubits, config)
        }
        _ => panic!("Expected RepetitionCode for IonQ"),
    }
}

/// Run repetition code experiment on IonQ.
fn run_repetition_code_ionq<const N_DATA: usize, const N_ANCILLA: usize>(
    data_qubits: [usize; N_DATA],
    ancilla_qubits: [usize; N_ANCILLA],
    config: QECHardwareConfig
) -> QECExperimentResult {
    let backend = init_ionq_backend_qec(config.provider);
    let calibration = backend.calibrate().await;
    
    // Build repetition code circuits
    let circuits = build_repetition_code_circuits(data_qubits, ancilla_qubits, config.cycles);
    
    var logical_error_rates: Tensor[f32, N_CYCLES> = tensor_zeros();
    
    for cycle in 0..config.cycles {
        let result = backend.execute(&circuits[cycle], 
            ExecutionConfig { shots: config.shots_per_cycle, ..Default::default() }).await;
        
        let syndromes = extract_syndromes_repetition(result.counts, N_ANCILLA);
        let logical_errors = majority_vote_decode(syndromes, N_DATA);
        
        logical_error_rates[cycle] = logical_errors / config.shots_per_cycle as f32;
    }
    
    let avg_logical_error = logical_error_rates.sum() / config.cycles as f32;
    let physical_error_rate = estimate_physical_error_rate(calibration);
    
    QECExperimentResult {
        code_type: "RepetitionCode",
        distance: config.distance,
        physical_error_rate,
        logical_error_rate: avg_logical_error,
        threshold_estimate: 0.5, // Repetition code threshold = 0.5
        syndrome_histories: [],
        cycles: config.cycles,
        shots_per_cycle: config.shots_per_cycle,
        hardware_metadata: HardwareMetadata {
            provider: "IonQ",
            backend: get_ionq_backend_name(config.provider),
            total_shots: config.shots_per_cycle * config.cycles,
            execution_time_secs: 0,
            error_mitigation_used: config.error_mitigation,
            decoder_used: DecoderType::LookupTable,
            calibration_timestamp: calibration.timestamp,
        },
    }
}

/// Build repetition code circuits.
fn build_repetition_code_circuits<const N_DATA: usize, const N_ANCILLA: usize>(
    data_qubits: [usize; N_DATA],
    ancilla_qubits: [usize; N_ANCILLA],
    cycles: usize
) -> [QuantumCircuit; N_CYCLES> {
    var circuits: [QuantumCircuit; N_CYCLES] = [];
    
    for cycle in 0..cycles {
        let mut circuit = QuantumCircuit::new(N_DATA + N_ANCILLA);
        
        if cycle == 0 {
            // Encode: CNOT from data[0] to all other data qubits
            for i in 1..N_DATA {
                circuit.cnot(data_qubits[0], data_qubits[i]);
            }
        }
        
        // Syndrome: CNOT(data[i], ancilla[i]), CNOT(data[i+1], ancilla[i])
        for i in 0..N_ANCILLA {
            circuit.cnot(data_qubits[i], ancilla_qubits[i]);
            circuit.cnot(data_qubits[i + 1], ancilla_qubits[i]);
            circuit.measure(ancilla_qubits[i], i);
        }
        
        // Reset ancillas
        for &ancilla in ancilla_qubits {
            circuit.reset(ancilla);
        }
        
        circuits[cycle] = circuit;
    }
    
    circuits
}

/// Extract syndromes for repetition code.
fn extract_syndromes_repetition(counts: HashMap<String, usize>, num_ancilla: usize) -> [Syndrome; N_ANCILLA> {
    var best: [Syndrome; N_ANCILLA> = [false; N_ANCILLA];
    var max_count = 0;
    
    for (bitstring, count) in counts {
        if count > max_count {
            max_count = count;
            for (i, c) in bitstring.chars().enumerate() {
                if i < num_ancilla {
                    best[i] = c == '1';
                }
            }
        }
    }
    
    best
}

/// Majority vote decoding for repetition code.
fn majority_vote_decode(syndromes: [Syndrome; N_ANCILLA>, num_data: usize) -> usize {
    // Syndrome pattern indicates error location
    // For simplicity, count logical errors (simplified)
    var logical_errors = 0;
    
    // In repetition code, any syndrome = error
    // Logical error = weight of error >= (d+1)/2
    // Simplified: if any syndrome is 1, count as logical error
    for s in syndromes {
        if s { logical_errors += 1; }
    }
    
    logical_errors
}

