/// Surface code distance 3 on IBM (9 data + 8 ancilla = 17 qubits).
pub fn demo_surface_code_d3_ibm() -> QECExperimentResult {
    let config = QECHardwareConfig {
        provider: QECProvider::IBM { 
            backend: "ibm_brisbane", 
            api_token: "", 
            layout: QECLayout { 
                data_qubits: [0, 1, 2, 3, 4, 5, 6, 7, 8], // 3x3 grid
                ancilla_qubits: [9, 10, 11, 12, 13, 14, 15, 16], // 8 ancilla
                coupling_map: [] // Would be filled from backend properties
            } 
        },
        code: QECCodeType::SurfaceCode { 
            data_qubits: [0, 1, 2, 3, 4, 5, 6, 7, 8], 
            ancilla_qubits: [9, 10, 11, 12, 13, 14, 15, 16] 
        },
        distance: 3,
        cycles: 10,
        shots_per_cycle: 1000,
        decoder: DecoderType::MWPM,
        error_mitigation: QECErrorMitigation::PostSelection { threshold: 0.01 },
        ..Default::default()
    };
    
    surface_code_on_ibm_hardware(config)
}

