fn linear_regression(x: [1] Tensor[f32, N>, y: [1] Tensor[f32, N>) -> (f32, f32) {
    // y = a*x + b
    var sum_x = 0.0, sum_y = 0.0, sum_xy = 0.0, sum_x2 = 0.0;
    for i in 0..N {
        sum_x += x[i];
        sum_y += y[i];
        sum_xy += x[i] * y[i];
        sum_x2 += x[i] * x[i];
    }
    let a = (N as f32 * sum_xy - sum_x * sum_y) / (N as f32 * sum_x2 - sum_x * sum_x);
    let b = (sum_y - a * sum_x) / N as f32;
    (a, b)
}

