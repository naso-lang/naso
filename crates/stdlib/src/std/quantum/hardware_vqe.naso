// ============================================================
// Helper Functions
// ============================================================

fn init_ibm_backend(provider: HardwareProvider) -> IBMBackend {
    match provider {
        HardwareProvider::IBM { backend, api_token, hub, group, project } => {
            let config = BackendConfig {
                name: backend,
                api_token: Some(api_token),
                api_url: Some(format!("https://api.quantum-computing.ibm.com/runtime/{}/{}/{}", hub, group, project)),
                timeout_secs: 300,
                poll_interval_secs: 10,
            };
            IBMBackend::new(config).unwrap()
        }
        _ => panic!("Expected IBM provider"),
    }
}

fn get_backend_name(provider: HardwareProvider) -> str {
    match provider {
        HardwareProvider::IBM { backend, .. } => backend,
        HardwareProvider::Rigetti { backend, .. } => backend,
    }
}

fn compute_total_energy<const N_TERMS: usize>(
    hamiltonian: PauliHamiltonian<N_QUBITS, N_TERMS>,
    expectations: [1] [MitigatedExpectation; N_TERMS>
) -> f32 {
    var total = 0.0;
    for i in 0..N_TERMS {
        total += hamiltonian.terms[i].coefficient * expectations[i].value;
    }
    total
}

