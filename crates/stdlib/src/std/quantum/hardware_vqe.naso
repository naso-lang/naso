        mitigated[term_idx] = MitigatedExpectation { 
            value: compute_expectation_from_counts(result.counts, N_QUBITS), 
            raw_expectations: [] 
        };
    }
    mitigated
}

/// VQE optimization loop with hardware feedback.
fn vqe_optimization_loop<
    ANSATZ: VQEAnsatz<N_QUBITS, N_PARAMS>,
    const N_QUBITS: usize,
    const N_PARAMS: usize,
    const N_TERMS: usize
>(
    hamiltonian: PauliHamiltonian<N_QUBITS, N_TERMS>,
    ansatz: ANSATZ,
    initial_params: [1] Tensor[f32, N_PARAMS>,
    initial_expectations: [1] [MitigatedExpectation; N_TERMS>,
    config: VQEHardwareConfig
) -> VQEResult<N_PARAMS> {
    var params = initial_params;
    var prev_energy = compute_total_energy(hamiltonian, initial_expectations);
    var converged = false;
    
    // Adam optimizer state
    var m: Tensor[f32, N_PARAMS> = tensor_zeros();
    var v: Tensor[f32, N_PARAMS> = tensor_zeros();
    var t = 0;
    
    for iter in 0..config.max_iterations {
        // Compute gradient via parameter shift
        var gradient: Tensor[f32, N_PARAMS> = tensor_zeros();
        const SHIFT = pi / 2.0;
        
        for i in 0..N_PARAMS {
            var params_plus = params.clone();
            var params_minus = params.clone();
            params_plus[i] += SHIFT;
            params_minus[i] -= SHIFT;
            
            // Build and execute circuits for plus/minus
            let circuits_plus = build_vqe_circuits(hamiltonian, ansatz, params_plus);
            let circuits_minus = build_vqe_circuits(hamiltonian, ansatz, params_minus);
            
            let exp_plus = execute_vqe_circuits(config, circuits_plus);
            let exp_minus = execute_vqe_circuits(config, circuits_minus);
            
            let energy_plus = compute_total_energy(hamiltonian, exp_plus);
            let energy_minus = compute_total_energy(hamiltonian, exp_minus);
            
            gradient[i] = (energy_plus - energy_minus) / 2.0;
        }
        
        // Adam update
        t += 1;
        let lr = config.learning_rate;
        let beta1 = 0.9, beta2 = 0.999, eps = 1e-8;
        
        for i in 0..N_PARAMS {
            m[i] = beta1 * m[i] + (1.0 - beta1) * gradient[i];
            v[i] = beta2 * v[i] + (1.0 - beta2) * gradient[i] * gradient[i];
            
            let m_hat = m[i] / (1.0 - beta1.powi(t as i32));
            let v_hat = v[i] / (1.0 - beta2.powi(t as i32));
            
            params[i] -= lr * m_hat / (sqrt(v_hat) + eps);
        }
        
        // Evaluate new parameters
        let circuits = build_vqe_circuits(hamiltonian, ansatz, params);
        let expectations = execute_vqe_circuits(config, circuits);
        let energy = compute_total_energy(hamiltonian, expectations);
        
        // Check convergence
        if (energy - prev_energy).abs() < config.convergence_threshold {
            converged = true;
            break;
        }
        
        prev_energy = energy;
    }
    
    VQEResult {
        optimal_params: params,
        ground_state_energy: prev_energy,
        iterations: config.max_iterations,
        converged,
    }
}

