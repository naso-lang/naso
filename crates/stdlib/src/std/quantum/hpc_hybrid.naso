/// Coupling: MPIOffload - syndrome data streamed to classical decoders
pub fn demo_qec_hybrid_decoding<const DISTANCE: usize, const CYCLES: usize>() -> HybridHPCResult {
    let config = HybridHPCConfig {
        classical: ClassicalHPCConfig {
            mpi_ranks: 4096,
            gpus_per_rank: 4,
            memory_per_rank_gb: 128,
            walltime_hours: 4.0,
            partition: "aurora",
        },
        quantum: QuantumHPCConfig {
            providers: [
                QuantumProviderConfig { provider: "ibm", backend: "ibm_brisbane", api_token: "", max_qubits: 127, max_shots: 20000 },
                QuantumProviderConfig { provider: "google", backend: "sycomore", api_token: "", max_qubits: 70, max_shots: 100000 },
            ],
            job_priority: JobPriority::Dedicated,
            max_queue_time_hours: 0.5,
            dedicated_access: true,
        },
        coupling: CouplingStrategy::MPIOffload {
            mpi_communicator: MPIComm::WORLD,
