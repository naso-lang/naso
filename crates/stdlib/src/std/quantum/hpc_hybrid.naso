/// VQE + DMRG for quantum chemistry on exascale + quantum.
///
/// Classical: DMRG (Density Matrix Renormalization Group) on Frontier/Aurora
/// Quantum: VQE for active space on IBM/IonQ
/// Coupling: Iterative - DMRG provides initial params, VQE refines, DMRG updates
pub fn demo_vqe_dmrg_hybrid<const N_QUBITS: usize, const N_SITES: usize>() -> HybridHPCResult {
    let config = HybridHPCConfig {
        classical: ClassicalHPCConfig {
            mpi_ranks: 1024,
            gpus_per_rank: 4,
            memory_per_rank_gb: 256,
            walltime_hours: 24.0,
            partition: "frontier",
        },
        quantum: QuantumHPCConfig {
            providers: [
                QuantumProviderConfig { provider: "ibm", backend: "ibm_brisbane", api_token: "", max_qubits: 127, max_shots: 20000 },
                QuantumProviderConfig { provider: "ionq", backend: "ionq_forte", api_token: "", max_qubits: 32, max_shots: 10000 },
            ],
            job_priority: JobPriority::High,
            max_queue_time_hours: 2.0,
            dedicated_access: false,
        },
        coupling: CouplingStrategy::Iterative {
            classical_step: DMRGKernel { n_sites: N_SITES, bond_dim: 256 },
            quantum_step: VQEQuantumKernel { n_qubits: N_QUBITS },
            convergence: ConvergenceCriterion { max_iterations: 50, energy_tolerance: 1e-6, gradient_tolerance: 1e-4, walltime_limit_secs: 86400 },
        },
        allocation: ResourceAllocation {
            classical_nodes: 256,
            quantum_backends: [],
            data_transfer: DataTransferConfig { protocol: TransferProtocol::Network, bandwidth_gbps: 100.0, compression: true },
        },
    };
    
    run_hybrid_hpc_workflow(config, config.coupling)
}

