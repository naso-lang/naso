        },
        allocation: ResourceAllocation {
            classical_nodes: 1024,
            quantum_backends: [],
            data_transfer: DataTransferConfig { protocol: TransferProtocol::MPI, bandwidth_gbps: 200.0, compression: false },
        },
    };
    
    run_hybrid_hpc_workflow(config, config.coupling)
}

