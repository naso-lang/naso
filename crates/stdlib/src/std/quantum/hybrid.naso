/// Classical optimization of variational parameters.
/// Runs on CPU between quantum circuit executions.
pub fn classical_optimizer_step<
    const N_PARAMS: usize
>(
    params: inout [1] Tensor[f32, N_PARAMS>,
    gradient: [1] Tensor[f32, N_PARAMS>,
    optimizer_state: inout OptimizerState<N_PARAMS>,
    config: OptimizerConfig
) {
    match config.optimizer {
        OptimizerType::Adam => adam_step(params, gradient, optimizer_state, config),
        OptimizerType::GradientDescent => gd_step(params, gradient, config.learning_rate),
        OptimizerType::L_BFGS => lbfgs_step(params, gradient, optimizer_state, config),
        OptimizerType::SPSA => spsa_step(params, gradient, optimizer_state, config),
    }
}

/// Optimizer state for stateful optimizers.
pub struct OptimizerState<const N_PARAMS: usize> {
    pub m: Tensor[f32, N_PARAMS>,  // Adam first moment
    pub v: Tensor[f32, N_PARAMS>,  // Adam second moment
    pub t: usize,                  // Time step
    pub history: Tensor[f32, 10, N_PARAMS>,  // L-BFGS history
}

impl<const N_PARAMS: usize> OptimizerState<N_PARAMS> {
    pub fn new() -> Self {
        OptimizerState {
            m: tensor_zeros(),
            v: tensor_zeros(),
            t: 0,
            history: tensor_zeros(),
        }
    }
}

/// Optimizer configuration.
pub struct OptimizerConfig {
    pub learning_rate: f32,
    pub optimizer: OptimizerType,
    pub beta1: f32,
    pub beta2: f32,
    pub eps: f32,
}

pub enum OptimizerType {
    Adam,
    GradientDescent,
    L_BFGS,
    SPSA,
}

fn adam_step<const N_PARAMS: usize>(
    params: inout [1] Tensor[f32, N_PARAMS>,
    gradient: [1] Tensor[f32, N_PARAMS>,
    state: inout OptimizerState<N_PARAMS>,
    config: OptimizerConfig
) {
    state.t += 1;
    for i in 0..N_PARAMS {
        state.m[i] = config.beta1 * state.m[i] + (1.0 - config.beta1) * gradient[i];
        state.v[i] = config.beta2 * state.v[i] + (1.0 - config.beta2) * gradient[i] * gradient[i];
        
        let m_hat = state.m[i] / (1.0 - config.beta1.powi(state.t as i32));
        let v_hat = state.v[i] / (1.0 - config.beta2.powi(state.t as i32));
        
        params[i] -= config.learning_rate * m_hat / (sqrt(v_hat) + config.eps);
    }
}

fn gd_step<const N_PARAMS: usize>(
    params: inout [1] Tensor[f32, N_PARAMS>,
    gradient: [1] Tensor[f32, N_PARAMS>,
    lr: f32
) {
    for i in 0..N_PARAMS {
        params[i] -= lr * gradient[i];
    }
}

fn lbfgs_step<const N_PARAMS: usize>(
    params: inout [1] Tensor[f32, N_PARAMS>,
