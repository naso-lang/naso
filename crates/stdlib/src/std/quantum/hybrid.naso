fn tensor_zeros<const N: usize>() -> Tensor[f32, N> {
    Tensor::zeros()
}

fn tensor_zeros<const A: usize, const B: usize>() -> Tensor[f32, A, B> {
    Tensor::zeros()
}

fn tensor_zeros<const A: usize, const B: usize, const C: usize>() -> Tensor[f32, A, B, C> {
    Tensor::zeros()
}

fn min(a: usize, b: usize) -> usize {
    if a < b { a } else { b }
}