/// Compute amplitude encoding angles for state preparation.
/// Classical computation that runs at kernel launch time.
pub fn amplitude_encoding_angles(
    data: [1] Tensor[f32, N]
) -> [1] Tensor[f32, N]
where N: Nat
{
    // Normalize
    var norm_sq = 0.0;
    for i in 0..N {
        norm_sq += data[i] * data[i];
    }
    let norm = sqrt(norm_sq + 1e-12);
    
    var angles: Tensor[f32, N] = tensor_zeros();
    
    // Recursive state preparation angles
    var remaining = 1.0;
    for i in 0..N {
        let amp = data[i] / norm;
        let ratio = amp / (remaining + 1e-12);
        // Clamp to [-1, 1] for numerical stability
        let clamped = if ratio > 1.0 { 1.0 } else if ratio < -1.0 { -1.0 } else { ratio };
        angles[i] = 2.0 * clamped.asin();
        remaining *= cos(angles[i] / 2.0);
    }
    
    angles
}

