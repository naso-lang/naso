        // Initialize all data qubits to |0>
        // Prepare logical |0> by measuring Z stabilizers
        // Prepare logical |+> by measuring X stabilizers
        
        phys
    }
    
    fn measure_syndrome(data: [1] [Qubit; 25]) -> [1] [Syndrome; 24] {
        // Full surface code syndrome measurement requires
        // lattice-specific CNOT patterns
        var syndromes: [Syndrome; 24];
        // ... implementation ...
        syndromes
    }
    
    fn recover(
        data: inout [1] [Qubit; 25],
        syndrome: [1] [Syndrome; 24]
    ) {
        // Minimum-weight perfect matching decoder
        // Classical algorithm - would call external decoder
    }
    
    fn decode(data: [1] [Qubit; 25]) -> [1] Qubit {
        let [1] logical = data[0];
        for i in 1..25 { qfree(data[i]); }
        logical
    }
}

pub type SurfaceCode3 = QEC<SurfaceCode, 3>;
pub type SurfaceCode5 = QEC<SurfaceCode, 5>;

// ============================================================
// Color Code (Triangular)
// ============================================================

pub struct ColorCode;

impl QECCode for ColorCode {
    // Triangular color code distance d: (d^2 + 3d)/2 physical qubits
    const PHYSICAL_QUBITS: usize = 19;  // Distance 3
    const LOGICAL_QUBITS: usize = 1;
    const SYNDROME_BITS: usize = 18;
    const STABILIZERS: usize = 18;
    
    fn encode(logical: [1] Qubit) -> [1] [Qubit; 19] {
        let [1] phys: [Qubit; 19] = qalloc_array(19);
        // Color code encoding uses triangular lattice
        phys
    }
    
    fn measure_syndrome(data: [1] [Qubit; 19]) -> [1] [Syndrome; 18] {
        var syndromes: [Syndrome; 18];
        syndromes
    }
    
    fn recover(
        data: inout [1] [Qubit; 19],
        syndrome: [1] [Syndrome; 18]
    ) {}
    
    fn decode(data: [1] [Qubit; 19]) -> [1] Qubit {
        let [1] logical = data[0];
        for i in 1..19 { qfree(data[i]); }
        logical
    }
}

pub type ColorCode3 = QEC<ColorCode, 3>;

// ============================================================
// Repetition Code (Simple, for demonstration)
// ============================================================

pub struct RepetitionCode<const D: usize>;

impl<const D: usize> QECCode for RepetitionCode<D> {
    const PHYSICAL_QUBITS: usize = D;
    const LOGICAL_QUBITS: usize = 1;
    const SYNDROME_BITS: usize = D - 1;
    const STABILIZERS: usize = D - 1;
    
    fn encode(logical: [1] Qubit) -> [1] [Qubit; D] {
        let [1] phys: [Qubit; D] = qalloc_array(D);
        
        // Copy logical to all physical qubits
        for i in 1..D {
            cnot(logical, phys[i]);
        }
        phys[0] = logical;
        
        phys
    }
    
    fn measure_syndrome(data: [1] [Qubit; D]) -> [1] [Syndrome; D - 1] {
        let [1] ancilla: [Qubit; D - 1] = qalloc_array(D - 1);
        var syndromes: [Syndrome; D - 1];
        
        for i in 0..(D - 1) {
            cnot(data[i], ancilla[i]);
            cnot(data[i + 1], ancilla[i]);
            syndromes[i] = measure(ancilla[i]);
        }
        
        qfree_array(ancilla);
        syndromes
    }
    
    fn recover(
        data: inout [1] [Qubit; D],
        syndrome: [1] [Syndrome; D - 1]
    ) {
        // Majority vote decoding
        // Syndrome pattern indicates which qubit is different
        var flip = false;
        for i in 0..(D - 1) {
            if syndrome[i] { flip = !flip; }
            if flip { pauli_x(data[i]); }
        }
    }
    
    fn decode(data: [1] [Qubit; D]) -> [1] Qubit {
        // Majority vote
        var ones = 0;
        for i in 0..D {
            if measure(data[i]) { ones += 1; }
        }
        // Note: this consumes the qubits
        // In practice, would use a different decoding strategy
        
        let [1] logical = data[0];  // Simplified
        for i in 1..D { qfree(data[i]); }
        logical
    }
}

pub type RepetitionCode3 = QEC<RepetitionCode<3>, 3>;
pub type RepetitionCode5 = QEC<RepetitionCode<5>, 5>;

// ============================================================
// QEC Verification Types (Compile-time proofs)
// ============================================================

/// A proof that a QEC code satisfies the Knill-Laflamme conditions.
/// If this type can be constructed, the code is correct by construction.
pub struct QECProof<CODE: QECCode, DISTANCE> {
    _phantom: PhantomData<(CODE, DISTANCE)>,
}

/// Trait for codes that have a verified proof.
pub trait VerifiedQECCode: QECCode {
    /// The proof that this code is correct.
    const PROOF: QECProof<Self, Self::DISTANCE>;
}

/// Shor code has a verified proof.
impl VerifiedQECCode for ShorCode {
    const PROOF: QECProof<ShorCode, 3> = QECProof { _phantom: PhantomData };
}

/// Steane code has a verified proof.
impl VerifiedQECCode for SteaneCode {
    const PROOF: QECProof<SteaneCode, 3> = QECProof { _phantom: PhantomData };
}

// ============================================================
// QEC Utilities
// ============================================================

/// Run a full QEC cycle: encode -> noise -> syndrome -> recover -> decode.
pub fn qec_cycle<CODE: QECCode>(
    logical: inout [1] Qubit,
    noise_fn: fn([1] [Qubit; CODE::PHYSICAL_QUBITS])
) {
    // Encode
    let [1] encoded: [Qubit; CODE::PHYSICAL_QUBITS] = CODE::encode(logical);
    
    // Apply noise (simulated or real)
    noise_fn(encoded);
    
    // Measure syndrome
    let syndrome = CODE::measure_syndrome(encoded);
    
    // Recover
    CODE::recover(encoded, syndrome);
    
    // Decode
    logical = CODE::decode(encoded);
}

/// Simulated noise channel for testing.
pub fn depolarizing_noise<const N: usize>(
    qubits: [1] [Qubit; N],
    probability: f32
) {
    for i in 0..N {
        if random_f32() < probability {
            match (random_f32() * 3.0) as usize {
                0 => pauli_x(qubits[i]),
                1 => pauli_y(qubits[i]),
                2 => pauli_z(qubits[i]),
                _ => {}
            }
        }
    }
}

/// Generate random f32 in [0, 1).
fn random_f32() -> f32 {
    // Placeholder for RNG
    0.5
}

// ============================================================
// PhantomData for type-level proofs
// ============================================================

pub struct PhantomData<T: ?Sized> {
    _marker: (),
}

impl<T: ?Sized> PhantomData<T> {
    pub const fn new() -> Self {
        PhantomData { _marker: () }
    }
}

impl<T: ?Sized> Clone for PhantomData<T> {
    fn clone(&self) -> Self {
        PhantomData::new()
    }
}

impl<T: ?Sized> Copy for PhantomData<T> {}