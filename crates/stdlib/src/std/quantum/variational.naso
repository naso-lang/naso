// ============================================================
// VQE Example: H2 Ground State
// ============================================================

/// Compute H2 ground state energy with VQE.
pub fn vqe_h2_ground_state() -> f32 {
    let hamiltonian = h2_hamiltonian_sto3g();
    let ansatz = HardwareEfficientAnsatz::<4, 2>;  // 4 qubits, 2 layers = 16 params
    
    var initial_params: Tensor[f32, 16> = tensor_zeros();
    for i in 0..16 {
        initial_params[i] = random_f32() * 0.1;  // Small random init
    }
    
    let config = VQEConfig::default();
    
    let result = vqe_optimize(hamiltonian, ansatz, initial_params, config);
    
    result.ground_state_energy  // Should be ~ -1.137 Hartree
}