}

// ============================================================================
// Lua Scripting Support
// ============================================================================

struct RedisScript {
    sha: String,
    script: String,
    num_keys: usize,
}

impl RedisScript {
    pub fn new(script: &str) -> Self {
        RedisScript {
            sha: String::new(),
            script: script.into(),
            num_keys: 0,
        }
    }
    
    pub fn with_keys(mut self, num_keys: usize) -> Self {
        self.num_keys = num_keys;
        self
    }
    
    pub async fn load(&self, client: &RedisClient) -> Result<String, RedisError> {
        let result = client.execute(&RedisCommand::new("SCRIPT").arg("LOAD").arg(&self.script)).await?;
        let sha = result.as_string()?;
        Ok(sha)
    }
    
    pub async fn eval(&self, client: &RedisClient, keys: &[&str], args: &[impl Into<RedisValue>]) -> Result<RedisValue, RedisError> {
        let mut cmd = RedisCommand::new("EVALSHA").arg(&self.sha).arg(self.num_keys.to_string());
        for key in keys {
            cmd = cmd.arg(*key);
        }
        for arg in args {
            cmd = cmd.arg(arg);
        }
        client.execute(&cmd).await
    }
    
    pub async fn evalsha(&self, client: &RedisClient, keys: &[&str], args: &[impl Into<RedisValue>]) -> Result<RedisValue, RedisError> {
        self.eval(client, keys, args).await
    }
}

// ============================================================================
// Transactions (MULTI/EXEC)
// ============================================================================

struct RedisTransaction {
    client: RedisClient,
    commands: Vec<RedisCommand>,
    watch_keys: Vec<String>,
}

impl RedisTransaction {
    pub fn new(client: RedisClient) -> Self {
        RedisTransaction {
            client,
            commands: Vec::new(),
            watch_keys: Vec::new(),
        }
    }
    
    pub fn watch(&mut self, keys: &[&str]) -> &mut Self {
        self.watch_keys.extend(keys.iter().map(|k| k.to_string()));
        self
    }
    
    pub fn add(&mut self, cmd: RedisCommand) -> &mut Self {
        self.commands.push(cmd);
        self
    }
    
    pub async fn exec(self) -> Result<Vec<RedisValue>, RedisError> {
        // Build MULTI ... EXEC
        let mut pipeline = self.client.pipeline();
        
        if !self.watch_keys.is_empty() {
            pipeline.add(RedisCommand::new("WATCH").args(self.watch_keys.iter().map(|k| k.as_str().into()).collect()));
        }
        
        pipeline.add(RedisCommand::new("MULTI"));
        
        for cmd in self.commands {
            pipeline.add(cmd);
        }
        
        pipeline.add(RedisCommand::new("EXEC"));
        
        pipeline.execute().await
    }
    
    pub async fn discard(self) -> Result<(), RedisError> {
        self.client.execute(&RedisCommand::new("DISCARD")).await?;
        Ok(())
    }
}

// ============================================================================
// Scan Iterators
// ============================================================================

struct ScanIterator {
    client: RedisClient,
    cursor: u64,
    pattern: Option<String>,
    count: usize,
    finished: bool,
}

impl ScanIterator {
    pub fn new(client: RedisClient) -> Self {
        ScanIterator {
            client,
            cursor: 0,
            pattern: None,
            count: 100,
            finished: false,
        }
    }
    
    pub fn pattern(mut self, pattern: &str) -> Self {
        self.pattern = Some(pattern.into());
        self
    }
    
    pub fn count(mut self, count: usize) -> Self {
        self.count = count;
        self
    }
}

impl Iterator for ScanIterator {
    type Item = Result<String, RedisError>;
    
    fn next(&mut self) -> Option<Self::Item> {
        if self.finished {
            return None;
        }
        
        let mut cmd = RedisCommand::new("SCAN").arg(self.cursor.to_string());
        if let Some(ref p) = self.pattern {
            cmd = cmd.arg("MATCH").arg(p);
        }
        cmd = cmd.arg("COUNT").arg(self.count.to_string());
        
        // This is blocking - in real impl would be async
        // For now, return a placeholder
        Some(Ok("key".into()))
    }
}

// ============================================================================
// Cluster Client
// ============================================================================

struct RedisClusterClient {
    nodes: Vec<RedisClient>,
    slots: HashMap<u16, usize>, // slot -> node index
}

impl RedisClusterClient {
    pub fn new(urls: &[String]) -> Result<Self, RedisError> {
        let mut nodes = Vec::new();
        for url in urls {
            let config = RedisConfig::new(url)?;
            let client = RedisClient::new(config)?;
            client.connect().await?;
            nodes.push(client);
        }
        
        // Initialize slot mapping
        let mut cluster = RedisClusterClient {
            nodes,
            slots: HashMap::new(),
        };
        
        cluster.refresh_slots().await?;
        Ok(cluster)
    }
    
    async fn refresh_slots(&mut self) -> Result<(), RedisError> {
        // Query CLUSTER SLOTS from a random node
        if let Some(node) = self.nodes.first() {
            let result = node.execute(&RedisCommand::new("CLUSTER").arg("SLOTS")).await?;
            if let RedisValue::Array(slots) = result {
                for slot_info in slots {
                    if let RedisValue::Array(info) = slot_info {
                        if info.len() >= 3 {
                            if let (RedisValue::Integer(start), RedisValue::Integer(end), RedisValue::Array(node_info)) = 
                                (&info[0], &info[1], &info[2]) {
                                // node_info: [host, port, node_id]
                                if let (RedisValue::String(host), RedisValue::Integer(port)) = (&node_info[0], &node_info[1]) {
                                    let host_str = host.clone();
                                    let port_num = *port as u16;
                                    
                                    // Find or create node for this host:port
                                    let node_idx = self.find_or_create_node(&host_str, port_num).await?;
                                    
                                    for slot in *start as u16..=*end as u16 {
                                        self.slots.insert(slot, node_idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Ok(())
    }
    
    async fn find_or_create_node(&mut self, host: &str, port: u16) -> Result<usize, RedisError> {
        // Check existing nodes
        for (i, node) in self.nodes.iter().enumerate() {
            if node.config.host == host && node.config.port == port {
                return Ok(i);
            }
        }
        
        // Create new node
        let config = RedisConfig::default().host(host).port(port);
        let client = RedisClient::new(config)?;
        client.connect().await?;
        let idx = self.nodes.len();
        self.nodes.push(client);
        Ok(idx)
    }
    
    fn get_node_for_key(&self, key: &str) -> usize {
        // CRC16(key) % 16384
        let slot = crc16(key.as_bytes()) % 16384;
        *self.slots.get(&slot).unwrap_or(&0)
    }
    
    pub async fn execute(&self, cmd: &RedisCommand) -> Result<RedisValue, RedisError> {
        // Extract key from command (simplified - first arg after command name)
        // In real implementation, parse command to find key
        let node_idx = self.get_node_for_key("default");
        self.nodes[node_idx].execute(cmd).await
    }
}

fn crc16(data: &[u8]) -> u16 {
    let mut crc: u16 = 0;
    for &byte in data {
        crc ^= (byte as u16) << 8;
        for _ in 0..8 {
            if crc & 0x8000 != 0 {
                crc = (crc << 1) ^ 0x1021;
            } else {
                crc <<= 1;
            }
        }
    }
    crc
}