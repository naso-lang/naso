// RedisJSON
fn cmd_json_set(key: &str, path: &str, value: &str) -> RedisCommand {
    RedisCommand::new("JSON.SET").arg(key).arg(path).arg(value)
}

fn cmd_json_get(key: &str, path: &str) -> RedisCommand {
    RedisCommand::new("JSON.GET").arg(key).arg(path)
}

fn cmd_json_del(key: &str, path: &str) -> RedisCommand {
    RedisCommand::new("JSON.DEL").arg(key).arg(path)
}

// RedisSearch
fn cmd_ft_create(index: &str, schema: &str) -> RedisCommand {
    RedisCommand::new("FT.CREATE").arg(index).arg("ON").arg("JSON").arg("SCHEMA").arg(schema)
}

fn cmd_ft_search(index: &str, query: &str) -> RedisCommand {
    RedisCommand::new("FT.SEARCH").arg(index).arg(query)
}

// RedisTimeSeries
fn cmd_ts_create(key: &str) -> RedisCommand {
    RedisCommand::new("TS.CREATE").arg(key)
}

fn cmd_ts_add(key: &str, timestamp: u64, value: f64) -> RedisCommand {
    RedisCommand::new("TS.ADD").arg(key).arg(timestamp.to_string()).arg(value.to_string())
}

fn cmd_ts_range(key: &str, from: u64, to: u64) -> RedisCommand {
    RedisCommand::new("TS.RANGE").arg(key).arg(from.to_string()).arg(to.to_string())
}

