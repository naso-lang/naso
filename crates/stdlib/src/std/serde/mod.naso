// ============================================================================
// Value Type (like serde_json::Value)
// ============================================================================

enum Value {
    Null,
    Bool(bool),
    Number(Number),
    String(String),
    Array(Vec<Value>),
    Object(Map<String, Value>),
}

struct Number {
    // Can represent integer, unsigned, or float
    value: NumberValue,
}

enum NumberValue {
    Integer(i64),
    Unsigned(u64),
    Float(f64),
}

impl Number {
    pub fn from_i64(v: i64) -> Self {
        Number { value: NumberValue::Integer(v) }
    }
    
    pub fn from_u64(v: u64) -> Self {
        Number { value: NumberValue::Unsigned(v) }
    }
    
    pub fn from_f64(v: f64) -> Self {
        Number { value: NumberValue::Float(v) }
    }
    
    pub fn as_i64(&self) -> Option<i64> {
        match self.value {
            NumberValue::Integer(v) => Some(v),
            NumberValue::Unsigned(v) => i64::try_from(v).ok(),
            NumberValue::Float(v) => Some(v as i64),
        }
    }
    
    pub fn as_u64(&self) -> Option<u64> {
        match self.value {
            NumberValue::Integer(v) => u64::try_from(v).ok(),
            NumberValue::Unsigned(v) => Some(v),
            NumberValue::Float(v) => Some(v as u64),
        }
    }
    
    pub fn as_f64(&self) -> Option<f64> {
        match self.value {
            NumberValue::Integer(v) => Some(v as f64),
            NumberValue::Unsigned(v) => Some(v as f64),
            NumberValue::Float(v) => Some(v),
        }
    }
}

impl Serialize for Value {
    fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
        match self {
            Value::Null => writer.write_null(),
            Value::Bool(b) => writer.write_bool(*b),
            Value::Number(n) => {
                if let Some(i) = n.as_i64() {
                    writer.write_var_int(i);
                } else if let Some(u) = n.as_u64() {
                    writer.write_var_uint(u);
                } else if let Some(f) = n.as_f64() {
                    writer.write_f64(f);
                }
            }
            Value::String(s) => writer.write_str(s),
            Value::Array(arr) => {
                writer.write_array_start(arr.len());
                for item in arr {
                    item.serialize(writer)?;
                }
            }
            Value::Object(obj) => {
                writer.write_map_start(obj.len());
                for (k, v) in obj {
                    writer.write_str(k);
                    v.serialize(writer)?;
                }
            }
        }
        Ok(())
    }
    
    fn serialize_json(&self) -> Result<String, SerdeError> {
        // Use FFI
        let qtt_bytes = self.to_qtt()?;
        let mut out = vec![0u8; 65536];
        let len = naso_ser_json_serialize(qtt_bytes.as_ptr(), qtt_bytes.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        String::from_utf8(out).map_err(|_| SerdeError::InvalidUtf8)
    }
    
    fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt_bytes = self.to_qtt()?;
        let mut out = vec![0u8; 65536];
        let len = naso_ser_msgpack_serialize(qtt_bytes.as_ptr(), qtt_bytes.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt_bytes = self.to_qtt()?;
        let mut out = vec![0u8; 65536];
        let len = naso_ser_cbor_serialize(qtt_bytes.as_ptr(), qtt_bytes.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt_bytes = self.to_qtt()?;
        let mut out = vec![0u8; 65536];
        let len = naso_ser_bincode_serialize(qtt_bytes.as_ptr(), qtt_bytes.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
}

impl Value {
    fn to_qtt(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        Ok(writer.into_bytes())
    }
}

impl Deserialize for Value {
    fn deserialize(reader: &mut QttReader) -> Result<Self, SerdeError> {
        if reader.remaining() == 0 {
            return Err(SerdeError::UnexpectedEof);
        }
        let tag = reader.buf[reader.pos];
        
        if tag == QttTag::Null as u8 {
            reader.pos += 1;
            return Ok(Value::Null);
        }
        if tag == QttTag::Bool as u8 {
            reader.pos += 1;
            let val = reader.buf[reader.pos] != 0;
            reader.pos += 1;
            return Ok(Value::Bool(val));
        }
        if tag == QttTag::VarInt as u8 || tag == QttTag::VarUInt as u8 || 
           tag == QttTag::I8 as u8 || tag == QttTag::I16 as u8 || tag == QttTag::I32 as u8 || tag == QttTag::I64 as u8 ||
           tag == QttTag::U8 as u8 || tag == QttTag::U16 as u8 || tag == QttTag::U32 as u8 || tag == QttTag::U64 as u8 {
            // Rewind to let typed readers handle it
            let mut num_reader = QttReader::new(&reader.buf[reader.pos - 1..]);
            // Simplified - would need proper number parsing
            reader.pos = reader.buf.len(); // Skip for now
            return Ok(Value::Number(Number::from_i64(0)));
        }
        if tag >= QttTag::StrInline as u8 && tag <= QttTag::Str32 as u8 {
            let s = reader.read_str()?;
            return Ok(Value::String(s.to_string()));
        }
        if tag >= QttTag::ArrayInline as u8 && tag <= QttTag::Array32 as u8 {
            let len = reader.read_array_len()?;
            let mut arr = Vec::with_capacity(len);
            for _ in 0..len {
                arr.push(Value::deserialize(reader)?);
            }
            return Ok(Value::Array(arr));
        }
        if tag >= QttTag::MapInline as u8 && tag <= QttTag::Map32 as u8 {
            let len = reader.read_map_len()?;
            let mut obj = HashMap::new();
            for _ in 0..len {
                let k = reader.read_str()?.to_string();
                let v = Value::deserialize(reader)?;
                obj.insert(k, v);
            }
            return Ok(Value::Object(obj));
        }
        
        Err(SerdeError::InvalidTag(tag))
    }
    
    fn deserialize_json(data: &str) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_json_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Value::deserialize(&mut reader)
    }
    
    fn deserialize_msgpack(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_msgpack_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Value::deserialize(&mut reader)
    }
    
    fn deserialize_cbor(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_cbor_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Value::deserialize(&mut reader)
    }
    
    fn deserialize_bincode(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_bincode_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Value::deserialize(&mut reader)
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum SerdeError {
    UnexpectedEof,
    InvalidTag(u8),
    ExpectedTag(u8, u8),
    VarintOverflow,
    InvalidUtf8,
    SerializationFailed,
    DeserializationFailed,
    InvalidNumber,
    MissingField(String),
    UnknownVariant(String),
    RecursionLimitExceeded,
    Custom(String),
}

impl SerdeError {
    pub fn to_string(&self) -> String {
        match self {
            SerdeError::UnexpectedEof => "Unexpected end of input".into(),
            SerdeError::InvalidTag(tag) => format!("Invalid tag: 0x{:02X}", tag),
            SerdeError::ExpectedTag(expected, found) => format!("Expected tag 0x{:02X}, found 0x{:02X}", expected, found),
            SerdeError::VarintOverflow => "Varint overflow".into(),
            SerdeError::InvalidUtf8 => "Invalid UTF-8".into(),
            SerdeError::SerializationFailed => "Serialization failed".into(),
            SerdeError::DeserializationFailed => "Deserialization failed".into(),
            SerdeError::InvalidNumber => "Invalid number format".into(),
            SerdeError::MissingField(field) => format!("Missing field: {}", field),
            SerdeError::UnknownVariant(variant) => format!("Unknown variant: {}", variant),
            SerdeError::RecursionLimitExceeded => "Recursion limit exceeded".into(),
            SerdeError::Custom(msg) => msg.clone(),
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

impl<T: Serialize> Serialize for Option<T> {
    fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
        match self {
            Some(v) => {
                writer.write_some();
                v.serialize(writer)
            }
            None => {
                writer.write_none();
                Ok(())
            }
        }
    }
    
    fn serialize_json(&self) -> Result<String, SerdeError> {
        match self {
            Some(v) => v.serialize_json(),
            None => Ok("null".into()),
        }
    }
    
    fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
        match self {
            Some(v) => v.serialize_msgpack(),
            None => Ok(vec![0xC0]), // MessagePack nil
        }
    }
    
    fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
        match self {
            Some(v) => v.serialize_cbor(),
            None => Ok(vec![0xF6]), // CBOR null
        }
    }
    
    fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
        match self {
            Some(v) => {
                let mut buf = vec![1u8]; // Some tag
                buf.extend_from_slice(&v.serialize_bincode()?);
                Ok(buf)
            }
            None => Ok(vec![0u8]), // None tag
        }
    }
}

impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize(reader: &mut QttReader) -> Result<Self, SerdeError> {
        let is_some = reader.read_option_tag()?;
        if is_some {
            Ok(Some(T::deserialize(reader)?))
        } else {
            Ok(None)
        }
    }
    
    fn deserialize_json(data: &str) -> Result<Self, SerdeError> {
        if data == "null" {
            Ok(None)
        } else {
            Ok(Some(T::deserialize_json(data)?))
        }
    }
    
    fn deserialize_msgpack(data: &[u8]) -> Result<Self, SerdeError> {
        if data.len() == 1 && data[0] == 0xC0 {
            Ok(None)
        } else {
            Ok(Some(T::deserialize_msgpack(data)?))
        }
    }
    
    fn deserialize_cbor(data: &[u8]) -> Result<Self, SerdeError> {
        if data.len() == 1 && data[0] == 0xF6 {
            Ok(None)
        } else {
            Ok(Some(T::deserialize_cbor(data)?))
        }
    }
    
    fn deserialize_bincode(data: &[u8]) -> Result<Self, SerdeError> {
        if data.is_empty() {
            return Err(SerdeError::UnexpectedEof);
        }
        if data[0] == 0 {
            Ok(None)
        } else {
            Ok(Some(T::deserialize_bincode(&data[1..])?))
        }
    }
}

impl<T: Serialize> Serialize for Vec<T> {
    fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
        writer.write_array_start(self.len());
        for item in self {
            item.serialize(writer)?;
        }
        Ok(())
    }
    
    fn serialize_json(&self) -> Result<String, SerdeError> {
        // Simplified - would use proper JSON array serialization
        let mut result = String::from("[");
        for (i, item) in self.iter().enumerate() {
            if i > 0 {
                result.push(',');
            }
            result.push_str(&item.serialize_json()?);
        }
        result.push(']');
        Ok(result)
    }
    
    fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
        // Use QTT as intermediate
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        // Convert to msgpack via FFI
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_msgpack_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_cbor_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_bincode_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
}

impl<T: Deserialize> Deserialize for Vec<T> {
    fn deserialize(reader: &mut QttReader) -> Result<Self, SerdeError> {
        let len = reader.read_array_len()?;
        let mut vec = Vec::with_capacity(len);
        for _ in 0..len {
            vec.push(T::deserialize(reader)?);
        }
        Ok(vec)
    }
    
    fn deserialize_json(data: &str) -> Result<Self, SerdeError> {
        // Simplified JSON array parsing
        let mut out = vec![0u8; 65536];
        let len = naso_ser_json_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Vec::deserialize(&mut reader)
    }
    
    fn deserialize_msgpack(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_msgpack_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Vec::deserialize(&mut reader)
    }
    
    fn deserialize_cbor(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_cbor_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Vec::deserialize(&mut reader)
    }
    
    fn deserialize_bincode(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_bincode_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        Vec::deserialize(&mut reader)
    }
}

// Implement for String
impl Serialize for String {
    fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
        writer.write_str(self);
        Ok(())
    }
    
    fn serialize_json(&self) -> Result<String, SerdeError> {
        // Escape and quote
        let mut result = String::from("\"");
        for c in self.chars() {
            match c {
                '"' => result.push_str("\\\""),
                '\\' => result.push_str("\\\\"),
                '\n' => result.push_str("\\n"),
                '\r' => result.push_str("\\r"),
                '\t' => result.push_str("\\t"),
                c if c.is_control() => result.push_str(&format!("\\u{:04X}", c as u32)),
                c => result.push(c),
            }
        }
        result.push('"');
        Ok(result)
    }
    
    fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt = self.to_qtt()?;
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_msgpack_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt = self.to_qtt()?;
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_cbor_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
        let qtt = self.to_qtt()?;
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_bincode_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
}

impl String {
    fn to_qtt(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        writer.write_str(self);
        Ok(writer.into_bytes())
    }
}

impl Deserialize for String {
    fn deserialize(reader: &mut QttReader) -> Result<Self, SerdeError> {
        reader.read_str().map(|s| s.to_string())
    }
    
    fn deserialize_json(data: &str) -> Result<Self, SerdeError> {
        // Simplified - would parse JSON string
        if data.starts_with('"') && data.ends_with('"') && data.len() >= 2 {
            let inner = &data[1..data.len()-1];
            // Unescape
            let mut result = String::new();
            let mut chars = inner.chars().peekable();
            while let Some(c) = chars.next() {
                if c == '\\' {
                    if let Some(next) = chars.next() {
                        match next {
                            '"' => result.push('"'),
                            '\\' => result.push('\\'),
                            'n' => result.push('\n'),
                            'r' => result.push('\r'),
                            't' => result.push('\t'),
                            'u' => {
                                // Unicode escape
                                let mut hex = String::new();
                                for _ in 0..4 {
                                    if let Some(h) = chars.next() {
                                        hex.push(h);
                                    }
                                }
                                if let Ok(code) = u32::from_str_radix(&hex, 16) {
                                    if let Some(ch) = char::from_u32(code) {
                                        result.push(ch);
                                    }
                                }
                            }
                            _ => result.push(next),
                        }
                    }
                } else {
                    result.push(c);
                }
            }
            Ok(result)
        } else {
            Err(SerdeError::InvalidUtf8)
        }
    }
    
    fn deserialize_msgpack(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_msgpack_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        String::deserialize(&mut reader)
    }
    
    fn deserialize_cbor(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_cbor_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        String::deserialize(&mut reader)
    }
    
    fn deserialize_bincode(data: &[u8]) -> Result<Self, SerdeError> {
        let mut out = vec![0u8; 65536];
        let len = naso_ser_bincode_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::DeserializationFailed);
        }
        out.truncate(len as usize);
        let mut reader = QttReader::new(&out);
        String::deserialize(&mut reader)
    }
}

// Implement for primitive types
macro_rules! impl_serialize_primitive {
    ($($t:ty => $write:ident),*) => {
        $(
            impl Serialize for $t {
                fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
                    writer.$write(*self);
                    Ok(())
                }
                
                fn serialize_json(&self) -> Result<String, SerdeError> {
                    Ok(self.to_string())
                }
                
                fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
                    let qtt = self.to_qtt()?;
                    let mut out = vec![0u8; qtt.len() * 2];
                    let len = naso_ser_msgpack_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::SerializationFailed);
                    }
                    out.truncate(len as usize);
                    Ok(out)
                }
                
                fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
                    let qtt = self.to_qtt()?;
                    let mut out = vec![0u8; qtt.len() * 2];
                    let len = naso_ser_cbor_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::SerializationFailed);
                    }
                    out.truncate(len as usize);
                    Ok(out)
                }
                
                fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
                    let qtt = self.to_qtt()?;
                    let mut out = vec![0u8; qtt.len() * 2];
                    let len = naso_ser_bincode_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::SerializationFailed);
                    }
                    out.truncate(len as usize);
                    Ok(out)
                }
            }
            
            impl $t {
                fn to_qtt(&self) -> Result<Vec<u8>, SerdeError> {
                    let mut writer = QttWriter::new();
                    writer.$write(*self);
                    Ok(writer.into_bytes())
                }
            }
        )*
    };
}

impl_serialize_primitive!(
    u8 => write_u8,
    u16 => write_u16,
    u32 => write_u32,
    u64 => write_u64,
    i8 => write_i8,
    i16 => write_i16,
    i32 => write_i32,
    i64 => write_i64,
    f32 => write_f32,
    f64 => write_f64,
    bool => write_bool
);

macro_rules! impl_deserialize_primitive {
    ($($t:ty => $read:ident),*) => {
        $(
            impl Deserialize for $t {
                fn deserialize(reader: &mut QttReader) -> Result<Self, SerdeError> {
                    reader.$read()
                }
                
                fn deserialize_json(data: &str) -> Result<Self, SerdeError> {
                    data.parse().map_err(|_| SerdeError::InvalidNumber)
                }
                
                fn deserialize_msgpack(data: &[u8]) -> Result<Self, SerdeError> {
                    let mut out = vec![0u8; 65536];
                    let len = naso_ser_msgpack_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::DeserializationFailed);
                    }
                    out.truncate(len as usize);
                    let mut reader = QttReader::new(&out);
                    reader.$read()
                }
                
                fn deserialize_cbor(data: &[u8]) -> Result<Self, SerdeError> {
                    let mut out = vec![0u8; 65536];
                    let len = naso_ser_cbor_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::DeserializationFailed);
                    }
                    out.truncate(len as usize);
                    let mut reader = QttReader::new(&out);
                    reader.$read()
                }
                
                fn deserialize_bincode(data: &[u8]) -> Result<Self, SerdeError> {
                    let mut out = vec![0u8; 65536];
                    let len = naso_ser_bincode_deserialize(data.as_ptr(), data.len(), out.as_mut_ptr(), out.len());
                    if len == 0 {
                        return Err(SerdeError::DeserializationFailed);
                    }
                    out.truncate(len as usize);
                    let mut reader = QttReader::new(&out);
                    reader.$read()
                }
            }
        )*
    };
}

impl_deserialize_primitive!(
    u8 => read_u8,
    u16 => read_u16,
    u32 => read_u32,
    u64 => read_u64,
    i8 => read_i8,
    i16 => read_i16,
    i32 => read_i32,
    i64 => read_i64,
    f32 => read_f32,
    f64 => read_f64,
    bool => read_bool
);

// ============================================================================
// HashMap and BTreeMap Serialization
// ============================================================================

impl<K: Serialize + Eq + std::hash::Hash, V: Serialize> Serialize for HashMap<K, V> {
    fn serialize(&self, writer: &mut QttWriter) -> Result<(), SerdeError> {
        writer.write_map_start(self.len());
        for (k, v) in self {
            k.serialize(writer)?;
            v.serialize(writer)?;
        }
        Ok(())
    }
    
    fn serialize_json(&self) -> Result<String, SerdeError> {
        // Simplified
        Ok("{}".into())
    }
    
    fn serialize_msgpack(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_msgpack_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_cbor(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_cbor_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
    
    fn serialize_bincode(&self) -> Result<Vec<u8>, SerdeError> {
        let mut writer = QttWriter::new();
        self.serialize(&mut writer)?;
        let qtt = writer.into_bytes();
        let mut out = vec![0u8; qtt.len() * 2];
        let len = naso_ser_bincode_serialize(qtt.as_ptr(), qtt.len(), out.as_mut_ptr(), out.len());
        if len == 0 {
            return Err(SerdeError::SerializationFailed);
        }
        out.truncate(len as usize);
        Ok(out)
    }
}

// ============================================================================
// Async Serialization (for streaming)
// ============================================================================

struct AsyncSerializer<W: AsyncWrite> {
    writer: W,
    buffer: Vec<u8>,
    format: SerializationFormat,
}

impl<W: AsyncWrite> AsyncSerializer<W> {
    pub fn new(writer: W, format: SerializationFormat) -> Self {
        AsyncSerializer {
            writer,
            buffer: Vec::with_capacity(8192),
            format,
        }
    }
    
    pub async fn serialize<T: Serialize>(&mut self, value: &T) -> Result<(), SerdeError> {
        let data = match self.format {
            SerializationFormat::Json => value.serialize_json()?.into_bytes(),
            SerializationFormat::MessagePack => value.serialize_msgpack()?,
            SerializationFormat::Cbor => value.serialize_cbor()?,
            SerializationFormat::Bincode => value.serialize_bincode()?,
            SerializationFormat::Qtt => {
                let mut writer = QttWriter::new();
                value.serialize(&mut writer)?;
                writer.into_bytes()
            }
        };
        
        self.writer.write_all(&data).await.map_err(|e| SerdeError::Custom(e.to_string()))?;
        Ok(())
    }
    
    pub async fn flush(&mut self) -> Result<(), SerdeError> {
        self.writer.flush().await.map_err(|e| SerdeError::Custom(e.to_string()))
    }
}

struct AsyncDeserializer<R: AsyncRead> {
    reader: R,
    buffer: Vec<u8>,
    format: SerializationFormat,
}

impl<R: AsyncRead> AsyncDeserializer<R> {
    pub fn new(reader: R, format: SerializationFormat) -> Self {
        AsyncDeserializer {
            reader,
            buffer: Vec::with_capacity(8192),
            format,
        }
    }
    
    pub async fn deserialize<T: Deserialize>(&mut self) -> Result<T, SerdeError> {
        // Read until we have a complete value
        // This is simplified - real implementation would be incremental
        let mut buf = vec![0u8; 65536];
        let n = self.reader.read(&mut buf).await.map_err(|e| SerdeError::Custom(e.to_string()))?;
        buf.truncate(n);
        
        match self.format {
            SerializationFormat::Json => {
                let json = String::from_utf8(buf).map_err(|_| SerdeError::InvalidUtf8)?;
                T::deserialize_json(&json)
            }
            SerializationFormat::MessagePack => T::deserialize_msgpack(&buf),
            SerializationFormat::Cbor => T::deserialize_cbor(&buf),
            SerializationFormat::Bincode => T::deserialize_bincode(&buf),
            SerializationFormat::Qtt => {
                let mut reader = QttReader::new(&buf);
                T::deserialize(&mut reader)
            }
        }
    }
}