// ============================================================================
// Naso SQL Driver (naso_sql) - Phase 19.5
// ============================================================================
// Database abstraction layer with support for PostgreSQL, MySQL, SQLite
// Connection pooling, prepared statements, transactions, async support
// ============================================================================

extern "C" {
    fn naso_sql_pool_new(config_ptr: *const u8, config_len: usize) -> u64;
    fn naso_sql_pool_acquire(pool: u64) -> u64;
    fn naso_sql_pool_release(pool: u64, conn: u64) -> u64;
    fn naso_sql_pool_free(pool: u64);
    fn naso_sql_conn_execute(conn: u64, query_ptr: *const u8, query_len: usize, params_ptr: *const u8, params_len: usize, result_ptr: *mut u8, result_max_len: usize) -> u64;
    fn naso_sql_conn_query(conn: u64, query_ptr: *const u8, query_len: usize, params_ptr: *const u8, params_len: usize, result_ptr: *mut u8, result_max_len: usize) -> u64;
    fn naso_sql_conn_prepare(conn: u64, query_ptr: *const u8, query_len: usize) -> u64;
    fn naso_sql_stmt_execute(stmt: u64, params_ptr: *const u8, params_len: usize, result_ptr: *mut u8, result_max_len: usize) -> u64;
    fn naso_sql_stmt_query(stmt: u64, params_ptr: *const u8, params_len: usize, result_ptr: *mut u8, result_max_len: usize) -> u64;
    fn naso_sql_stmt_free(stmt: u64);
    fn naso_sql_tx_begin(conn: u64) -> u64;
    fn naso_sql_tx_commit(tx: u64) -> u64;
    fn naso_sql_tx_rollback(tx: u64) -> u64;
    fn naso_sql_conn_close(conn: u64);
}

// ============================================================================
// Database Configuration
// ============================================================================

enum DatabaseType {
    Postgres,
    MySql,
    Sqlite,
}

struct DatabaseConfig {
    db_type: DatabaseType,
    host: String,
    port: u16,
    database: String,
    username: String,
    password: String,
    // Pool settings
    max_connections: usize,
    min_connections: usize,
    acquire_timeout_ms: u64,
    idle_timeout_ms: u64,
    max_lifetime_ms: u64,
    // SSL/TLS
    ssl_mode: SslMode,
    ssl_ca: Option<String>,
    ssl_cert: Option<String>,
    ssl_key: Option<String>,
    // SQLite specific
    sqlite_path: Option<String>,
    sqlite_journal_mode: SqliteJournalMode,
    // Extra options
    options: HashMap<String, String>,
}

enum SslMode {
    Disable,
    Allow,
    Prefer,
    Require,
    VerifyCa,
    VerifyFull,
}

enum SqliteJournalMode {
    Delete,
    Truncate,
    Persist,
    Memory,
    Wal,
    Off,
}

impl Default for DatabaseConfig {
    fn default() -> Self {
        DatabaseConfig {
            db_type: DatabaseType::Postgres,
            host: "localhost".into(),
            port: 5432,
            database: "postgres".into(),
            username: "postgres".into(),
            password: "".into(),
            max_connections: 10,
            min_connections: 0,
            acquire_timeout_ms: 30000,
            idle_timeout_ms: 600000, // 10 minutes
            max_lifetime_ms: 1800000, // 30 minutes
            ssl_mode: SslMode::Prefer,
            ssl_ca: None,
            ssl_cert: None,
            ssl_key: None,
            sqlite_path: None,
            sqlite_journal_mode: SqliteJournalMode::Wal,
            options: HashMap::new(),
        }
    }
}

impl DatabaseConfig {
    pub fn postgres() -> Self {
        DatabaseConfig {
            db_type: DatabaseType::Postgres,
            port: 5432,
            ..Default::default()
        }
    }
    
    pub fn mysql() -> Self {
        DatabaseConfig {
            db_type: DatabaseType::MySql,
            port: 3306,
            ..Default::default()
        }
    }
    
    pub fn sqlite(path: &str) -> Self {
        DatabaseConfig {
            db_type: DatabaseType::Sqlite,
            sqlite_path: Some(path.into()),
            ..Default::default()
        }
    }
    
    pub fn host(mut self, host: &str) -> Self {
        self.host = host.into();
        self
    }
    
    pub fn port(mut self, port: u16) -> Self {
        self.port = port;
        self
    }
    
    pub fn database(mut self, database: &str) -> Self {
        self.database = database.into();
        self
    }
    
    pub fn username(mut self, username: &str) -> Self {
        self.username = username.into();
        self
    }
    
    pub fn password(mut self, password: &str) -> Self {
        self.password = password.into();
        self
    }
    
    pub fn max_connections(mut self, max: usize) -> Self {
        self.max_connections = max;
        self
    }
    
    pub fn ssl_mode(mut self, mode: SslMode) -> Self {
        self.ssl_mode = mode;
        self
    }
    
    pub fn option(mut self, key: &str, value: &str) -> Self {
        self.options.insert(key.into(), value.into());
        self
    }
    
    fn to_json(&self) -> String {
        // Simplified JSON serialization for FFI
        let ssl_mode_str = match self.ssl_mode {
            SslMode::Disable => "disable",
            SslMode::Allow => "allow",
            SslMode::Prefer => "prefer",
            SslMode::Require => "require",
            SslMode::VerifyCa => "verify-ca",
            SslMode::VerifyFull => "verify-full",
        };
        
        let journal_mode_str = match self.sqlite_journal_mode {
            SqliteJournalMode::Delete => "DELETE",
            SqliteJournalMode::Truncate => "TRUNCATE",
            SqliteJournalMode::Persist => "PERSIST",
            SqliteJournalMode::Memory => "MEMORY",
            SqliteJournalMode::Wal => "WAL",
            SqliteJournalMode::Off => "OFF",
        };
        
        format!(
            "{{\"type\":\"{}\",\"host\":\"{}\",\"port\":{},\"database\":\"{}\",\"username\":\"{}\",\"password\":\"{}\",\"max_connections\":{},\"min_connections\":{},\"acquire_timeout_ms\":{},\"idle_timeout_ms\":{},\"max_lifetime_ms\":{},\"ssl_mode\":\"{}\",\"sqlite_path\":{},\"sqlite_journal_mode\":\"{}\"}}",
            match self.db_type {
                DatabaseType::Postgres => "postgres",
                DatabaseType::MySql => "mysql",
                DatabaseType::Sqlite => "sqlite",
            },
            self.host,
            self.port,
            self.database,
            self.username,
            self.password,
            self.max_connections,
            self.min_connections,
            self.acquire_timeout_ms,
            self.idle_timeout_ms,
            self.max_lifetime_ms,
            ssl_mode_str,
            self.sqlite_path.as_ref().map(|p| format!("\"{}\"", p)).unwrap_or("null".into()),
            journal_mode_str
        )
    }
}

// ============================================================================
// Connection Pool
// ============================================================================

struct SqlPool {
    inner: u64,
    config: DatabaseConfig,
}

impl SqlPool {
    pub fn new(config: DatabaseConfig) -> Result<Self, SqlError> {
        let config_json = config.to_json();
        let inner = naso_sql_pool_new(config_json.as_ptr(), config_json.len());
        if inner == 0 {
            return Err(SqlError::PoolCreationFailed);
        }
        Ok(SqlPool { inner, config })
    }
    
    pub async fn acquire(&self) -> Result<SqlConnection, SqlError> {
        let conn_inner = naso_sql_pool_acquire(self.inner);
        if conn_inner == 0 {
            return Err(SqlError::PoolExhausted);
        }
        Ok(SqlConnection { inner: conn_inner, pool: self.inner })
    }
    
    pub fn release(&self, conn: SqlConnection) -> Result<(), SqlError> {
        let result = naso_sql_pool_release(self.inner, conn.inner);
        if result == 0 {
            return Err(SqlError::PoolReleaseFailed);
        }
        Ok(())
    }
    
    pub fn config(&self) -> &DatabaseConfig {
        &self.config
    }
}

impl Drop for SqlPool {
    fn drop(&mut self) {
        naso_sql_pool_free(self.inner);
    }
}

// ============================================================================
// Connection
// ============================================================================

struct SqlConnection {
    inner: u64,
    pool: u64,
}

impl SqlConnection {
    pub async fn execute(&self, query: &str, params: &[SqlValue]) -> Result<u64, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 4096];
        let affected = naso_sql_conn_execute(
            self.inner,
            query.as_ptr(),
            query.len(),
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if affected == u64::MAX {
            return Err(SqlError::ExecutionFailed);
        }
        Ok(affected)
    }
    
    pub async fn query(&self, query: &str, params: &[SqlValue]) -> Result<SqlRows, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 65536];
        let len = naso_sql_conn_query(
            self.inner,
            query.as_ptr(),
            query.len(),
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if len == 0 {
            return Err(SqlError::QueryFailed);
        }
        result.truncate(len as usize);
        SqlRows::from_json(&result)
    }
    
    pub async fn query_one(&self, query: &str, params: &[SqlValue]) -> Result<SqlRow, SqlError> {
        let rows = self.query(query, params).await?;
        rows.into_iter().next().ok_or(SqlError::NoRowsReturned)
    }
    
    pub async fn query_scalar<T: FromSql>(&self, query: &str, params: &[SqlValue]) -> Result<T, SqlError> {
        let row = self.query_one(query, params).await?;
        row.get(0)
    }
    
    pub fn prepare(&self, query: &str) -> Result<SqlStatement, SqlError> {
        let stmt = naso_sql_conn_prepare(self.inner, query.as_ptr(), query.len());
        if stmt == 0 {
            return Err(SqlError::PrepareFailed);
        }
        Ok(SqlStatement { inner: stmt, query: query.to_string() })
    }
    
    pub async fn begin(&self) -> Result<SqlTransaction, SqlError> {
        let tx = naso_sql_tx_begin(self.inner);
        if tx == 0 {
            return Err(SqlError::TransactionBeginFailed);
        }
        Ok(SqlTransaction { inner: tx, conn: self.inner, committed: false, rolled_back: false })
    }
    
    pub fn close(self) {
        naso_sql_conn_close(self.inner);
    }
}

impl Drop for SqlConnection {
    fn drop(&mut self) {
        // Return to pool automatically
        naso_sql_pool_release(self.pool, self.inner);
    }
}

// ============================================================================
// Statement
// ============================================================================

struct SqlStatement {
    inner: u64,
    query: String,
}

impl SqlStatement {
    pub async fn execute(&self, params: &[SqlValue]) -> Result<u64, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 4096];
        let affected = naso_sql_stmt_execute(
            self.inner,
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if affected == u64::MAX {
            return Err(SqlError::ExecutionFailed);
        }
        Ok(affected)
    }
    
    pub async fn query(&self, params: &[SqlValue]) -> Result<SqlRows, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 65536];
        let len = naso_sql_stmt_query(
            self.inner,
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if len == 0 {
            return Err(SqlError::QueryFailed);
        }
        result.truncate(len as usize);
        SqlRows::from_json(&result)
    }
    
    pub async fn query_one(&self, params: &[SqlValue]) -> Result<SqlRow, SqlError> {
        let rows = self.query(params).await?;
        rows.into_iter().next().ok_or(SqlError::NoRowsReturned)
    }
}

impl Drop for SqlStatement {
    fn drop(&mut self) {
        naso_sql_stmt_free(self.inner);
    }
}

// ============================================================================
// Transaction
// ============================================================================

struct SqlTransaction {
    inner: u64,
    conn: u64,
    committed: bool,
    rolled_back: bool,
}

impl SqlTransaction {
    pub async fn execute(&self, query: &str, params: &[SqlValue]) -> Result<u64, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 4096];
        let affected = naso_sql_conn_execute(
            self.inner,
            query.as_ptr(),
            query.len(),
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if affected == u64::MAX {
            return Err(SqlError::ExecutionFailed);
        }
        Ok(affected)
    }
    
    pub async fn query(&self, query: &str, params: &[SqlValue]) -> Result<SqlRows, SqlError> {
        let params_json = params_to_json(params)?;
        let mut result = vec![0u8; 65536];
        let len = naso_sql_conn_query(
            self.inner,
            query.as_ptr(),
            query.len(),
            params_json.as_ptr(),
            params_json.len(),
            result.as_mut_ptr(),
            result.len(),
        );
        if len == 0 {
            return Err(SqlError::QueryFailed);
        }
        result.truncate(len as usize);
        SqlRows::from_json(&result)
    }
    
    pub async fn commit(self) -> Result<(), SqlError> {
        if self.committed || self.rolled_back {
            return Err(SqlError::TransactionAlreadyClosed);
        }
        let result = naso_sql_tx_commit(self.inner);
        if result == 0 {
            return Err(SqlError::TransactionCommitFailed);
        }
        // Mark as committed (can't easily set self.committed = true due to move)
        Ok(())
    }
    
    pub async fn rollback(self) -> Result<(), SqlError> {
        if self.committed || self.rolled_back {
            return Err(SqlError::TransactionAlreadyClosed);
        }
        let result = naso_sql_tx_rollback(self.inner);
        if result == 0 {
            return Err(SqlError::TransactionRollbackFailed);
        }
        Ok(())
    }
}

impl Drop for SqlTransaction {
    fn drop(&mut self) {
        if !self.committed && !self.rolled_back {
            // Auto-rollback on drop
            naso_sql_tx_rollback(self.inner);
        }
    }
}

// ============================================================================
// Rows and Row
// ============================================================================

struct SqlRows {
    columns: Vec<String>,
    rows: Vec<Vec<SqlValue>>,
    current: usize,
}

impl SqlRows {
    fn from_json(data: &[u8]) -> Result<Self, SqlError> {
        // Simplified JSON parsing
        let json_str = unsafe { std::str::from_utf8_unchecked(data) };
        // In real implementation, parse JSON to extract columns and rows
        Ok(SqlRows {
            columns: Vec::new(),
            rows: Vec::new(),
            current: 0,
        })
    }
    
    pub fn columns(&self) -> &[String] {
        &self.columns
    }
    
    pub fn len(&self) -> usize {
        self.rows.len()
    }
    
    pub fn is_empty(&self) -> bool {
        self.rows.is_empty()
    }
}

impl Iterator for SqlRows {
    type Item = SqlRow;
    
    fn next(&mut self) -> Option<Self::Item> {
        if self.current < self.rows.len() {
            let row = SqlRow {
                columns: self.columns.clone(),
                values: self.rows[self.current].clone(),
            };
            self.current += 1;
            Some(row)
        } else {
            None
        }
    }
}

struct SqlRow {
    columns: Vec<String>,
    values: Vec<SqlValue>,
}

impl SqlRow {
    pub fn get<T: FromSql>(&self, index: usize) -> Result<T, SqlError> {
        if index >= self.values.len() {
            return Err(SqlError::ColumnIndexOutOfBounds);
        }
        T::from_sql(&self.values[index])
    }
    
    pub fn get_by_name<T: FromSql>(&self, name: &str) -> Result<T, SqlError> {
        let index = self.columns.iter().position(|c| c == name).ok_or(SqlError::ColumnNotFound)?;
        self.get(index)
    }
    
    pub fn try_get<T: FromSql>(&self, index: usize) -> Result<Option<T>, SqlError> {
        if index >= self.values.len() {
            return Ok(None);
        }
        match T::from_sql(&self.values[index]) {
            Ok(v) => Ok(Some(v)),
            Err(SqlError::NullValue) => Ok(None),
            Err(e) => Err(e),
        }
    }
    
    pub fn len(&self) -> usize {
        self.values.len()
    }
}

// ============================================================================
// SQL Values
// ============================================================================

enum SqlValue {
    Null,
    Bool(bool),
    I16(i16),
    I32(i32),
    I64(i64),
    F32(f32),
    F64(f64),
    String(String),
    Bytes(Vec<u8>),
    Uuid([u8; 16]),
    Json(Value),
    Date(Date),
    Time(Time),
    DateTime(DateTime),
    Array(Vec<SqlValue>),
}

struct Date {
    year: i32,
    month: u8,
    day: u8,
}

struct Time {
    hour: u8,
    minute: u8,
    second: u8,
    nanosecond: u32,
}

struct DateTime {
    date: Date,
    time: Time,
    timezone: Option<String>,
}

fn params_to_json(params: &[SqlValue]) -> Result<Vec<u8>, SqlError> {
    // Simplified - would serialize params to JSON
    Ok(b"[]".to_vec())
}

// ============================================================================
// FromSql Trait
// ============================================================================

trait FromSql: Sized {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError>;
}

impl FromSql for bool {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::Bool(b) => Ok(*b),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for i16 {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::I16(v) => Ok(*v),
            SqlValue::I32(v) => Ok(*v as i16),
            SqlValue::I64(v) => Ok(*v as i16),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for i32 {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::I32(v) => Ok(*v),
            SqlValue::I16(v) => Ok(*v as i32),
            SqlValue::I64(v) => Ok(*v as i32),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for i64 {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::I64(v) => Ok(*v),
            SqlValue::I32(v) => Ok(*v as i64),
            SqlValue::I16(v) => Ok(*v as i64),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for f32 {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::F32(v) => Ok(*v),
            SqlValue::F64(v) => Ok(*v as f32),
            SqlValue::I32(v) => Ok(*v as f32),
            SqlValue::I64(v) => Ok(*v as f32),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for f64 {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::F64(v) => Ok(*v),
            SqlValue::F32(v) => Ok(*v as f64),
            SqlValue::I32(v) => Ok(*v as f64),
            SqlValue::I64(v) => Ok(*v as f64),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for String {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::String(s) => Ok(s.clone()),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for Vec<u8> {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::Bytes(b) => Ok(b.clone()),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl FromSql for Value {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::Json(v) => Ok(v.clone()),
            SqlValue::Null => Err(SqlError::NullValue),
            _ => Err(SqlError::TypeMismatch),
        }
    }
}

impl<T: FromSql> FromSql for Option<T> {
    fn from_sql(value: &SqlValue) -> Result<Self, SqlError> {
        match value {
            SqlValue::Null => Ok(None),
            _ => Ok(Some(T::from_sql(value)?)),
        }
    }
}

// ============================================================================
// ToSql Trait (for parameters)
// ============================================================================

trait ToSql {
    fn to_sql(&self) -> SqlValue;
}

impl ToSql for bool {
    fn to_sql(&self) -> SqlValue {
        SqlValue::Bool(*self)
    }
}

impl ToSql for i16 {
    fn to_sql(&self) -> SqlValue {
        SqlValue::I16(*self)
    }
}

impl ToSql for i32 {
    fn to_sql(&self) -> SqlValue {
        SqlValue::I32(*self)
    }
}

impl ToSql for i64 {
    fn to_sql(&self) -> SqlValue {
        SqlValue::I64(*self)
    }
}

impl ToSql for f32 {
    fn to_sql(&self) -> SqlValue {
        SqlValue::F32(*self)
    }
}

impl ToSql for f64 {
    fn to_sql(&self) -> SqlValue {
        SqlValue::F64(*self)
    }
}

impl ToSql for &str {
    fn to_sql(&self) -> SqlValue {
        SqlValue::String(self.to_string())
    }
}

impl ToSql for String {
    fn to_sql(&self) -> SqlValue {
        SqlValue::String(self.clone())
    }
}

impl ToSql for &[u8] {
    fn to_sql(&self) -> SqlValue {
        SqlValue::Bytes(self.to_vec())
    }
}

impl ToSql for Vec<u8> {
    fn to_sql(&self) -> SqlValue {
        SqlValue::Bytes(self.clone())
    }
}

impl ToSql for Value {
    fn to_sql(&self) -> SqlValue {
        SqlValue::Json(self.clone())
    }
}

impl<T: ToSql> ToSql for Option<T> {
    fn to_sql(&self) -> SqlValue {
        match self {
            Some(v) => v.to_sql(),
            None => SqlValue::Null,
        }
    }
}

// ============================================================================
// Error Types
// ============================================================================

enum SqlError {
    PoolCreationFailed,
    PoolExhausted,
    PoolReleaseFailed,
    ExecutionFailed,
    QueryFailed,
    PrepareFailed,
    TransactionBeginFailed,
    TransactionCommitFailed,
    TransactionRollbackFailed,
    TransactionAlreadyClosed,
    NoRowsReturned,
    ColumnIndexOutOfBounds,
    ColumnNotFound,
    TypeMismatch,
    NullValue,
    ConnectionClosed,
    InvalidParameterCount,
    ConstraintViolation(String),
    DeadlockDetected,
    SerializationFailure,
    FeatureNotSupported(String),
    IoError(IoError),
    TlsError(TlsError),
    MigrationError(String),
}

impl SqlError {
    pub fn to_string(&self) -> String {
        match self {
            SqlError::PoolCreationFailed => "Failed to create connection pool".into(),
            SqlError::PoolExhausted => "Connection pool exhausted".into(),
            SqlError::PoolReleaseFailed => "Failed to release connection".into(),
            SqlError::ExecutionFailed => "Query execution failed".into(),
            SqlError::QueryFailed => "Query failed".into(),
            SqlError::PrepareFailed => "Statement preparation failed".into(),
            SqlError::TransactionBeginFailed => "Failed to begin transaction".into(),
            SqlError::TransactionCommitFailed => "Failed to commit transaction".into(),
            SqlError::TransactionRollbackFailed => "Failed to rollback transaction".into(),
            SqlError::TransactionAlreadyClosed => "Transaction already closed".into(),
            SqlError::NoRowsReturned => "No rows returned".into(),
            SqlError::ColumnIndexOutOfBounds => "Column index out of bounds".into(),
            SqlError::ColumnNotFound => "Column not found".into(),
            SqlError::TypeMismatch => "Type mismatch".into(),
            SqlError::NullValue => "Unexpected NULL value".into(),
            SqlError::ConnectionClosed => "Connection closed".into(),
            SqlError::InvalidParameterCount => "Invalid parameter count".into(),
            SqlError::ConstraintViolation(msg) => format!("Constraint violation: {}", msg),
            SqlError::DeadlockDetected => "Deadlock detected".into(),
            SqlError::SerializationFailure => "Serialization failure".into(),
            SqlError::FeatureNotSupported(msg) => format!("Feature not supported: {}", msg),
            SqlError::IoError(e) => format!("I/O error: {}", e.to_string()),
            SqlError::TlsError(e) => format!("TLS error: {}", e.to_string()),
            SqlError::MigrationError(msg) => format!("Migration error: {}", msg),
        }
    }
}

// ============================================================================
// Migration Support
// ============================================================================

struct Migration {
    version: u64,
    name: String,
    up_sql: String,
    down_sql: Option<String>,
}

struct MigrationRunner {
    pool: SqlPool,
    migrations: Vec<Migration>,
    table_name: String,
}

impl MigrationRunner {
    pub fn new(pool: SqlPool) -> Self {
        MigrationRunner {
            pool,
            migrations: Vec::new(),
            table_name: "_migrations".into(),
        }
    }
    
    pub fn add_migration(&mut self, version: u64, name: &str, up_sql: &str, down_sql: Option<&str>) {
        self.migrations.push(Migration {
            version,
            name: name.into(),
            up_sql: up_sql.into(),
            down_sql: down_sql.map(|s| s.into()),
        });
        // Sort by version
        self.migrations.sort_by_key(|m| m.version);
    }
    
    pub async fn run(&self) -> Result<Vec<u64>, SqlError> {
        let conn = self.pool.acquire().await?;
        
        // Create migrations table if not exists
        conn.execute(
            &format!(
                "CREATE TABLE IF NOT EXISTS {} (version BIGINT PRIMARY KEY, name TEXT, applied_at TIMESTAMP DEFAULT NOW())",
                self.table_name
            ),
            &[],
        ).await?;
        
        // Get applied migrations
        let applied: Vec<u64> = conn.query(
            &format!("SELECT version FROM {} ORDER BY version", self.table_name),
            &[],
        ).await?
        .into_iter()
        .filter_map(|row| row.get(0).ok())
        .collect();
        
        let mut applied_versions = std::collections::HashSet::new();
        for v in applied {
            applied_versions.insert(v);
        }
        
        let mut newly_applied = Vec::new();
        
        for migration in &self.migrations {
            if !applied_versions.contains(&migration.version) {
                // Run migration in transaction
                let mut tx = conn.begin().await?;
                tx.execute(&migration.up_sql, &[]).await?;
                tx.execute(
                    &format!("INSERT INTO {} (version, name) VALUES (?, ?)", self.table_name),
                    &[migration.version.to_sql(), migration.name.to_sql()],
                ).await?;
                tx.commit().await?;
                newly_applied.push(migration.version);
            }
        }
        
        Ok(newly_applied)
    }
    
    pub async fn rollback(&self, target_version: u64) -> Result<Vec<u64>, SqlError> {
        let conn = self.pool.acquire().await?;
        
        let applied: Vec<(u64, Option<String>)> = conn.query(
            &format!("SELECT version, down_sql FROM {} WHERE version > ? ORDER BY version DESC", self.table_name),
            &[target_version.to_sql()],
        ).await?
        .into_iter()
        .filter_map(|row| {
            let version: u64 = row.get(0).ok()?;
            let down_sql: Option<String> = row.try_get(1).ok().flatten();
            Some((version, down_sql))
        })
        .collect();
        
        let mut rolled_back = Vec::new();
        
        for (version, down_sql) in applied {
            if let Some(down_sql) = down_sql {
                let mut tx = conn.begin().await?;
                tx.execute(&down_sql, &[]).await?;
                tx.execute(
                    &format!("DELETE FROM {} WHERE version = ?", self.table_name),
                    &[version.to_sql()],
                ).await?;
                tx.commit().await?;
                rolled_back.push(version);
            } else {
                return Err(SqlError::MigrationError(format!("No down migration for version {}", version)));
            }
        }
        
        Ok(rolled_back)
    }
}

// ============================================================================
// Query Builder (Fluent API)
// ============================================================================

struct SelectQuery {
    table: String,
    columns: Vec<String>,
    where_clauses: Vec<WhereClause>,
    joins: Vec<JoinClause>,
    order_by: Vec<OrderBy>,
    limit: Option<u64>,
    offset: Option<u64>,
    group_by: Vec<String>,
    having: Vec<WhereClause>,
}

struct WhereClause {
    column: String,
    operator: WhereOperator,
    value: SqlValue,
    conjunction: Conjunction,
}

enum WhereOperator {
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    Like,
    ILike,
    In,
    NotIn,
    IsNull,
    IsNotNull,
    Between,
    NotBetween,
}

enum Conjunction {
    And,
    Or,
}

struct JoinClause {
    join_type: JoinType,
    table: String,
    on_condition: String,
}

enum JoinType {
    Inner,
    Left,
    Right,
    Full,
    Cross,
}

struct OrderBy {
    column: String,
    ascending: bool,
}

impl SelectQuery {
    pub fn new(table: &str) -> Self {
        SelectQuery {
            table: table.into(),
            columns: vec!["*".into()],
            where_clauses: Vec::new(),
            joins: Vec::new(),
            order_by: Vec::new(),
            limit: None,
            offset: None,
            group_by: Vec::new(),
            having: Vec::new(),
        }
    }
    
    pub fn columns(mut self, columns: &[&str]) -> Self {
        self.columns = columns.iter().map(|s| s.to_string()).collect();
        self
    }
    
    pub fn where_eq(mut self, column: &str, value: impl ToSql) -> Self {
        self.where_clauses.push(WhereClause {
            column: column.into(),
            operator: WhereOperator::Eq,
            value: value.to_sql(),
            conjunction: Conjunction::And,
        });
        self
    }
    
    pub fn where_in(mut self, column: &str, values: Vec<impl ToSql>) -> Self {
        self.where_clauses.push(WhereClause {
            column: column.into(),
            operator: WhereOperator::In,
            value: SqlValue::Array(values.into_iter().map(|v| v.to_sql()).collect()),
            conjunction: Conjunction::And,
        });
        self
    }
    
    pub fn join(mut self, join_type: JoinType, table: &str, on: &str) -> Self {
        self.joins.push(JoinClause {
            join_type,
            table: table.into(),
            on_condition: on.into(),
        });
        self
    }
    
    pub fn order_by(mut self, column: &str, ascending: bool) -> Self {
        self.order_by.push(OrderBy {
            column: column.into(),
            ascending,
        });
        self
    }
    
    pub fn limit(mut self, limit: u64) -> Self {
        self.limit = Some(limit);
        self
    }
    
    pub fn offset(mut self, offset: u64) -> Self {
        self.offset = Some(offset);
        self
    }
    
    pub fn group_by(mut self, columns: &[&str]) -> Self {
        self.group_by = columns.iter().map(|s| s.to_string()).collect();
        self
    }
    
    pub fn build(self) -> (String, Vec<SqlValue>) {
        let mut sql = String::new();
        let mut params = Vec::new();
        
        sql.push_str("SELECT ");
        sql.push_str(&self.columns.join(", "));
        sql.push_str(" FROM ");
        sql.push_str(&self.table);
        
        for join in &self.joins {
            let join_str = match join.join_type {
                JoinType::Inner => "INNER JOIN",
                JoinType::Left => "LEFT JOIN",
                JoinType::Right => "RIGHT JOIN",
                JoinType::Full => "FULL JOIN",
                JoinType::Cross => "CROSS JOIN",
            };
            sql.push_str(&format!(" {} {} ON {}", join_str, join.table, join.on_condition));
        }
        
        if !self.where_clauses.is_empty() {
            sql.push_str(" WHERE ");
            for (i, clause) in self.where_clauses.iter().enumerate() {
                if i > 0 {
                    sql.push_str(if matches!(clause.conjunction, Conjunction::And) { " AND " } else { " OR " });
                }
                sql.push_str(&clause.column);
                sql.push(' ');
                match clause.operator {
                    WhereOperator::Eq => sql.push_str("= ?"),
                    WhereOperator::Ne => sql.push_str("!= ?"),
                    WhereOperator::Lt => sql.push_str("< ?"),
                    WhereOperator::Le => sql.push_str("<= ?"),
                    WhereOperator::Gt => sql.push_str("> ?"),
                    WhereOperator::Ge => sql.push_str(">= ?"),
                    WhereOperator::Like => sql.push_str("LIKE ?"),
                    WhereOperator::ILike => sql.push_str("ILIKE ?"),
                    WhereOperator::In => sql.push_str("IN ?"),
                    WhereOperator::NotIn => sql.push_str("NOT IN ?"),
                    WhereOperator::IsNull => { sql.push_str("IS NULL"); continue; }
                    WhereOperator::IsNotNull => { sql.push_str("IS NOT NULL"); continue; }
                    WhereOperator::Between => sql.push_str("BETWEEN ? AND ?"),
                    WhereOperator::NotBetween => sql.push_str("NOT BETWEEN ? AND ?"),
                }
                params.push(clause.value.clone());
            }
        }
        
        if !self.group_by.is_empty() {
            sql.push_str(" GROUP BY ");
            sql.push_str(&self.group_by.join(", "));
        }
        
        if !self.having.is_empty() {
            sql.push_str(" HAVING ");
            // Similar to where
        }
        
        if !self.order_by.is_empty() {
            sql.push_str(" ORDER BY ");
            for (i, ob) in self.order_by.iter().enumerate() {
                if i > 0 {
                    sql.push_str(", ");
                }
                sql.push_str(&ob.column);
                sql.push_str(if ob.ascending { " ASC" } else { " DESC" });
            }
        }
        
        if let Some(limit) = self.limit {
            sql.push_str(&format!(" LIMIT {}", limit));
        }
        
        if let Some(offset) = self.offset {
            sql.push_str(&format!(" OFFSET {}", offset));
        }
        
        (sql, params)
    }
}

async fn select<T: FromSql>(pool: &SqlPool, query: SelectQuery) -> Result<Vec<T>, SqlError> {
    let (sql, params) = query.build();
    let conn = pool.acquire().await?;
    let rows = conn.query(&sql, &params).await?;
    let mut results = Vec::new();
    for row in rows {
        results.push(T::from_sql(&row.values[0])?); // Simplified
    }
    Ok(results)
}