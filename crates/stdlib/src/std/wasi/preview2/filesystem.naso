//! WASI Preview 2: Filesystem Interface
//!
//! Provides file system access with capability-based security.

extern "C" {
    // File descriptor operations
    fn wasi_fd_close(fd: u32) -> i32;
    fn wasi_fd_datasync(fd: u32) -> i32;
    fn wasi_fd_pread(fd: u32, buffers: *mut u64, nbuffers: u32, offset: u64) -> i32;
    fn wasi_fd_pwrite(fd: u32, buffers: *mut u64, nbuffers: u32, offset: u64) -> i32;
    fn wasi_fd_read(fd: u32, buffers: *mut u64, nbuffers: u32) -> i32;
    fn wasi_fd_write(fd: u32, buffers: *mut u64, nbuffers: u32) -> i32;
    fn wasi_fd_seek(fd: u32, offset: i64, whence: i32) -> i32;
    fn wasi_fd_tell(fd: u32) -> i32;
    fn wasi_fd_fdstat_get(fd: u32) -> i32;
    fn wasi_fd_fdstat_set_flags(fd: u32, flags: u32) -> i32;
    fn wasi_fd_fdstat_set_rights(fd: u32, rights_base: u64, rights_inheriting: u64) -> i32;
    fn wasi_fd_filestat_get(fd: u32) -> i32;
    fn wasi_fd_filestat_set_size(fd: u32, size: u64) -> i32;
    fn wasi_fd_filestat_set_times(fd: u32, atim: u64, mtim: u64, fst_flags: u32) -> i32;
    fn wasi_fd_advise(fd: u32, offset: u64, len: u64, advice: i32) -> i32;
    fn wasi_fd_allocate(fd: u32, offset: u64, len: u64) -> i32;
    fn wasi_fd_create_directory(fd: u32, path: *const u8, path_len: usize) -> i32;
    fn wasi_fd_read_directory(fd: u32, buf: *mut u8, buf_len: usize, cookie: u64) -> i32;
    fn wasi_fd_renumber(fd: u32, to: u32) -> i32;
    fn wasi_fd_sync(fd: u32) -> i32;
    
    // Path operations
    fn wasi_path_create_directory(fd: u32, path: *const u8, path_len: usize) -> i32;
    fn wasi_path_filestat_get(fd: u32, flags: u32, path: *const u8, path_len: usize) -> i32;
    fn wasi_path_filestat_set_times(fd: u32, flags: u32, path: *const u8, path_len: usize, atim: u64, mtim: u64, fst_flags: u32) -> i32;
    fn wasi_path_link(fd: u32, old_flags: u32, old_path: *const u8, old_path_len: usize, new_fd: u32, new_path: *const u8, new_path_len: usize) -> i32;
    fn wasi_path_open(fd: u32, dirflags: u32, path: *const u8, path_len: usize, oflags: u32, rights_base: u64, rights_inheriting: u64, fdflags: u32) -> i32;
    fn wasi_path_readlink(fd: u32, path: *const u8, path_len: usize, buf: *mut u8, buf_len: usize) -> i32;
    fn wasi_path_remove_directory(fd: u32, path: *const u8, path_len: usize) -> i32;
    fn wasi_path_rename(fd: u32, old_path: *const u8, old_path_len: usize, new_fd: u32, new_path: *const u8, new_path_len: usize) -> i32;
    fn wasi_path_symlink(fd: u32, old_path: *const u8, old_path_len: usize, new_path: *const u8, new_path_len: usize) -> i32;
    fn wasi_path_unlink_file(fd: u32, path: *const u8, path_len: usize) -> i32;
}

bitflags::bitflags! {
    pub struct PathFlags: u32 {
        const SYMLINK_FOLLOW = 1;
    }
    
    pub struct OpenFlags: u32 {
        const CREATE = 1;
        const DIRECTORY = 2;
        const EXCLUSIVE = 4;
        const TRUNCATE = 8;
        const READ = 16;
        const WRITE = 32;
        const APPEND = 64;
    }
    
    pub struct FdFlags: u32 {
        const APPEND = 1;
        const DSYNC = 2;
        const NONBLOCK = 4;
        const RSYNC = 8;
        const SYNC = 16;
    }
}

#[repr(C)]
pub struct FileType(u32);

impl FileType {
    pub const UNKNOWN: FileType = FileType(0);
    pub const BLOCK_DEVICE: FileType = FileType(1);
    pub const CHARACTER_DEVICE: FileType = FileType(2);
    pub const DIRECTORY: FileType = FileType(3);
    pub const REGULAR_FILE: FileType = FileType(4);
    pub const SOCKET_DGRAM: FileType = FileType(5);
    pub const SOCKET_STREAM: FileType = FileType(6);
    pub const SYMBOLIC_LINK: FileType = FileType(7);
}

#[repr(C)]
pub struct FileStats {
    pub device_id: u64,
    pub inode: u64,
    pub file_type: FileType,
    pub nlink: u64,
    pub size: u64,
    pub atim: u64,
    pub mtim: u64,
    pub ctim: u64,
}

#[repr(C)]
pub struct DirectoryEntry {
    pub inode: u64,
    pub name: String,
    pub file_type: FileType,
}

pub struct Descriptor {
    fd: u32,
}

impl Descriptor {
    pub fn from_fd(fd: u32) -> Self {
        Self { fd }
    }
    
    pub fn fd(&self) -> u32 {
        self.fd
    }
    
    pub fn close(&self) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_close(self.fd) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn datasync(&self) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_datasync(self.fd) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn read(&self, buf: &mut [u8]) -> Result<usize, std::io::Error> {
        let mut buffers = [buf.as_mut_ptr() as u64];
        let result = unsafe { wasi_fd_read(self.fd, buffers.as_mut_ptr(), 1) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as usize)
        }
    }
    
    pub fn write(&self, buf: &[u8]) -> Result<usize, std::io::Error> {
        let mut buffers = [buf.as_ptr() as u64];
        let result = unsafe { wasi_fd_write(self.fd, buffers.as_mut_ptr(), 1) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as usize)
        }
    }
    
    pub fn seek(&self, offset: i64, whence: std::io::SeekFrom) -> Result<u64, std::io::Error> {
        let whence_val = match whence {
            std::io::SeekFrom::Start(pos) => 0,
            std::io::SeekFrom::End(pos) => 1,
            std::io::SeekFrom::Current(pos) => 2,
        };
        let result = unsafe { wasi_fd_seek(self.fd, offset, whence_val) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as u64)
        }
    }
    
    pub fn tell(&self) -> Result<u64, std::io::Error> {
        let result = unsafe { wasi_fd_tell(self.fd) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as u64)
        }
    }
    
    pub fn filestat_get(&self) -> Result<FileStats, std::io::Error> {
        let result = unsafe { wasi_fd_filestat_get(self.fd) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            // Would parse the result into FileStats
            Ok(FileStats {
                device_id: 0,
                inode: 0,
                file_type: FileType::UNKNOWN,
                nlink: 0,
                size: 0,
                atim: 0,
                mtim: 0,
                ctim: 0,
            })
        }
    }
    
    pub fn filestat_set_size(&self, size: u64) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_filestat_set_size(self.fd, size) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn create_directory(&self, path: &str) -> Result<(), std::io::Error> {
        let path_str = crate::web::dom::DomString::new(path);
        let result = unsafe { wasi_fd_create_directory(self.fd, path_str.as_ptr(), path_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn read_directory(&self, buf: &mut [u8], cookie: u64) -> Result<usize, std::io::Error> {
        let result = unsafe { wasi_fd_read_directory(self.fd, buf.as_mut_ptr(), buf.len(), cookie) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as usize)
        }
    }
    
    pub fn sync(&self) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_sync(self.fd) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn advise(&self, offset: u64, len: u64, advice: i32) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_advise(self.fd, offset, len, advice) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn allocate(&self, offset: u64, len: u64) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_fd_allocate(self.fd, offset, len) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
}

/// Open a file at the given path relative to a directory descriptor
pub fn open_at(dir: &Descriptor, path: &str, oflags: OpenFlags, rights_base: u64, rights_inheriting: u64, fdflags: FdFlags) -> Result<Descriptor, std::io::Error> {
    let path_str = crate::web::dom::DomString::new(path);
    let mut new_fd: u32 = 0;
    let result = unsafe { 
        wasi_path_open(dir.fd, 0, path_str.as_ptr(), path_str.len(), oflags.bits(), rights_base, rights_inheriting, fdflags.bits())
    };
    if result < 0 {
        Err(std::io::Error::from_raw_os_error(-result))
    } else {
        // The new fd would be returned in the result
        Ok(Descriptor::from_fd(new_fd))
    }
}

/// Get file stats for a path
pub fn filestat_get(dir: &Descriptor, path: &str, flags: PathFlags) -> Result<FileStats, std::io::Error> {
    let path_str = crate::web::dom::DomString::new(path);
    let result = unsafe { wasi_path_filestat_get(dir.fd, flags.bits(), path_str.as_ptr(), path_str.len()) };
    if result < 0 {
        Err(std::io::Error::from_raw_os_error(-result))
    } else {
        // Would parse the result into FileStats
        Ok(FileStats {
            device_id: 0,
            inode: 0,
            file_type: FileType::UNKNOWN,
            nlink: 0,
            size: 0,
            atim: 0,
            mtim: 0,
            ctim: 0,
        })
    }
}