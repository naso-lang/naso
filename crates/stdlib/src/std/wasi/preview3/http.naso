//! WASI Preview 3: HTTP Interface
//!
//! Provides HTTP client and server functionality.

extern "C" {
    fn wasi_http_request_new() -> u64;
    fn wasi_http_request_set_method(request: u64, method: u32) -> i32;
    fn wasi_http_request_set_scheme(request: u64, scheme: u32) -> i32;
    fn wasi_http_request_set_authority(request: u64, authority: *const u8, len: usize) -> i32;
    fn wasi_http_request_set_path(request: u64, path: *const u8, len: usize) -> i32;
    fn wasi_http_request_headers(request: u64) -> u64;
    fn wasi_http_request_set_body(request: u64, body: u64) -> i32;
    
    fn wasi_http_response_new() -> u64;
    fn wasi_http_response_set_status(response: u64, status: u16) -> i32;
    fn wasi_http_response_headers(response: u64) -> u64;
    fn wasi_http_response_set_body(response: u64, body: u64) -> i32;
    
    fn wasi_http_fields_new() -> u64;
    fn wasi_http_fields_set(fields: u64, name: *const u8, name_len: usize, value: *const u8, value_len: usize) -> i32;
    fn wasi_http_fields_get(fields: u64, name: *const u8, name_len: usize) -> u64;
    fn wasi_http_fields_delete(fields: u64, name: *const u8, name_len: usize) -> i32;
    fn wasi_http_fields_append(fields: u64, name: *const u8, name_len: usize, value: *const u8, value_len: usize) -> i32;
    
    fn wasi_http_body_new() -> u64;
    fn wasi_http_body_write(body: u64, data: *const u8, len: usize) -> i32;
    fn wasi_http_body_read(body: u64, buf: *mut u8, len: usize) -> i32;
    fn wasi_http_body_consume(body: u64) -> i32;
    
    fn wasi_http_client_send(request: u64) -> u64;
    fn wasi_http_outgoing_request_send(request: u64) -> u64;
}

#[repr(u32)]
pub enum Method {
    Get = 0,
    Head = 1,
    Post = 2,
    Put = 3,
    Delete = 4,
    Connect = 5,
    Options = 6,
    Trace = 7,
    Patch = 8,
}

#[repr(u32)]
pub enum Scheme {
    Http = 0,
    Https = 1,
    Other = 2,
}

pub struct Fields {
    ptr: u64,
}

impl Fields {
    pub fn new() -> Self {
        Self { ptr: unsafe { wasi_http_fields_new() } }
    }
    
    pub fn set(&self, name: &str, value: &str) -> Result<(), std::io::Error> {
        let name_str = crate::web::dom::DomString::new(name);
        let value_str = crate::web::dom::DomString::new(value);
        let result = unsafe { wasi_http_fields_set(self.ptr, name_str.as_ptr(), name_str.len(), value_str.as_ptr(), value_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn get(&self, name: &str) -> Option<String> {
        let name_str = crate::web::dom::DomString::new(name);
        let ptr = unsafe { wasi_http_fields_get(self.ptr, name_str.as_ptr(), name_str.len()) };
        if ptr == 0 { None } else { Some(crate::web::dom::DomString::from_ptr(ptr).to_string()) }
    }
    
    pub fn delete(&self, name: &str) -> Result<(), std::io::Error> {
        let name_str = crate::web::dom::DomString::new(name);
        let result = unsafe { wasi_http_fields_delete(self.ptr, name_str.as_ptr(), name_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn append(&self, name: &str, value: &str) -> Result<(), std::io::Error> {
        let name_str = crate::web::dom::DomString::new(name);
        let value_str = crate::web::dom::DomString::new(value);
        let result = unsafe { wasi_http_fields_append(self.ptr, name_str.as_ptr(), name_str.len(), value_str.as_ptr(), value_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
}

pub struct Body {
    ptr: u64,
}

impl Body {
    pub fn new() -> Self {
        Self { ptr: unsafe { wasi_http_body_new() } }
    }
    
    pub fn write(&self, data: &[u8]) -> Result<usize, std::io::Error> {
        let result = unsafe { wasi_http_body_write(self.ptr, data.as_ptr(), data.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as usize)
        }
    }
    
    pub fn read(&self, buf: &mut [u8]) -> Result<usize, std::io::Error> {
        let result = unsafe { wasi_http_body_read(self.ptr, buf.as_mut_ptr(), buf.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(result as usize)
        }
    }
    
    pub fn consume(&self) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_body_consume(self.ptr) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
}

pub struct Request {
    ptr: u64,
}

impl Request {
    pub fn new() -> Self {
        Self { ptr: unsafe { wasi_http_request_new() } }
    }
    
    pub fn set_method(&self, method: Method) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_request_set_method(self.ptr, method as u32) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn set_scheme(&self, scheme: Scheme) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_request_set_scheme(self.ptr, scheme as u32) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn set_authority(&self, authority: &str) -> Result<(), std::io::Error> {
        let auth_str = crate::web::dom::DomString::new(authority);
        let result = unsafe { wasi_http_request_set_authority(self.ptr, auth_str.as_ptr(), auth_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn set_path(&self, path: &str) -> Result<(), std::io::Error> {
        let path_str = crate::web::dom::DomString::new(path);
        let result = unsafe { wasi_http_request_set_path(self.ptr, path_str.as_ptr(), path_str.len()) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn headers(&self) -> Fields {
        let ptr = unsafe { wasi_http_request_headers(self.ptr) };
        Fields { ptr }
    }
    
    pub fn set_body(&self, body: Body) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_request_set_body(self.ptr, body.ptr) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
}

pub struct Response {
    ptr: u64,
}

impl Response {
    pub fn new() -> Self {
        Self { ptr: unsafe { wasi_http_response_new() } }
    }
    
    pub fn set_status(&self, status: u16) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_response_set_status(self.ptr, status) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
    
    pub fn headers(&self) -> Fields {
        let ptr = unsafe { wasi_http_response_headers(self.ptr) };
        Fields { ptr }
    }
    
    pub fn set_body(&self, body: Body) -> Result<(), std::io::Error> {
        let result = unsafe { wasi_http_response_set_body(self.ptr, body.ptr) };
        if result < 0 {
            Err(std::io::Error::from_raw_os_error(-result))
        } else {
            Ok(())
        }
    }
}

pub struct HttpClient;

impl HttpClient {
    pub fn send(&self, request: Request) -> Result<Response, std::io::Error> {
        let response_ptr = unsafe { wasi_http_client_send(request.ptr) };
        if response_ptr == 0 {
            Err(std::io::Error::new(std::io::ErrorKind::Other, "Failed to send request"))
        } else {
            Ok(Response { ptr: response_ptr })
        }
    }
}

pub fn send_outgoing(request: Request) -> Result<Response, std::io::Error> {
    let response_ptr = unsafe { wasi_http_outgoing_request_send(request.ptr) };
    if response_ptr == 0 {
        Err(std::io::Error::new(std::io::ErrorKind::Other, "Failed to send outgoing request"))
    } else {
        Ok(Response { ptr: response_ptr })
    }
}