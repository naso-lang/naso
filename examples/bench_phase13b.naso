// Phase 13B: Optimized benchmark server for 30,000 req/s target
// Uses multi-threaded accept with synchronous I/O

extern "C" {
    // Multi-threaded accept FFI (Phase 13)
    fn naso_tcp_bind_multithreaded(addr: *u8, len: u64, num_listeners: u64) -> u64;
    fn naso_start_multithreaded_accept(listener_fds: *u64, listener_count: u64, num_workers: u64) -> u64;
    fn naso_stop_multithreaded_accept() -> u64;
    fn naso_get_next_connection() -> u64;
    
    // Synchronous I/O FFI (Legacy)
    fn naso_read(fd: u64, buf: *u8, max_len: u64) -> u64;
    fn naso_write(fd: u64, buf: *u8, len: u64) -> u64;
    
    // HTTP parser FFI (Phase 11 stdlib)
    fn naso_parse_http_request(buf: *u8, len: u64, method: *u8, method_len: u64, path: *u8, path_len: u64, headers: *u8, headers_len: u64) -> u64;
    fn naso_build_response_enhanced(method: *u8, method_len: u64, path: *u8, path_len: u64, headers: *u8, headers_len: u64, body: *u8, body_len: u64, out: *u8, out_len: u64, stream_fd: u64, enable_keep_alive: u8) -> u64;
    
    // Utility FFI
    fn naso_yield() -> u64;
    fn naso_close(fd: u64) -> u64;
}

// Connection processing with synchronous I/O and HTTP parsing
fn handle_client_sync(client_fd: u64) -> () {
    // Read HTTP request with synchronous I/O
    let mut request_buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let _ = naso_read(client_fd, request_buf as *u8, 16);
    
    // Parse HTTP request
    let mut method_buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut path_buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let mut headers_buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    
    let parse_result = naso_parse_http_request(
        request_buf as *u8, 16,
        method_buf as *u8, 16,
        path_buf as *u8, 16,
        headers_buf as *u8, 16
    );
    
    // Build HTTP response
    let mut response_buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let _ = naso_build_response_enhanced(
        method_buf as *u8, 16,
        path_buf as *u8, 16,
        headers_buf as *u8, 16,
        request_buf as *u8, 0,
        response_buf as *u8, 16,
        client_fd, 1
    );
    
    // Write response with synchronous I/O
    let _ = naso_write(client_fd, response_buf as *u8, 16);
    
    // Close connection
    let _ = naso_close(client_fd);
}

// Connection processing loop for multi-threaded accept
fn connection_worker() -> () {
    let mut running = 1;
    
    while running != 0 {
        let next_conn = naso_get_next_connection();
        if next_conn != 0 {
            handle_client_sync(next_conn);
        } else {
            naso_yield();
        }
    }
}

fn main() {
    let addr = [49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 56, 48, 57, 57];
    let listener_fd = naso_tcp_bind_multithreaded(addr as *u8, 14, 1);
    
    if listener_fd == 0 {
        return;
    }
    
    let listener_fds = [listener_fd, 0u64, 0u64, 0u64];
    let _ = naso_start_multithreaded_accept(listener_fds as *u64, 1, 1);
    
    // Run connection worker loop
    connection_worker();
    
    let _ = naso_stop_multithreaded_accept();
}