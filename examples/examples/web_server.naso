// Minimal web server — demonstrates QTT-managed async HTTP
use sys::net::{Listener, Stream, bind, accept};
use http::{Request, Response, ok, not_found};

fn main() {
    let listener = bind("0.0.0.0:8080").unwrap();
    loop {
        let (listener, stream) = accept(listener).unwrap();
        spawn(handle_connection(stream));
    }
}

async fn handle_connection(stream: [1] Stream) -> [0] () {
    let (req, stream) = await parse_request(stream)?;
    let resp = route(req).await;
    await send_response(stream, resp)?;
    Ok(())
}

async fn route(req: Request) -> Response {
    match req.path {
        b"/" => ok(b"Naso web server"),
        b"/health" => ok(b"OK"),
        _ => not_found()
    }
}