extern "C" {
    fn naso_write(fd: u64, buf: *u8, len: usize) -> usize;
    fn naso_read(fd: u64, buf: *u8, max_len: usize) -> usize;
    fn naso_tcp_bind(addr: *u8, len: usize) -> u64;
    fn naso_tcp_accept(fd: u64, out: *u64) -> u64;
    fn naso_accept_get_client(out: *u64) -> u64;
    fn naso_close(fd: u64) -> u64;
    // Async FFI
    fn naso_runtime_new(workers: usize) -> *u8;
    fn naso_spawn(rt: *u8, f: *u8) -> *u8;
    fn naso_yield() -> ();
    fn naso_future_new() -> *u8;
    fn naso_future_complete(fut: *u8, val: *u8, len: usize) -> u64;
    fn naso_future_get_result(fut: *u8, out: *u8, len: usize) -> u64;
    fn naso_tcp_accept_async(fd: u64, callback: *u8) -> u64;
}

async fn handle_client(client_fd: u64) -> () {
    let buf = [0u8; 1024];
    let response = "HTTP/1.1 200 OK\r\nContent-Length: 13\r\n\r\nHello World\n";
    
    // Async read
    let _ = naso_read(client_fd, buf as *u8, buf.len());
    
    // Async write
    let _ = naso_write(client_fd, response.as_ptr() as *u8, response.len());
    
    // Close
    let _ = naso_close(client_fd);
}

async fn accept_loop(fd: u64) -> () {
    let mut running = 1u64;
    while running != 0 {
        // Async accept - registers for epoll and yields
        let client_fd = naso_tcp_accept_async(fd, 0 as *u8);
        if client_fd != 0 {
            // Spawn handler task
            let _ = naso_spawn(0 as *u8, handle_client as *u8);
        }
        // Yield to allow other tasks to run
        naso_yield();
    }
}

fn main() -> () {
    let addr = [49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 56, 48, 57, 57]; // "127.0.0.1:8099"
    let fd = naso_tcp_bind(addr as *u8, 14);
    
    // Create async runtime
    let rt = naso_runtime_new(4);
    
    // Spawn accept loop
    let _ = naso_spawn(rt, accept_loop as *u8);
    
    // Run runtime (blocking)
    // In a real implementation, this would be naso_runtime_run(rt)
    loop {
        naso_yield();
    }
}