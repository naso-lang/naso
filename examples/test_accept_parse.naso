// Test accept and parse with annotation
fn test_accept_parse() -> () {
    let listener = bind("0.0.0.0:8080").unwrap();
    let stream = accept(listener);
    let _: [*] Stream = stream;
    let req = parse_request(stream).unwrap();
    let resp = route(req);
    let _ = send_response(stream, resp);
    ()
}

fn route(req: Request) -> Response {
    let body: [1] [Int] = [104, 101, 108, 108, 111];
    ok(body)
}