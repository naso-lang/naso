extern "C" {
    fn naso_write(fd: u64, buf: * u8, len: usize) -> usize;
    fn naso_read(fd: u64, buf: * u8, max_len: usize) -> usize;
    fn naso_tcp_bind(addr: * u8, len: usize) -> u64;
    fn naso_tcp_accept(fd: u64, out: * u64) -> u64;
    fn naso_accept_get_client(out: * u64) -> u64;
    fn naso_close(fd: u64) -> u64;
    // Async FFI
    async fn naso_runtime_new(workers: usize) -> * u8;
    async fn naso_spawn(rt: * u8, f: * u8) -> * u8;
    async fn naso_yield() -> ();
    async fn naso_future_new() -> * u8;
    async fn naso_future_complete(fut: * u8, val: * u8, len: usize) -> u64;
    async fn naso_future_get_result(fut: * u8, out: * u8, len: usize) -> u64;
    async fn naso_tcp_accept_async(fd: u64, callback: * u8) -> u64;
}

