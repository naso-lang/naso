// Test - GAT (Generic Associated Type) with square brackets
trait Iterator {
    type Item[T];
    
    fn next(&self) -> Option[u64];
}

struct MyIter {}

impl Iterator for MyIter {
    type Item[T] = T;
    
    fn next(&self) -> Option[u64] {
        None
    }
}

fn main() -> () {
    let iter = MyIter {};
    let _ = iter.next();
}