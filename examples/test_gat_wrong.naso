// Test - GAT with wrong type in impl
trait Iterator {
    type Item[T];
    
    fn next(&self) -> Option[u64];
}

struct MyIter {}

impl Iterator for MyIter {
    type Item[T] = u32;  // Wrong! Should be T
    
    fn next(&self) -> Option[u64] {
        None
    }
}

fn main() -> () {
    let iter = MyIter {};
    let _ = iter.next();
}