// Debug test: check if typed literals work in if branches
extern "C" {
    fn naso_write(fd: u64, buf: *u8, len: u64) -> u64;
}

fn test_if_typed() -> [u8; 4] {
    if true {
        [1u8, 2u8, 3u8, 4u8]
    } else {
        [4u8, 3u8, 2u8, 1u8]
    }
}

fn main() -> () {
    let _ = test_if_typed();
}