// Comprehensive test - All Phase 14 features together (working subset)

// 1. Large inline arrays with typed literals
fn create_buffer() -> [u8; 256] {
    [0u8; 256]
}

// 2. Const generics with arithmetic
fn get_array[N: nat](x: u64) -> [u64; N] {
    [x; N as u64]
}

// 3. Complex const expressions
fn complex_sizes() {
    let a = get_array[10 + 5](1u64);       // N = 15
    let b = get_array[20 - 8](2u64);       // N = 12
    let c = get_array[6 * 4](3u64);        // N = 24
    let d = get_array[100 / 5](4u64);      // N = 20
    let e = get_array[(10 + 2) * 3](5u64); // N = 36
}

// 4. Associated type projection (concrete type)
trait Iterator {
    type Item;
}

struct MyIter {}

impl Iterator for MyIter {
    type Item = u64;
}

fn use_iterator() -> u64 {
    let _: <MyIter as Iterator>::Item = 42u64;
    42u64
}

// 5. Trait bounds on generic parameters (concrete types)
trait Container {
    type Item;
}

struct MyContainer {}

impl Container for MyContainer {
    type Item = u64;
}

fn process_container() -> u64 {
    123u64
}

fn main() -> () {
    // Test large array
    let buffer = create_buffer();
    
    // Test const generic with arithmetic
    let arr1 = get_array[10](42u64);
    let arr2 = get_array[5 + 5](10u64);
    
    // Test trait
    let result = process_container();
    
    // Test complex const expressions
    complex_sizes();
    
    // Test associated type projection
    let iter_result = use_iterator();
}