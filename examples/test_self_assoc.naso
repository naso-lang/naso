// Test - Self::AssocType in trait
trait Iterator {
    type Item[T];
    
    fn next(&self) -> Option<Self::Item[u64]>;
}

struct MyIter {}

impl Iterator for MyIter {
    type Item[T] = T;
    
    fn next(&self) -> Option<u64> {
        None
    }
}

fn main() -> () {
    let iter = MyIter {};
    let _ = iter.next();
}