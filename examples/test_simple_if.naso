// Simple test: if/else with array literal and function return type
extern "C" {
    fn naso_write(fd: u64, buf: *u8, len: u64) -> u64;
}

fn test_if_return() -> [u8; 10] {
    if true {
        let arr: [u8; 10] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8];
        arr
    } else {
        let arr: [u8; 10] = [10u8, 9u8, 8u8, 7u8, 6u8, 5u8, 4u8, 3u8, 2u8, 1u8];
        arr
    }
}

fn main() -> () {
    let _ = test_if_return();
}