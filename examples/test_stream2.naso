// Test parse_request and send_response
fn test_stream() -> () {
    let stream = dummy_stream();
    let req = parse_request(stream).unwrap();
    let resp = route(req);
    let _ = send_response(stream, resp);
    ()
}

fn dummy_stream() -> [*] Stream {
    let _: [*] Stream = unreachable();
    unreachable()
}

fn route(req: Request) -> Response {
    let body: [1] [Int] = [104, 101, 108, 108, 111];
    ok(body)
}