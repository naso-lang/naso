// Test - trait method with explicit return type
trait Read {
    fn read(&self, buf: *u8, len: u64) -> u64;
}

struct File {
    fd: u64,
}

impl Read for File {
    fn read(&self, buf: *u8, len: u64) -> u64 {
        42u64
    }
}

fn test_read(file: File) -> u64 {
    file.read(0 as *u8, 10)
}

fn main() -> () {
    let f = File { fd: 1 };
    let r = test_read(f);
    let _ = r;
}