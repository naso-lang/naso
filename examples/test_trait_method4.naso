// Test - trait method with wrong return type in impl
trait Read {
    fn read(&self, buf: *u8, len: u64) -> u64;
}

struct File {
    fd: u64,
}

impl Read for File {
    fn read(&self, buf: *u8, len: u64) -> u64 {
        42u64
    }
}

fn test_read(file: File) -> u64 {
    let result = file.read(0 as *u8, 10);
    result
}

fn test_read2(file: File) -> u64 {
    // This should fail if trait method resolution is broken
    file.read(0 as *u8, 10)
}

fn main() -> () {
    let f = File { fd: 1 };
    let r1 = test_read(f);
    let _ = r1;
}