// Minimal web server — demonstrates QTT-managed async HTTP
// This tests the type signatures without needing actual stream values

fn main() -> () {
    let listener = bind("0.0.0.0:8080").unwrap();
    while true {
        let stream = accept(listener);
        handle_connection(stream);
        ()
    }
    ()
}

fn handle_connection(stream: [1] Stream) -> () {
    let result = parse_request(stream);
    let _: Result[(Request, [1] Stream)] = result;
    let (req, stream) = result.unwrap();
    let resp = route(req);
    let _ = send_response(stream, resp);
    ()
}

fn route(req: [1] Request) -> Response {
    let _ = req; // Acknowledge the request (in real code, would route based on req)
    let body = [104, 101, 108, 108, 111];
    ok(body)
}