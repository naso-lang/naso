/// Classically compute rotation angles for amplitude encoding.
/// Given a classical vector, compute the rotation angles needed to
/// prepare the corresponding quantum state.
fn compute_amplitude_encoding_angles(
    data: [1] Tensor[f32, N]
) -> [1] Tensor[f32, N]
where N: Nat
{
    // Normalize the input vector
    var norm_sq = 0.0;
    for i in 0..N {
        norm_sq += data[i] * data[i];
    }
    let norm = sqrt(norm_sq);
    
    var angles: Tensor[f32, N] = tensor_zeros();
    
    // Compute rotation angles for each amplitude
    // Using the recursive formula for state preparation
    var remaining_norm = 1.0;
    for i in 0..N {
        let amplitude = data[i] / norm;
        let angle = 2.0 * (amplitude / remaining_norm).asin();
        angles[i] = angle;
        remaining_norm *= cos(angle / 2.0);
    }
    
    angles
}

