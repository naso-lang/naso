// ============================================================
// Example: Full Hybrid Workflow
// ============================================================

/// Complete workflow: Classical data -> Quantum kernel -> Classical ML
fn hybrid_quantum_classical_workflow(
    training_data: [1] Tensor[f32, N_TRAIN, N_FEATURES],
    test_data: [1] Tensor[f32, N_TEST, N_FEATURES],
    training_labels: [1] Tensor[f32, N_TRAIN]
) -> [1] Tensor[f32, N_TEST]
where N_TRAIN: Nat, N_TEST: Nat, N_FEATURES: Nat
{
    // 1. CLASSICAL: Feature scaling and preprocessing
    let scaled_train = standardize_features(training_data);
    let scaled_test = standardize_features(test_data);
    
    // 2. QUANTUM: Compute quantum kernel matrices
    let K_train = quantum_kernel_matrix(scaled_train, angle_embedding_feature_map);
    let K_test = quantum_kernel_matrix_cross(scaled_test, scaled_train, angle_embedding_feature_map);
    
    // 3. CLASSICAL: Train SVM on quantum kernel
    let alpha = train_svm(K_train, training_labels);
    
    // 4. CLASSICAL: Predict on test set
    let predictions = predict_svm(K_test, alpha);
    
    predictions
}

/// Standardize features (zero mean, unit variance).
fn standardize_features(
    data: [1] Tensor[f32, N_SAMPLES, N_FEATURES]
) -> [1] Tensor[f32, N_SAMPLES, N_FEATURES]
where N_SAMPLES: Nat, N_FEATURES: Nat
{
    var result: Tensor[f32, N_SAMPLES, N_FEATURES] = tensor_zeros();
    
    for f in 0..N_FEATURES {
        // Compute mean
        var mean = 0.0;
        for s in 0..N_SAMPLES {
            mean += data[s, f];
        }
        mean /= N_SAMPLES as f32;
        
        // Compute std
        var var = 0.0;
        for s in 0..N_SAMPLES {
            var += (data[s, f] - mean).powi(2);
        }
        let std = sqrt(var / N_SAMPLES as f32);
        
        // Standardize
        for s in 0..N_SAMPLES {
            result[s, f] = (data[s, f] - mean) / (std + 1e-8);
        }
    }
    
    result
}

/// Angle embedding feature map.
fn angle_embedding_feature_map(
    x: [1] Tensor[f32, N_FEATURES],
    qubits: [1] [Qubit; N_QUBITS]
) -> [1] [Qubit; N_QUBITS]
where N_FEATURES: Nat, N_QUBITS: Nat
{
    // Embed each feature as a rotation angle
    for i in 0..min(N_FEATURES, N_QUBITS) {
        ry(x[i], qubits[i]);
    }
    
    // Add entangling layer
    for i in 0..(N_QUBITS - 1) {
        cnot(qubits[i], qubits[i + 1]);
    }
    
    qubits
}

/// Cross kernel matrix between test and train.
fn quantum_kernel_matrix_cross(
    test_data: [1] Tensor[f32, N_TEST, N_FEATURES],
    train_data: [1] Tensor[f32, N_TRAIN, N_FEATURES],
    feature_map: fn([1] Tensor[f32, N_FEATURES], [1] [Qubit; N_QUBITS]) -> [1] [Qubit; N_QUBITS]
) -> [1] Tensor[f32, N_TEST, N_TRAIN]
where N_TEST: Nat, N_TRAIN: Nat, N_FEATURES: Nat, N_QUBITS: Nat
{
    var K: Tensor[f32, N_TEST, N_TRAIN] = tensor_zeros();
    
    for i in 0..N_TEST {
        for j in 0..N_TRAIN {
            let [1] qi: [Qubit; N_QUBITS] = qalloc_array(N_QUBITS);
            feature_map(test_data[i], qi);
            
            let [1] qj: [Qubit; N_QUBITS] = qalloc_array(N_QUBITS);
            feature_map(train_data[j], qj);
            
            K[i, j] = swap_test(qi, qj);
            
            qfree_array(qi);
            qfree_array(qj);
        }
    }
    
    K
}

