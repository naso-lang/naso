// ============================================================
// Quantum Phase Estimation (QPE) with Classical Post-processing
// ============================================================

/// Quantum Phase Estimation for ground state energy.
/// Uses classical post-processing to extract eigenvalue from phase.
fn quantum_phase_estimation(
    unitary: fn([1] [Qubit; N_QUBITS]) -> [1] [Qubit; N_QUBITS],
    eigenstate_prep: fn([1] [Qubit; N_QUBITS]) -> [1] [Qubit; N_QUBITS],
    n_ancilla: usize
) -> f32
where N_QUBITS: Nat
{
    // Allocate ancilla register for phase estimation
    let [1] ancilla: [Qubit; n_ancilla] = qalloc_array(n_ancilla);
    let [1] system: [Qubit; N_QUBITS] = qalloc_array(N_QUBITS);
    
    // Prepare eigenstate
    eigenstate_prep(system);
    
    // Initialize ancilla in |+>^n
    for i in 0..n_ancilla {
        hadamard(ancilla[i]);
    }
    
    // Controlled unitary applications
    for i in 0..n_ancilla {
        // Apply U^(2^i) controlled by ancilla[i]
        for _ in 0..(1 << i) {
            controlled_unitary(ancilla[i], system, unitary);
        }
    }
    
    // Inverse QFT on ancilla
    inverse_qft(ancilla);
    
    // Measure ancilla
    var phase_bits: [bool; n_ancilla];
    for i in 0..n_ancilla {
        phase_bits[i] = measure(ancilla[i]);
    }
    
    // Classical post-processing: convert bits to phase
    var phase = 0.0;
    for i in 0..n_ancilla {
        if phase_bits[i] {
            phase += 1.0 / (1 << (i + 1)) as f32;
        }
    }
    
    // Eigenvalue = e^{2πi * phase}
    // Energy = -log(eigenvalue) / (2π) for unitary = e^{-iHt}
    let energy = -log(cos(2.0 * pi * phase) + sin(2.0 * pi * phase)) / (2.0 * pi);
    
    qfree_array(ancilla);
    qfree_array(system);
    
    energy
}

