// INT8 Symmetric Quantization Kernel
//
// STATUS: both kernels typecheck. `as T` is implemented as a numeric cast
// (lexer token, postfix parse rule, and a checked inference rule that
// rejects non-numeric operands and targets).
//
// Quantities (QTT):
//   input   [1]     linear, consumed exactly once
//   output  inout   linear, written in place; needs an explicit quantity
//   scale   f32     linear. It was originally [0], which is right in spirit
//                   (read-only across the loop) but wrong in practice: a [0]
//                   variable is erased, and the typechecker correctly rejects
//                   it in a runtime position. Read-only-across-the-loop is not
//                   yet expressible.
//   N is a literal (1024) because the parser requires a literal in
//   Tensor[T, N] position; a symbolic extent is not expressible yet.
//
// Still not implemented:
//   1. No `proof` block. `proof` is not a keyword anywhere in the lexer, so
//      `proof { .. }` fails with "expected '}', found '{'". The verification
//      condition below is a comment and is NOT checked by the prover. Until it
//      is, this kernel is typechecked but not verified.
//   2. Symbolic extents (see N above).
//
// The cast can overflow unless the precondition holds, which is exactly what
// the missing proof block would establish. Typechecking is not verification:
// this file compiles, and the i8 narrowing is still unproven.

/// Quantize f32 -> i8 with a symmetric scale.
///
/// The cast can overflow unless the precondition holds, which is what the
/// proof below would establish:
///
///   forall i in 0..1024 { abs(input[i]) <= 127.0 * scale }
///
/// so the clamp is load-bearing, not defensive decoration.
fn quantize_int8_symmetric(
    input: [1] Tensor[f32, 1024],
    output: inout [1] Tensor[i8, 1024],
    scale: f32
) {
    // proof {
    //     assert(forall (i in 0..1024) { abs(input[i]) <= 127.0 * scale });
    // }

    forall i in 0..1024 {
        let v = round(input[i] / scale);
        output[i] = clamp(v, -128.0, 127.0) as i8;
    }
}

/// Dequantize i8 -> f32, widening each element and rescaling.
fn dequantize_int8_symmetric(
    input: [1] Tensor[i8, 1024],
    output: inout [1] Tensor[f32, 1024],
    scale: f32
) {
    forall i in 0..1024 {
        let v = input[i] as f32;
        output[i] = v * scale;
    }
}

/// f32 -> f32 using the same prelude intrinsics a quantizer needs, with no
/// cast involved. Useful as a smoke test that forall loops, tensor indexing
/// and the math builtins all typecheck.
fn normalize_f32(
    input: [1] Tensor[f32, 1024],
    output: inout [1] Tensor[f32, 1024],
    scale: f32
) {
    forall i in 0..1024 {
        output[i] = round(input[i] / scale);
    }
}
