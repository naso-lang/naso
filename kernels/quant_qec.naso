// ============================================================
// Test: QEC Type Safety
// ============================================================

/// This function demonstrates that QEC types prevent common errors:
/// - Wrong number of physical qubits for a code
/// - Mismatched syndrome array sizes
/// - Applying recovery to wrong code type

fn qec_type_safety_demo() {
    // This would be a compile-time error if uncommented:
    // let [1] wrong: [Qubit; 8] = shor_code_encode(qalloc());
    // Error: Shor code requires 9 physical qubits, not 8
    
    // Correct usage:
    let [1] logical: Qubit = qalloc();
    let [1] encoded: [Qubit; 9] = shor_code_encode(logical);
    
    // Syndrome array size is enforced by type
    let syndromes: [Syndrome; 8] = shor_code_syndrome(encoded);
    
    // Recovery takes the correct syndrome type
    shor_code_recover(encoded, syndromes);
    
    // Cleanup
    qfree_array(encoded);
}