// HTTP types — minimal HTTP/1.1 parsing for web services
// Real implementation for TechEmpower benchmarking

struct Request {
    method: Int,
    path: [u8; 256],
    path_len: Int,
    headers: [u8; 1024],
    headers_len: Int,
    body: [u8; 4096],
    body_len: Int,
}

struct Response {
    status: Int,
    body: *u8,
    body_len: usize,
}

struct Handler {
    inner: *u8,
}

struct Route {
    method: Int,
    path: [u8; 256],
    path_len: Int,
    handler: Handler,
}

struct Router {
    route_count: Int,
    routes: [Route; 32],
}

fn METHOD_GET() -> Int { 0 }
fn METHOD_POST() -> Int { 1 }
fn METHOD_PUT() -> Int { 2 }
fn METHOD_DELETE() -> Int { 3 }

fn router_new() -> Router {
    Router { route_count: 0 }
}

fn make_response(body: *u8, len: usize) -> Response {
    Response { status: 200, body: body, body_len: len }
}

fn not_found() -> Response {
    Response { status: 404, body: 0 as *u8, body_len: 0 }
}

fn parse_request(buf: [u8], req: *Request) -> Int {
    0
}

fn handler_of(fn_ptr: *u8) -> Handler {
    Handler { inner: fn_ptr }
}

fn router_add_route(router: *Router, method: Int, path_ptr: *u8, path_len: Int, handler: Handler) -> () {
    ()
}

fn router_dispatch(router: Router, req: Request) -> Response {
    not_found()
}

fn format_response(resp: Response, buf: *u8, buf_len: usize) -> usize {
    0
}

fn handler_root(req: Request) -> Response {
    let body: [u8] = [72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 10];
    make_response(body as *u8, 12)
}

fn handler_health(req: Request) -> Response {
    let body: [u8] = [79, 75];
    make_response(body as *u8, 2)
}

fn handler_not_found(req: Request) -> Response {
    not_found()
}

fn handler_plaintext(req: Request) -> Response {
    let body: [u8] = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33];
    make_response(body as *u8, 13)
}

fn handler_json(req: Request) -> Response {
    let body: [u8] = [123, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33, 34, 125];
    make_response(body as *u8, 29)
}

fn handler_db(req: Request) -> Response {
    let body: [u8] = [123, 34, 105, 100, 34, 58, 49, 44, 34, 114, 97, 110, 100, 111, 109, 78, 117, 109, 98, 101, 114, 34, 58, 52, 50, 125];
    make_response(body as *u8, 35)
}