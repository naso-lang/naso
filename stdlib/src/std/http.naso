// HTTP types — minimal HTTP/1.1 parsing for web services
// Simplified to compile with current Naso syntax

struct Request {
    method: Int,
    path_offset: Int,
    path_len: Int,
    headers_offset: Int,
    headers_len: Int,
    body_offset: Int,
    body_len: Int,
}

struct Response {
    status: Int,
    body: *u8,
    body_len: usize,
}

fn METHOD_GET() -> Int { 0 }
fn METHOD_POST() -> Int { 1 }

fn make_response(body: *u8, len: usize) -> Response {
    Response { status: 200, body: body, body_len: len }
}

fn not_found() -> Response {
    Response { status: 404, body: 0 as *u8, body_len: 0 }
}

fn split_http(buf: [u16]) -> Int {
    let len = buf.len();
    let mut i = 0;
    let mut body_start = -1;
    while i + 3 < len {
        if buf[i] == 13 && buf[i+1] == 10 && buf[i+2] == 13 && buf[i+3] == 10 {
            body_start = i + 4;
            break;
        }
        i = i + 1;
    }
    if body_start == -1 { return -1; }
    
    let mut method_end = 0;
    while method_end < len && buf[method_end] != 32 { method_end = method_end + 1; }
    let mut path_start = method_end + 1;
    let mut path_end = path_start;
    while path_end < len && buf[path_end] != 32 { path_end = path_end + 1; }
    
    let method_len = method_end;
    let path_len = path_end - path_start;
    
    0
}

fn format_http(resp: Response) -> [u8] {
    let mut out: [u8] = [0];
    out
}

fn handler_root(req: Request) -> Response {
    let body: [u8] = [72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 10];
    make_response(body as *u8, 12)
}

fn handler_health(req: Request) -> Response {
    let body: [u8] = [79, 75];
    make_response(body as *u8, 2)
}

fn handler_not_found(req: Request) -> Response {
    not_found()
}

fn logging_middleware(req: Request) -> Request {
    req
}