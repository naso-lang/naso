struct Request {
    method: Int,
    path: [u8; 256],
    path_len: Int,
    headers: [u8; 1024],
    headers_len: Int,
    body: [u8; 4096],
    body_len: Int,
}

struct Response {
    status: Int,
    body: *u8,
    body_len: usize,
}

struct Middleware {
    inner: *u8,
}

struct Handler {
    inner: *u8,
}

fn middleware_of(fn_ptr: *u8) -> Middleware {
    Middleware { inner: fn_ptr }
}

struct Route {
    method: Int,
    path: [u8; 256],
    path_len: Int,
    handler: Handler,
}

struct Router {
    route_count: Int,
    routes: [Route; 32],
}

fn METHOD_GET() -> Int { 0 }
fn METHOD_POST() -> Int { 1 }
fn METHOD_PUT() -> Int { 2 }
fn METHOD_DELETE() -> Int { 3 }

fn make_response(body: *u8, len: usize) -> Response {
    Response { status: 200, body: body, body_len: len }
}

fn not_found() -> Response {
    Response { status: 404, body: 0 as *u8, body_len: 0 }
}

fn parse_request(buf: *u8, len: usize, req: *Request) -> Int {
    0
}

fn handler_of(fn_ptr: *u8) -> Handler {
    Handler { inner: fn_ptr }
}

fn router_add_route(router: *Router, method: Int, path_ptr: *u8, path_len: Int, handler: Handler) -> () {
    if router.route_count < 32 {
        let route: Route = {
            method: method,
            path: [0; 256],
            path_len: path_len,
            handler: handler
        };
        // Copy path bytes
        for i in 0..path_len {
            route.path[i] = path_ptr[i];
        }
        router.routes[router.route_count] = route;
        router.route_count += 1;
    }
}

struct RouterBuilder {
    router: Router,
    middlewares: [Middleware; 8],
    middleware_count: Int,
}

fn router_builder_new() -> RouterBuilder {
    let routes: [Route; 32] = {0};
    let router = Router { route_count: 0, routes: routes };
    let middlewares: [Middleware; 8] = {0};
    RouterBuilder { router: router, middlewares: middlewares, middleware_count: 0 }
}

fn router_builder_add_middleware(builder: *RouterBuilder, middleware: Middleware) -> () {
    if builder.middleware_count < 8 {
        builder.middlewares[builder.middleware_count] = middleware;
        builder.middleware_count += 1;
    }
}

fn router_builder_add_route(builder: *RouterBuilder, method: Int, path_ptr: *u8, path_len: Int, handler: Handler) -> () {
    if builder.router.route_count < 32 {
        let route: Route = {
            method: method,
            path: [0; 256],
            path_len: path_len,
            handler: handler
        };
        // Copy path bytes
        for i in 0..path_len {
            route.path[i] = path_ptr[i];
        }
        builder.router.routes[builder.router.route_count] = route;
        builder.router.route_count += 1;
    }
}

fn router_builder_dispatch(builder: RouterBuilder, req: Request) -> Response {
    let mut resp = not_found();
    
    // Apply middlewares in order - middleware can modify request or response
    let mut current_req = req;
    for i in 0..builder.middleware_count {
        let middleware = builder.middlewares[i];
        if !middleware.inner.is_null() {
            // Call middleware function: fn(Request) -> Response
            let middleware_fn = middleware.inner;
            let result = call_middleware(middleware_fn, current_req);
            current_req = result.request; // middleware may modify request
            resp = result.response; // middleware may return modified response
            // If middleware returns a response, we skip route lookup and return it
            if resp.status != 404 {
                return resp;
            }
        }
    }
    
    // Route lookup
    for i in 0..builder.router.route_count {
        let route = builder.router.routes[i];
        if route.method == current_req.method {
            let path_match = 1;
            for j in 0..route.path_len {
                if route.path[j] != current_req.path[j] {
                    path_match = 0;
                    break;
                }
            }
            if path_match != 0 {
                // Extract route parameters for path matching
                let params = extract_route_params(route.path, route.path_len, current_req.path, current_req.path_len);
                let handler_fn = route.handler.inner;
                if !handler_fn.is_null() {
                    let result = call_handler(handler_fn, current_req, params);
                    return result.response;
                }
            }
        }
    }
    
    not_found()
}

// Helper function to call middleware with request/response transformation
struct MiddlewareResult {
    request: Request,
    response: Response,
}

fn call_middleware(middleware_ptr: *u8, req: Request) -> MiddlewareResult {
    // This would call the actual middleware function in production
    // For now, return unchanged request and not_found response
    MiddlewareResult {
        request: req,
        response: not_found(),
    }
}

// Helper function to extract route parameters
struct RouteParams {
    params: [u8; 256],
    param_count: Int,
}

fn extract_route_params(route_pattern: [u8; 256], route_pattern_len: Int, request_path: [u8; 256], request_path_len: Int) -> RouteParams {
    let mut params: [u8; 256] = [0; 256];
    let mut param_count = 0;
    
    // Simple parameter extraction for route patterns like /users/:id
    // This is a basic implementation - can be enhanced for complex patterns
    for i in 0..route_pattern_len {
        if route_pattern[i] == b':' {
            // Found parameter placeholder
            let param_start = i + 1;
            let mut param_end = param_start;
            while param_end < route_pattern_len && route_pattern[param_end] != b'/' {
                param_end += 1;
            }
            
            // Copy parameter name to params
            for j in param_start..param_end {
                if param_count < 10 { // Limit to 10 params
                    params[param_count] = route_pattern[j];
                    param_count += 1;
                }
            }
        }
    }
    
    RouteParams {
        params: params,
        param_count: param_count,
    }
}

// Enhanced route lookup with parameter support
fn find_matching_route(router: *Router, req_method: Int, request_path: [u8; 256], request_path_len: Int) -> (*u8, RouteParams) {
    for i in 0..router.route_count {
        let route = router.routes[i];
        if route.method == req_method {
            // Support both exact matching and parameterized routes
            if route_matches(request_path, request_path_len, route.path, route.path_len) {
                let params = extract_route_params(route.path, route.path_len, request_path, request_path_len);
                return (route.handler.inner, params);
            }
        }
    }
    (0 as *u8, RouteParams { params: [0; 256], param_count: 0 })
}

fn route_matches(request_path: [u8; 256], request_path_len: Int, route_pattern: [u8; 256], route_pattern_len: Int) -> u8 {
    if request_path_len != route_pattern_len {
        return 0;
    }
    
    for i in 0..request_path_len {
        if route_pattern[i] == b':' {
            // Parameter placeholder matches any character
            continue;
        }
        if route_pattern[i] != request_path[i] {
            return 0;
        }
    }
    return 1;
}

fn logging_middleware(req: Request, resp: Response) -> Response {
    resp
}

fn cors_middleware(req: Request, resp: Response) -> Response {
    resp
}

fn format_response(resp: Response, buf: *u8, buf_len: usize) -> usize {
    if resp.body == 0 as *u8 || resp.body_len == 0 {
        return 0;
    }
    
    let mut bytes_written = 0;
    
    // Write status line
    let status_line = "HTTP/1.1 200 OK\r\n";
    for i in 0..(status_line.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = status_line[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    // Write headers
    let headers = "Content-Type: text/plain\r\n";
    for i in 0..(headers.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = headers[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    // Write Content-Length
    let cl_str = "Content-Length: ";
    for i in 0..(cl_str.len() - 1) {
        if bytes_written < buf_len {
            buf[bytes_written] = cl_str[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    // Write response body
    for i in 0..resp.body_len {
        if bytes_written < buf_len {
            buf[bytes_written] = resp.body[i];
            bytes_written += 1;
        } else {
            break;
        }
    }
    
    bytes_written
}
}

fn handler_plaintext(req: Request) -> Response {
    let body: [u8] = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33];
    make_response(body as *u8, 13)
}

