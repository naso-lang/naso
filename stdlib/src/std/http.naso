// HTTP types — no fake Map/String wrappers
// Uses Int for bytes (simplified for now)

struct Request {
    method: Int,
    path: Int,
    body: Int,
}

struct Response {
    status: Int,
    body: Int,
}

fn ok(body: Int) -> Response {
    let s = 200;
    Response { status: s, body }
}

fn not_found() -> Response {
    ()
}