fn handle_client(client_fd: u64) -> () {
    let mut buf = [0; 2048];
    let n = naso_read(client_fd, buf as *u8, buf.len());
    
    if n > 0 {
        let mut req_buf = [0; 4096];
        let mut req = Request {
            method: 0,
            path: [0; 256],
            path_len: 0,
            headers: [0; 1024],
            headers_len: 0,
            body: [0; 4096],
            body_len: 0,
        };
        
        let _ = parse_request(req_buf as *u8, req_buf.len(), &mut req);
        
        // Use the enhanced RouterBuilder with middleware support
        let mut builder = router_builder_new();
        
        // Add middleware for logging
        let logging_middleware_ptr = logging_middleware as *u8;
        router_builder_add_middleware(&mut builder, middleware_of(logging_middleware_ptr));
        
        // Add middleware for CORS
        let cors_middleware_ptr = cors_middleware as *u8;
        router_builder_add_middleware(&mut builder, middleware_of(cors_middleware_ptr));
        
        // Configure routes with path parameter support
        let plaintext_path: [u8; 10] = [47, 112, 108, 97, 105, 110, 116, 101, 120, 116];
        router_builder_add_route(&mut builder, 0, plaintext_path as *u8, 10, handler_of(handler_plaintext as *u8));
        
        let json_path: [u8; 5] = [47, 106, 115, 111, 110];
        router_builder_add_route(&mut builder, 0, json_path as *u8, 5, handler_of(handler_json as *u8));
        
        let db_path: [u8; 3] = [47, 100, 98];
        router_builder_add_route(&mut builder, 0, db_path as *u8, 3, handler_of(handler_db as *u8));
        
        let root_path: [u8; 1] = [47];
        router_builder_add_route(&mut builder, 0, root_path as *u8, 1, handler_of(handler_root as *u8));
        
        let health_path: [u8; 7] = [47, 104, 101, 97, 108, 116, 104];
        router_builder_add_route(&mut builder, 0, health_path as *u8, 7, handler_of(handler_health as *u8));
        
        // Use the enhanced router_builder_dispatch which supports middleware and route parameters
        let resp = router_builder_dispatch(builder, req);
        
        let mut out_buf = [0; 512];
        let out_len = format_response(resp, out_buf as *u8, out_buf.len());
        naso_write(client_fd, out_buf as *u8, out_len);
    }
    
    naso_close(client_fd);
}

fn accept_loop(fd: u64) -> () {
    let mut running = 1;
    let mut out = [0];
    let out_ptr = out as *u64;
    
    while running != 0 {
        if naso_tcp_accept(fd, out_ptr) != 0 {
            let client_fd = naso_accept_get_client(out_ptr);
            handle_client(client_fd);
        }
        naso_yield();
    }
}

fn main() -> () {
    let addr = [49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 56, 48, 57, 57];
    let fd = naso_tcp_bind(addr as *u8, 14);
    
    let runtime = naso_runtime_new(4);
    
    accept_loop(fd);
    let _ = naso_runtime_run(runtime);
}