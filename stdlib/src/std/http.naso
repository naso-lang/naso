// HTTP types — no fake Map/String wrappers
use core::Bytes;

pub struct Request {
    method: Bytes,
    path: Bytes,
    body: [N] u16,
}

pub struct Response {
    status: u16,
    body: [N] u16,
}

pub fn ok(body: [N] u16) -> Response {
    Response { status: 200, body }
}

pub fn not_found() -> Response {
    let msg: [13] u8 = b"Not Found";
    Response { status: 404, body: msg }
}

pub fn parse_request(stream: [1] net::Stream) -> Result<Request> {
    let buf = net::read(stream, 8192)?;
    let (method, path, body) = split_http(buf)?;
    Ok(Request { method, path, body })
}

pub fn send_response(stream: [1] net::Stream, resp: Response) -> Result<()> {
    let bytes = format_http(resp);
    net::write(stream, bytes)?;
    Ok(())
}

fn split_http(buf: [N] u16) -> Result<(Bytes, Bytes, [N] u16)> { todo!() }
fn format_http(resp: Response) -> [N] u8 { todo!() }