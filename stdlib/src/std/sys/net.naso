// TCP sockets via FFI to Rust standard library
// [1] Quantity ensures single ownership — no fd leaks

extern "C" {
    fn naso_tcp_bind(addr_ptr: *u8, len: usize) -> u64;
    fn naso_tcp_accept(fd: u64, out: *u64) -> u64;
    fn naso_read(fd: u64, buf: *u8, max_len: usize) -> usize;
    fn naso_write(fd: u64, buf: *u8, len: usize) -> usize;
}

/// Wraps a raw fd with QTT single-ownership tracking
struct Listener {
    fd: Int,
}

/// Wraps a stream fd — must be consumed at read/write
struct Stream {
    fd: Int,
}

/// Bind to "addr:port" — returns Err if bind fails (fd == 0)
fn bind(addr: String) -> Result[Listener] {
    let len = addr.len();
    let ptr = addr as *u8;
    let fd = naso_tcp_bind(ptr, len);
    if fd == 0 { err("bind failed") } else { ok(Listener { fd: fd as Int }) }
}

/// Accept one connection — consumes listener, returns new listener + stream
fn accept(l: Listener) -> Result[(Listener, Stream)] {
    let mut out = [0u64, 0u64];
    let res = naso_tcp_accept(l.fd as u64, &mut out as *mut u64);
    if res == 0 { err("accept failed") } else { ok((Listener { fd: out[0] as Int }, Stream { fd: out[1] as Int })) }
}

/// Read from stream into buffer — consumes stream per QTT
fn read(s: Stream, buf: [N] u8) -> Result[Int] {
    let len = buf.len();
    let ptr = buf as *u8;
    let n = naso_read(s.fd as u64, ptr, len);
    ok(n as Int)
}

/// Write buffer to stream — consumes stream per QTT
fn write(s: Stream, buf: [N] u8) -> Result[Int] {
    let len = buf.len();
    let ptr = buf as *u8;
    let n = naso_write(s.fd as u64, ptr, len);
    ok(n as Int)
}