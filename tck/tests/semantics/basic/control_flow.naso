// TEST: control_flow
// CATEGORY: semantics/basic
// EXPECT: runtime_success
// EDITION: 2024
// DESCRIPTION: If, match, loops

edition 2024;

fn main() {
    // If
    let x = if true { 1 } else { 2 };
    
    // Match
    let y = match x {
        1 => "one",
        2 => "two",
        _ => "other",
    };
    
    // Loop
    let mut sum = 0;
    for i in 1..=10 {
        sum += i;
    }
}
