// TEST: vec
// CATEGORY: stdlib/core
// EXPECT: runtime_success
// EDITION: 2024
// DESCRIPTION: Vector operations

edition 2024;

fn main() {
    let mut v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    assert_eq!(v.len(), 3);
    assert_eq!(v[0], 1);
    v.pop();
    assert_eq!(v.len(), 2);
}
