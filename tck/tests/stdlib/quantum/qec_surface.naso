// TEST: qec_surface
// CATEGORY: stdlib/quantum
// EXPECT: compile_success
// EDITION: 2024
// DESCRIPTION: Surface code

edition 2024;

use std::quantum::qec::{SurfaceCode, QECConfig, Decoder};

fn main() {
    let code = SurfaceCode::new(3);  // Distance 3
    let config = QECConfig {
        decoder: Decoder::MWPM,
        ..Default::default()
    };
    let logical = code.encode(&[0]);
}
