struct Request {
    method: Int,
    path: [256] u8,
    path_len: Int,
    headers: [1024] u8,
    headers_len: Int,
    body: [4096] u8,
    body_len: Int,
}

struct Response {
    status: Int,
    body: *u8,
    body_len: usize,
}

struct Handler {
    inner: *u8,
}

struct Middleware {
    inner: *u8,
}

struct Route {
    method: Int,
    path: [256] u8,
    path_len: Int,
    handler: Handler,
}

struct Router {
    routes: [32] Route,
    route_count: Int,
    middleware: [16] Middleware,
    middleware_count: Int,
}

fn router_new() -> Router {
    let empty_route = Route {
        method: 0,
        path: [0u8; 256],
        path_len: 0,
        handler: Handler { inner: 0 as *u8 },
    };
    let empty_middleware = Middleware { inner: 0 as *u8 };
    
    let r = Router {
        routes: [empty_route; 32],
        route_count: 0,
        middleware: [empty_middleware; 16],
        middleware_count: 0,
    };
    r
}

fn main() -> () {
    let mut router = router_new();
}