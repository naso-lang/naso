struct Router {
    routes: [32] Route,
    route_count: Int,
    middleware: [16] Middleware,
    middleware_count: Int,
}

struct Route {
    method: Int,
    path: [256] u8,
    path_len: Int,
    handler: Handler,
}

struct Handler {
    inner: *u8,
}

struct Middleware {
    inner: *u8,
}

fn main() -> () {
    let r = Router {
        route_count: 0,
        middleware_count: 0,
    };
}