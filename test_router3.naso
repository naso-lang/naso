struct Handler {
    inner: *u8,
}

struct Route {
    method: Int,
    path: Int,
    path_len: Int,
    handler: Handler,
}

struct Router {
    routes: [32] Route,
    route_count: Int,
}

fn handler_fn() -> Int {
    42
}

fn router_new() -> Router {
    Router { route_count: 0 }
}

fn router_add_route(router: *Router, method: Int, path: Int, path_len: Int, handler: Handler) -> () {
    let idx = (*router).route_count;
    if idx < 32 {
        (*router).routes[idx].method = method;
        (*router).routes[idx].path = path;
        (*router).routes[idx].path_len = path_len;
        (*router).routes[idx].handler = handler;
        (*router).route_count = idx + 1;
    }
}

fn test_router_dispatch() -> Int {
    let router = router_new();
    let h = Handler { inner: handler_fn as *u8 };
    router_add_route(&router as *Router, 0, 47, 1, h);
    
    let found = (*router).routes[0].handler.inner as fn() -> Int;
    found()
}